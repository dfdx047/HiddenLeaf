+	bool OwnsOutput()
+	{
+		const State& s = s_state;
+		return s.presenter && s.surface != VK_NULL_HANDLE && s.presenter->owns_final_output();
+	}
+
+	bool MainSurfaceHandoffPending()
+	{
+		const State& s = s_state;
+		return s.presenter && s.surface != VK_NULL_HANDLE && s.presenter->main_surface_handoff_pending();
+	}
+
+	void MainSurfaceReleasedByA()
+	{
+		State& s = s_state;
+		if (s.presenter)
+		{
+			s.presenter->MainSurfaceReleasedByA();
+			s.released_by_a = true;
+			s.status = "ZeroFG: presenting";
+			INFO_LOG("ZeroFG: the GS device released the window; device B presents.");
+		}
+	}
+
+	bool ReconnectRequested()
+	{
+		// Two ways back to the GS device: the surface went out of date under device B, or the
+		// presenter failed and handed the window back (it no longer owns the output, and the GS
+		// device has no swap chain since it released the window).
+		const State& s = s_state;
+		return s.presenter && s.surface != VK_NULL_HANDLE &&
+			   (s.presenter->main_surface_reconnect_requested() ||
+				   (s.released_by_a && !s.presenter->owns_final_output()));
+	}
+
+	void FailOpen()
+	{
+		std::unique_lock lock(s_mutex);
+		State& s = s_state;
+		DisconnectSurfaceLocked();
+		// The presenter that handed the window back refuses it from now on: a new one takes the next
+		// connection, until the device has failed open too often.
+		s.presenter.reset();
+		std::string why;
+		if (++s.fail_opens > MAX_FAIL_OPENS || !CreatePresenterLocked(&why))
+		{
+			s.failed_open = true;
+			s.status = "ZeroFG: failed open, the GS presents alone";
+			WARNING_LOG("ZeroFG: the presenter gave the window back (fail-open {}, limit {}{}); the GS device presents "
+						"for the rest of this session.",
+				s.fail_opens, MAX_FAIL_OPENS, why.empty() ? std::string() : fmt::format(", {}", why));
+			return;
+		}
+		s.status = "ZeroFG: failed open, rearmed";
+		WARNING_LOG("ZeroFG: the presenter gave the window back (fail-open {}, limit {}); a new one takes the next "
+					"connection.",
+			s.fail_opens, MAX_FAIL_OPENS);
+	}
+
+	bool WantsFrames()
+	{
+		const State& s = s_state;
+		return s.presenter && s.surface != VK_NULL_HANDLE && s.handoff && !s.handoff->failed() &&
+			   s.presenter->accepting();
+	}
+
+	std::string GetOverlayText()
+	{
+		// The rates over half-second windows, so the line holds still between updates.
+		static u64 last_ns = 0;
+		static u64 last_real = 0;
+		static u64 last_synthetic = 0;
+		static float real_fps = 0.0f;
+		static float synthetic_fps = 0.0f;
+		const State& s = s_state;
+		if (!GSConfig.ZeroFGEnabled || !s.presenter)
+			return {};
+		if (s.failed_open)
+			return "ZeroFG: off (it failed; see the log)";
+		if (!OwnsOutput())
+		{
+			last_ns = 0;
+			return s.surface != VK_NULL_HANDLE ? "ZeroFG: starting" : std::string();
+		}
+		const u64 now = NowNs();
+		const u64 real = s_outputs_real.load(std::memory_order_relaxed);
+		const u64 synthetic = s_outputs_synthetic.load(std::memory_order_relaxed);
+		if (!last_ns)
+		{
+			last_ns = now;
+			last_real = real;
+			last_synthetic = synthetic;
+			real_fps = synthetic_fps = 0.0f;
+		}
+		else if (now - last_ns >= 500000000ull)
+		{
+			const float seconds = static_cast<float>(now - last_ns) / 1e9f;
+			real_fps = static_cast<float>(real - last_real) / seconds;
+			synthetic_fps = static_cast<float>(synthetic - last_synthetic) / seconds;
+			last_ns = now;
+			last_real = real;
+			last_synthetic = synthetic;
+		}
+		return fmt::format("ZeroFG {}: {:.1f} FPS ({:.0f} r + {:.0f} s)", OverlayModeName(s.engine_mode), real_fps + synthetic_fps,
+			real_fps, synthetic_fps);
+	}
+
+	void CaptureOverlay(const ImDrawData* draw_data)
+	{
+		State& s = s_state;
+		if (!s.presenter || !draw_data)
+			return;
+		// ImGui's textures, copied the first time they are seen and whenever they change, all along
+		// while ZeroFG is up: one made while the GS device presented is still needed once B does.
+		if (draw_data->Textures)
+		{
+			for (ImTextureData* texture : *draw_data->Textures)
+			{
+				if (texture->Status == ImTextureStatus_WantDestroy || texture->Status == ImTextureStatus_Destroyed)
+				{
+					s_overlay_textures.erase(texture->UniqueID);
+					s_overlay_pending.erase(texture->UniqueID);
+					continue;
+				}
+				if (!texture->GetPixels() || texture->Width <= 0 || texture->Height <= 0)
+					continue;
+				// A change is copied as soon as it is seen and once more when the GS device has
+				// applied it (the status is OK again): ImGui may add to a pending change, and the GS
+				// device applies it only on a present that draws something.
+				const int id = texture->UniqueID;
+				const bool pending =
+					texture->Status == ImTextureStatus_WantCreate || texture->Status == ImTextureStatus_WantUpdates;
+				const bool known = s_overlay_textures.contains(id);
+				const bool was_pending = s_overlay_pending.contains(id);
+				if (known && pending == was_pending)
+					continue;
+				if (pending)
+					s_overlay_pending.insert(id);
+				else
+					s_overlay_pending.erase(id);
+				auto copy = std::make_shared<OverlayTexture>();
+				copy->id = id;
+				copy->version = ++s_overlay_version;
+				copy->width = static_cast<u32>(texture->Width);
+				copy->height = static_cast<u32>(texture->Height);
+				const size_t count = static_cast<size_t>(copy->width) * copy->height;
+				copy->pixels.resize(count);
+				if (texture->Format == ImTextureFormat_RGBA32)
+				{
+					std::memcpy(copy->pixels.data(), texture->GetPixels(), count * sizeof(u32));
+				}
+				else
+				{
+					const u8* const alpha = static_cast<const u8*>(texture->GetPixels());
+					for (size_t i = 0; i < count; ++i)
+						copy->pixels[i] = 0x00FFFFFFu | (static_cast<u32>(alpha[i]) << 24);
+				}
+				s_overlay_textures[id] = std::move(copy);
+			}
+		}
+
+		// The draw lists, while device B presents. A rotated display is left without: the GS present
+		// rotates ImGui's vertices as it copies them, and the Post does not.
+		std::shared_ptr<OverlaySnapshot> overlay;
+		if (OwnsOutput() && GSConfig.Rotation == DisplayRotation::Rot0)
+		{
+			overlay = std::make_shared<OverlaySnapshot>();
+			overlay->origin[0] = draw_data->DisplayPos.x;
+			overlay->origin[1] = draw_data->DisplayPos.y;
+			for (const auto& [id, texture] : s_overlay_textures)
+				overlay->textures.push_back(texture);
+			overlay->vertices.reserve(static_cast<size_t>(draw_data->TotalVtxCount));
+			overlay->indices.reserve(static_cast<size_t>(draw_data->TotalIdxCount));
+			for (const ImDrawList* list : draw_data->CmdLists)
+			{
+				const s32 base_vertex = static_cast<s32>(overlay->vertices.size());
+				const u32 base_index = static_cast<u32>(overlay->indices.size());
+				overlay->vertices.insert(overlay->vertices.end(), list->VtxBuffer.begin(), list->VtxBuffer.end());
+				overlay->indices.insert(overlay->indices.end(), list->IdxBuffer.begin(), list->IdxBuffer.end());
+				for (const ImDrawCmd& command : list->CmdBuffer)
+				{
+					// A texture of the GS device's own (an icon, a cover) has no copy on device B.
+					const ImTextureData* const texture = command.TexRef._TexData;
+					if (command.UserCallback || !command.ElemCount || !texture)
+						continue;
+					OverlaySnapshot::Command& out = overlay->commands.emplace_back();
+					out.clip[0] = command.ClipRect.x - draw_data->DisplayPos.x;
+					out.clip[1] = command.ClipRect.y - draw_data->DisplayPos.y;
+					out.clip[2] = command.ClipRect.z - draw_data->DisplayPos.x;
+					out.clip[3] = command.ClipRect.w - draw_data->DisplayPos.y;
+					out.texture = texture->UniqueID;
+					out.first_index = base_index + command.IdxOffset;
+					out.vertex_offset = base_vertex + static_cast<s32>(command.VtxOffset);
+					out.index_count = command.ElemCount;
+				}
+			}
+		}
+		std::unique_lock lock(s_overlay_mutex);
+		s_overlay = std::move(overlay);
+	}
+
+	static std::atomic<bool> s_content_break_pending{false};
+
+	void CaptureGameFrame(VkCommandBuffer cmd, const GameFrame& frame)
+	{
+		State& s = s_state;
+		SourceStage& source = s.source;
+		source.captured = false;
+		// MFG: the multiplier asked for, read by the presenter as frames come in (it caps N by what the refresh holds, and a new
+		// selector applies at once).
+		cvars::zerofg_multiplier = std::clamp<u32>(GSConfig.ZeroFGMultiplier, 2, 4);
+		if (!WantsFrames() || frame.image == VK_NULL_HANDLE || !frame.output_width || !frame.output_height)
+			return;
+		const s32 content_w = frame.src[2] - frame.src[0];
+		const s32 content_h = frame.src[3] - frame.src[1];
+		const float draw_w = frame.draw[2] - frame.draw[0];
+		const float draw_h = frame.draw[3] - frame.draw[1];
+		if (content_w <= 0 || content_h <= 0 || draw_w < 1.0f || draw_h < 1.0f)
+			return;
+
+		const VulkanDevice* const device = s.kit_device_a.get();
+		const VulkanDevice::Functions& f = device->functions();
+		// The first frame of the connection sets the generation size; later frames are scaled into it
+		// wherever the game draws them (GoW2 widens its picture when progressive scan goes on).
+		if (!s.generation_extent.width)
+			s.generation_extent = GenerationExtent(draw_w, draw_h);
+		const VkExtent2D extent = s.generation_extent;
+		if (draw_w != s.draw_w || draw_h != s.draw_h)
+		{
+			if (s.draw_w != 0.0f && source.staging.extent.width == extent.width &&
+				source.staging.extent.height == extent.height)
+			{
+				INFO_LOG("ZeroFG: the game's {}x{} now drawn at {:.0f}x{:.0f}; frames stay {}x{}", content_w, content_h,
+					draw_w, draw_h, extent.width, extent.height);
+			}
+			s.draw_w = draw_w;
+			s.draw_h = draw_h;
+		}
+		if (source.staging.extent.width != extent.width || source.staging.extent.height != extent.height)
+		{
+			// A new picture size. The handoff may still be copying out of the old image.
+			if (source.staging.image != VK_NULL_HANDLE)
+			{
+				f.vkDeviceWaitIdle(device->device());
+				source.staging.Destroy(device);
+			}
+			if (!source.staging.Create(device, extent, FRAME_FORMAT,
+					VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT))
+			{
+				ERROR_LOG("ZeroFG: no {}x{} frame image on the GS device", extent.width, extent.height);
+				return;
+			}
+			source.layout = VK_IMAGE_LAYOUT_UNDEFINED;
+			INFO_LOG("ZeroFG: frames {}x{} from the game's {}x{} drawn at {:.0f}x{:.0f}", extent.width,
+				extent.height, content_w, content_h, draw_w, draw_h);
+		}
+
+		// The game's picture into the frame image, scaled to the generation size, then left the way the
+		// handoff reads it: shader-read-only, last touched in the fragment stage.
+		VkImageMemoryBarrier to_write = {VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+		to_write.srcAccessMask = 0;
+		to_write.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		to_write.oldLayout = source.layout;
+		to_write.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		to_write.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		to_write.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		to_write.image = source.staging.image;
+		to_write.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+		f.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+			VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &to_write);
+		VkImageBlit blit = {};
+		blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+		blit.srcOffsets[0] = {frame.src[0], frame.src[1], 0};
+		blit.srcOffsets[1] = {frame.src[2], frame.src[3], 1};
+		blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+		blit.dstOffsets[1] = {static_cast<s32>(extent.width), static_cast<s32>(extent.height), 1};
+		const bool same_size = extent.width == static_cast<u32>(content_w) && extent.height == static_cast<u32>(content_h);
+		f.vkCmdBlitImage(cmd, frame.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, source.staging.image,
+			VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, same_size ? VK_FILTER_NEAREST : VK_FILTER_LINEAR);
+		VkImageMemoryBarrier to_read = to_write;
+		to_read.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		to_read.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+		to_read.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		to_read.newLayout = FRAME_LAYOUT;
+		f.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0,
+			nullptr, 0, nullptr, 1, &to_read);
+		source.layout = FRAME_LAYOUT;
+
+		// ZeroGS: the frame's HUD planes the same way, P above W, for the HUD handoff.
+		source.hud_captured = false;
+		if (frame.hud_p != VK_NULL_HANDLE && frame.hud_w != VK_NULL_HANDLE)
+			++source.hud_given;
+		const s32 hud_w = frame.hud_src[2] - frame.hud_src[0];
+		const s32 hud_h = frame.hud_src[3] - frame.hud_src[1];
+		if (s.hud_handoff && !s.hud_handoff->failed() && frame.hud_p != VK_NULL_HANDLE && frame.hud_w != VK_NULL_HANDLE && hud_w > 0 &&
+			hud_h > 0)
+		{
+			const VkExtent2D hud_extent = {extent.width, extent.height * 2};
+			bool ready = source.hud_staging.extent.width == hud_extent.width && source.hud_staging.extent.height == hud_extent.height;
+			if (!ready)
+			{
+				if (source.hud_staging.image != VK_NULL_HANDLE)
+				{
+					f.vkDeviceWaitIdle(device->device());
+					source.hud_staging.Destroy(device);
+				}
+				ready = source.hud_staging.Create(device, hud_extent, FRAME_FORMAT,
+					VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT);
+				source.hud_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+			}
+			if (ready)
+			{
+				VkImageMemoryBarrier hud_write = to_write;
+				hud_write.srcAccessMask = 0;
+				hud_write.oldLayout = source.hud_layout;
+				hud_write.image = source.hud_staging.image;
+				f.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT,
+					VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &hud_write);
+				const bool hud_same_size = extent.width == static_cast<u32>(hud_w) && extent.height == static_cast<u32>(hud_h);
+				VkImageBlit hud_blit = {};
+				hud_blit.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+				hud_blit.dstSubresource = hud_blit.srcSubresource;
+				hud_blit.srcOffsets[0] = {frame.hud_src[0], frame.hud_src[1], 0};
+				hud_blit.srcOffsets[1] = {frame.hud_src[2], frame.hud_src[3], 1};
+				for (u32 plane = 0; plane < 2; plane++)
+				{
+					const s32 top = static_cast<s32>(plane * extent.height);
+					hud_blit.dstOffsets[0] = {0, top, 0};
+					hud_blit.dstOffsets[1] = {static_cast<s32>(extent.width), top + static_cast<s32>(extent.height), 1};
+					f.vkCmdBlitImage(cmd, plane ? frame.hud_w : frame.hud_p, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, source.hud_staging.image,
+						VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &hud_blit, hud_same_size ? VK_FILTER_NEAREST : VK_FILTER_LINEAR);
+				}
+				VkImageMemoryBarrier hud_read = to_read;
+				hud_read.image = source.hud_staging.image;
+				f.vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0,
+					nullptr, 0, nullptr, 1, &hud_read);
+				source.hud_layout = FRAME_LAYOUT;
+				source.hud_captured = true;
+			}
+		}
+
+		// Where the Post puts it: the GS present's draw rectangle, in the FinalOutput's pixels.
+		{
+			std::unique_lock paint_lock(s_paint_mutex);
+			const float sx = static_cast<float>(s_output_extent.width) / static_cast<float>(frame.output_width);
+			const float sy = static_cast<float>(s_output_extent.height) / static_cast<float>(frame.output_height);
+			s_paint_config.draw_rect = {frame.draw[0] * sx, frame.draw[1] * sy, frame.draw[2] * sx, frame.draw[3] * sy};
+			s_paint_config.linear_filter = frame.linear;
+		}
+		source.aspect_x = static_cast<u32>(std::lround(draw_w));
+		source.aspect_y = static_cast<u32>(std::lround(draw_h));
+		source.captured = true;
+		source.content_break = s_content_break_pending.exchange(false, std::memory_order_relaxed);
+	}
+
+	void NoteContentBreak()
+	{
+		s_content_break_pending.store(true, std::memory_order_relaxed);
+	}
+
+	void NoteSourceFrame()
+	{
+		// The Source issue, one per new game frame, on the thread that also publishes: the presenter
+		// qualifies the game's native cadence from these before it takes any frame (activation).
+		State& s = s_state;
+		if (!s.presenter)
+			return;
+		xe::RecordGuestPresent();
+		xe::RecordSourcePresent();
+		// The host asks for the activation, once per frame
+		// (IsGuestOutputPresentationBackendActive). It qualifies after this frame's capture, so the
+		// next frame is the first ZeroFG takes.
+		if (s.surface != VK_NULL_HANDLE && !s.presenter->accepting())
+			s.presenter->TryActivateFromNativeSourceCadence();
+	}
+
+	void PublishCapturedFrame()
+	{
+		State& s = s_state;
+		SourceStage& source = s.source;
+		if (!source.captured)
+			return;
+		source.captured = false;
+		if (!s.presenter || !s.handoff || !s.presenter->accepting())
+			return;
+		const u32 mailbox = source.mailbox;
+		source.mailbox = (source.mailbox + 1) % ZeroFGIndependentPresenter::kMailboxCount;
+
+		// ZeroGS: the frame's HUD planes go first, on their own handoff and the same queue, so that their copy is done by the time
+		// the frame's is and device B finds them as it takes the frame (HudPoll). Without a consumer they never hold the Source back
+		// (no free slot: this frame goes without them).
+		const bool hud = source.hud_captured && s.hud_handoff && !s.hud_handoff->failed();
+		bool hud_prepared = false;
+		if (hud)
+		{
+			source.hud_captured = false;
+			const VkSubmitInfo* const hud_submit = s.hud_handoff->PrepareSource(mailbox, source.hud_staging.image, source.hud_staging.extent);
+			if (hud_submit)
+			{
+				const uint64_t queue_begin_ns = NowNs();
+				VkResult result;
+				uint64_t submit_begin_ns;
+				{
+					const VulkanDevice::Queue::Acquisition queue =
+						s.kit_device_a->AcquireQueue(s.kit_device_a->queue_family_graphics_compute(), 0);
+					submit_begin_ns = NowNs();
+					result = s.kit_device_a->functions().vkQueueSubmit(queue.queue(), 1, hud_submit, VK_NULL_HANDLE);
+				}
+				s.hud_handoff->SourceSubmitted(result, submit_begin_ns - queue_begin_ns, NowNs() - submit_begin_ns);
+				hud_prepared = result == VK_SUCCESS;
+			}
+			else
+			{
+				++source.hud_no_slot;
+			}
+		}
+
+		// The copy into the handoff's buffer, after the frame on the same queue. May wait for a free
+		// buffer: that wait is ZeroFG's Source backpressure, lossless by design.
+		const VkSubmitInfo* const submit = s.handoff->PrepareSource(mailbox, source.staging.image, source.staging.extent);
+		if (submit)
+		{
+			const uint64_t queue_begin_ns = NowNs();
+			VkResult result;
+			uint64_t submit_begin_ns;
+			{
+				const VulkanDevice::Queue::Acquisition queue =
+					s.kit_device_a->AcquireQueue(s.kit_device_a->queue_family_graphics_compute(), 0);
+				submit_begin_ns = NowNs();
+				result = s.kit_device_a->functions().vkQueueSubmit(queue.queue(), 1, submit, VK_NULL_HANDLE);
+			}
+			s.handoff->SourceSubmitted(result, submit_begin_ns - queue_begin_ns, NowNs() - submit_begin_ns);
+		}
+
+		const xe::SourcePublicationTelemetry publication = xe::PrepareSourcePublicationTelemetry();
+		xe::CommitSourcePublicationTelemetry(publication, false);
+		ZeroFGIndependentPresenter::IngressSourcePublication metadata;
+		metadata.mailbox_index = mailbox;
+		metadata.content_width = source.staging.extent.width;
+		metadata.content_height = source.staging.extent.height;
+		metadata.display_aspect_ratio_x = source.aspect_x;
+		metadata.display_aspect_ratio_y = source.aspect_y;
+		metadata.is_8bpc = false;
+		metadata.content_break = source.content_break;
+		source.content_break = false;
+		metadata.publication = publication;
+		// The planes' publication, with the frame's source id, before the frame's (whose Publish may wait for B).
+		if (hud_prepared)
+		{
+			ZeroFGIndependentPresenter::IngressSourcePublication hud_metadata = metadata;
+			hud_metadata.content_width = source.hud_staging.extent.width;
+			hud_metadata.content_height = source.hud_staging.extent.height;
+			hud_metadata.content_break = false;
+			if (s.hud_handoff->Publish(mailbox, hud_metadata, nullptr))
+				++source.hud_published;
+		}
+		if (++source.hud_frames % 600 == 0 && s.hud_handoff)
+			DEV_LOG("ZeroFGHud A frames={} with_planes={} published={} no_slot={}", source.hud_frames, source.hud_given,
+				source.hud_published, source.hud_no_slot);
+		s.handoff->Publish(mailbox, metadata, s.presenter.get());
+		s.presenter->ClaimPublicationAuthority();
+		s.presenter->PublicationCommitted();
+	}
+#else
+	void ConnectSurface(const OutputSurface&) {}
+	void DisconnectSurface() {}
+	bool Connected() { return false; }
+	bool CanConnect() { return false; }
+	bool ModeChanged() { return false; }
+	bool OwnsOutput() { return false; }
+	bool MainSurfaceHandoffPending() { return false; }
+	void MainSurfaceReleasedByA() {}
+	bool ReconnectRequested() { return false; }
+	void FailOpen() {}
+	bool WantsFrames() { return false; }
+	void CaptureGameFrame(VkCommandBuffer, const GameFrame&) {}
+	void PublishCapturedFrame() {}
+	void CaptureOverlay(const ImDrawData*) {}
+	std::string GetOverlayText() { return {}; }
+	void NoteSourceFrame() {}
+	void NoteContentBreak() {}
+#endif
+} // namespace GSZeroFG
+
+#else
+
+namespace GSZeroFG
+{
+	bool WantsSourceHandoff() { return false; }
+	void NoteSourceHandoff(bool) {}
+	bool SourceHandoffEnabled() { return false; }
+	u32 InstanceApiVersion(u32 base) { return base; }
+	void OnDeviceCreated(const SourceDevice&) {}
+	void Shutdown() {}
+	bool IsActive() { return false; }
+	std::string GetStatusText() { return {}; }
+	void ConnectSurface(const OutputSurface&) {}
+	void DisconnectSurface() {}
+	bool Connected() { return false; }
+	bool CanConnect() { return false; }
+	bool ModeChanged() { return false; }
+	bool OwnsOutput() { return false; }
+	bool MainSurfaceHandoffPending() { return false; }
+	void MainSurfaceReleasedByA() {}
+	bool ReconnectRequested() { return false; }
+	void FailOpen() {}
+	bool WantsFrames() { return false; }
+	void CaptureGameFrame(VkCommandBuffer, const GameFrame&) {}
+	void PublishCapturedFrame() {}
+	void CaptureOverlay(const ImDrawData*) {}
+	std::string GetOverlayText() { return {}; }
+	void NoteSourceFrame() {}
+	void NoteContentBreak() {}
+} // namespace GSZeroFG
+
+#endif
+
+namespace GSZeroFG
+{
+	u64 PresenterDisplayedCount()
+	{
+#if defined(ARMSX2_HAS_ZEROFG) && ZEROFG_WITH_HOST_KIT
+		// Device B's egress ticks it for each present its display timing says the panel showed.
+		return xe::GetHostPresentDisplayedCount();
+#else
+		return 0;
+#endif
+	}
+} // namespace GSZeroFG
diff --git a/pcsx2/GS/Renderers/Vulkan/GSZeroFG.h b/pcsx2/GS/Renderers/Vulkan/GSZeroFG.h
new file mode 100644
index 0000000..35f1dfe
--- /dev/null
+++ b/pcsx2/GS/Renderers/Vulkan/GSZeroFG.h
@@ -0,0 +1,171 @@
+// SPDX-FileCopyrightText: 2026 ZeroFG authors
+// SPDX-License-Identifier: GPL-3.0+
+
+#pragma once
+
+#include "GS/Renderers/Vulkan/VKLoader.h"
+#include "common/Pcsx2Defs.h"
+
+#include <string>
+
+struct ImDrawData;
+
+/// ZeroFG frame generation (https://github.com/hy300leosquizz-ctrl/ZeroFG) on its own Vulkan device.
+///
+/// ZeroFG needs an effective Vulkan 1.3 device with synchronization2, and the GS device is a 1.1
+/// one. Rather than raise the renderer's device, ZeroFG creates its own (device B) on the same GPU
+/// and driver, from the GS instance (raised to 1.3 while ZeroFG is on: device B presents on the GS
+/// device's surface, and Android connects a window to one surface at a time). While ZeroFG is on
+/// the GS device also enables what the handoff needs (AHardwareBuffers, sync files,
+/// synchronization2); off, it is created exactly as without ZeroFG.
+///
+/// Each new game frame is copied into an image the handoff publishes to device B, where the ZeroFG
+/// Independent Presenter (built through the ZeroFG repository's host/portable kit) generates one
+/// frame between every two, runs the Post (the frame into the GS present's draw rectangle, then
+/// the ImGui overlay) and presents both, Real and generated, on the window: once it takes the
+/// window, the GS device drops its swap chain and presents nothing (Main Surface Authority). A
+/// failure gives the window back to the GS device. Switched off or to another engine in game,
+/// ZeroFG gives it back and takes it again.
+///
+/// Every entry point is a no-op when ARMSX2_HAS_ZEROFG is undefined (the play flavour, and every
+/// desktop build), so call sites need no #ifdef of their own.
+namespace GSZeroFG
+{
+	/// Asked by GSDeviceVK::SelectDeviceExtensions: whether the GS device should carry what the
+	/// handoff needs from it (AHardwareBuffers, sync files, synchronization2). True only while
+	/// ZeroFG is built in and switched on.
+	bool WantsSourceHandoff();
+
+	/// What the GS device enabled for the handoff: all of it, or nothing.
+	void NoteSourceHandoff(bool enabled);
+	bool SourceHandoffEnabled();
+
+	/// The API version GSDeviceVK creates its instance with. Device B is created from the GS instance
+	/// too, because it presents on the GS device's surface (Android lets one surface connect a window
+	/// at a time), and it needs 1.3: [base] is raised to 1.3 while ZeroFG is switched on and the
+	/// loader has it. The GS device itself uses nothing past [base].
+	u32 InstanceApiVersion(u32 base);
+
+	/// The GS device ZeroFG takes frames from (device A).
+	struct SourceDevice
+	{
+		VkInstance instance = VK_NULL_HANDLE;
+		u32 instance_api_version = 0;
+		VkPhysicalDevice physical_device = VK_NULL_HANDLE;
+		VkDevice device = VK_NULL_HANDLE;
+		VkQueue queue = VK_NULL_HANDLE;
+		u32 queue_family = 0;
+		u32 api_version = 0;
+	};
+
+	/// Called once from GSDeviceVK after its device and swap chain came up, on the GS thread
+	/// before it submits anything. When the user setting EmuCore/GS/ZeroFGEnabled is on, creates
+	/// device B on the same GPU, the engine on it, and qualifies the handoff from [source]. Any
+	/// failure leaves ZeroFG off and logs why; it never fails the GS device.
+	void OnDeviceCreated(const SourceDevice& source);
+
+	/// Releases the engine, device B and its instance. Safe to call when never brought up.
+	void Shutdown();
+
+	/// True while device B and the engine are up.
+	bool IsActive();
+
+	/// One line for the log and the overlay: what came up, or why ZeroFG is off.
+	std::string GetStatusText();
+
+	// ---- The window (Main Surface Authority) ------------------------------------------------------
+	//
+	// One producer at a time on the game's window. The GS device presents until ZeroFG's presenter
+	// owns the output; then the GS device drops its swap chain but keeps its surface
+	// (MainSurfaceHandoffPending), and device B presents on that surface, voting the panel's high
+	// refresh. If the presenter fails it gives the window back (ReconnectRequested): the GS device
+	// rebuilds its swap chain on the surface and keeps the window (FailOpen). All on the GS thread.
+
+	/// The window, the GS device's surface on it and the swap chain the GS device has there.
+	struct OutputSurface
+	{
+		void* window = nullptr; ///< ANativeWindow*
+		VkSurfaceKHR surface = VK_NULL_HANDLE;
+		u32 width = 0;
+		u32 height = 0;
+		VkFormat format = VK_FORMAT_UNDEFINED;
+	};
+
+	/// Offers the window to the presenter, after the GS device (re)created its swap chain on it.
+	void ConnectSurface(const OutputSurface& output);
+	/// Takes the presenter off the window, before the GS device drops its swap chain or the window
+	/// goes away, or when ZeroFG is switched off in game. Waits for the work the window still has in
+	/// flight.
+	void DisconnectSurface();
+	/// The presenter is on the window, whoever presents on it now.
+	bool Connected();
+	/// A presenter is up, off the window, and may be offered it (ZeroFG switched back on in game, or
+	/// a new presenter after a fail-open).
+	bool CanConnect();
+	/// The engine mode was switched in game (GSConfig.ZeroFGMode): the GS device takes the presenter
+	/// off the window, and the next ConnectSurface rebuilds the engine in the new mode.
+	bool ModeChanged();
+
+	/// The presenter owns what reaches the screen: the GS device must not present.
+	bool OwnsOutput();
+	/// ... and wants the window now: the GS device drops its swap chain, then says so.
+	bool MainSurfaceHandoffPending();
+	void MainSurfaceReleasedByA();
+	/// The presenter gave the window back after a failure (or its surface went out of date).
+	bool ReconnectRequested();
+	/// Takes the failed presenter off the window and replaces it, so the next connection gets a new
+	/// one; after too many failures on this device ZeroFG stays off it and the GS device presents alone.
+	void FailOpen();
+
+	// ---- The frames -----------------------------------------------------------------------------
+
+	/// A new game frame was presented (taken by ZeroFG or not). The presenter learns the game's own
+	/// cadence from these before it takes frames at all. GS thread.
+	void NoteSourceFrame();
+
+	/// The game frame about to be captured starts a new scene or screen (the GS draw signature changed: the textures of the frame share little with the
+	/// frame before). The presenter then publishes it alone, with no synthetic across the break. GS thread.
+	void NoteContentBreak();
+
+	/// True while the presenter takes frames.
+	bool WantsFrames();
+
+	/// The game's frame of this present and where the present drew it.
+	struct GameFrame
+	{
+		VkImage image = VK_NULL_HANDLE; ///< in TRANSFER_SRC_OPTIMAL (the caller transitions it)
+		s32 src[4] = {};                ///< the visible area in it: left, top, right, bottom
+		float draw[4] = {};             ///< where the present drew it, in output pixels
+		bool linear = true;             ///< the present's filter: bilinear, else nearest
+		u32 output_width = 0;           ///< the size of the output the draw rectangle is in
+		u32 output_height = 0;
+		/// ZeroGS: the frame's HUD planes (P drawn over black, W over white; GSDevice::GetZeroFGPlane), in
+		/// TRANSFER_SRC_OPTIMAL, and the frame's visible area in them; null when the frame has none.
+		VkImage hud_p = VK_NULL_HANDLE;
+		VkImage hud_w = VK_NULL_HANDLE;
+		s32 hud_src[4] = {};
+	};
+
+	/// Records the copy of [frame] into the image ZeroFG takes it from, at the size frames are generated
+	/// at, into [cmd], the frame's own command buffer (where the game texture's layout is tracked).
+	void CaptureGameFrame(VkCommandBuffer cmd, const GameFrame& frame);
+	/// After that command buffer is submitted: hands the frame to the presenter. May wait while
+	/// ZeroFG's buffers are all taken, which is ZeroFG's Source backpressure.
+	void PublishCapturedFrame();
+
+	/// ImGui's draw data of this present (the OSD and the performance overlay), right after
+	/// ImGui::Render and before the GS device updates its ImGui textures. While device B presents,
+	/// its Post draws it over every output, Real and Synthetic, as the GS present draws it over its
+	/// own; the GS device's own textures (icons) are left out. GS thread, every present.
+	void CaptureOverlay(const ImDrawData* draw_data);
+
+	/// ZeroFG's line in the performance overlay, beside LSFG's: what reaches the screen while it
+	/// presents (Real and generated frames per second, over half-second windows), "starting" until
+	/// it takes the window, "off" after it failed; empty while switched off. GS thread.
+	std::string GetOverlayText();
+
+	/// The presents of device B's presenter the display showed, by its display timing (0 without
+	/// the presenter or the timing); the overlay's "Display" rate adds them to the GS device's own.
+	/// Any thread.
+	u64 PresenterDisplayedCount();
+} // namespace GSZeroFG
diff --git a/pcsx2/GS/Renderers/Vulkan/GSZeroFGPostShaders.h b/pcsx2/GS/Renderers/Vulkan/GSZeroFGPostShaders.h
new file mode 100644
index 0000000..3cc94a4
--- /dev/null
+++ b/pcsx2/GS/Renderers/Vulkan/GSZeroFGPostShaders.h
@@ -0,0 +1,208 @@
+// SPDX-FileCopyrightText: 2026 ZeroFG authors
+// SPDX-License-Identifier: GPL-3.0+
