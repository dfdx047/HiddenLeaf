+void EeScheduler::setVideoMode(uint32_t mode)
+{
+    // the vblank already scheduled keeps its deadline; the new period applies from the next one
+    const bool pal = mode == 3u;
+    m_vblankPeriodCycles = pal ? microsecondsToEeCycles(20000u) : kVBlankPeriodCycles;
+    m_vblankPeriod = pal ? std::chrono::microseconds(20000) : kVBlankPeriod;
+    if (s_palVideo.exchange(pal) != pal)
+    {
+        std::cerr << "[gs-crt] video mode " << mode << ": vblank at " << (pal ? "50" : "60") << " Hz" << std::endl;
+    }
+}
+
+EeScheduler::FieldRate EeScheduler::fieldRate() noexcept
+{
+    return s_palVideo.load(std::memory_order_relaxed) ? FieldRate{50u, 1u} : FieldRate{60000u, 1001u};
+}
