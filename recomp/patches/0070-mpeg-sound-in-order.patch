+        std::vector<uint8_t> hlAudioCopy(const uint8_t *rdram, uint32_t addr, uint32_t len)
+        {
+            std::vector<uint8_t> out(len);
+            const uint32_t end = g_hlRingBase + g_hlRingSize;
+            for (uint32_t i = 0; i < len; ++i)
+            {
+                uint32_t a = addr + i;
+                if (g_hlRingSize != 0u && a >= end)
