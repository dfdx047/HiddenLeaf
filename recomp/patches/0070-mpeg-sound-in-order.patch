+        void hlAudioReset(const char *why)
+        {
+            std::lock_guard<std::mutex> lock(g_hlAudioMutex);
+            std::fprintf(stderr, "[mpeg] sound packets at %s: %u taken, %u held a while, %u lost, %zu pending\n", why, g_hlAudioSent, g_hlAudioHeld, g_hlAudioLost, g_hlAudioFifo.size());
