diff --git a/ps2xRuntime/include/runtime/hl_nominum_vu1.h b/ps2xRuntime/include/runtime/hl_nominum_vu1.h
new file mode 100644
index 0000000..41c408f
--- /dev/null
+++ b/ps2xRuntime/include/runtime/hl_nominum_vu1.h
@@ -0,0 +1,29 @@
+// Hidden Leaf: NOMINUM_VU1=1, the VIF1 and the VU1 of Nominum Render (its core/vif1 with the recompiled VU1 blocks) in place
+// of this runtime's processVIF1Data and VU1Interpreter, on the same thread (the VuWorker on Android), in the same order.
+// The runtime keeps its own copies of what the game sees (vif1_regs, the VU1 memories, what a DIRECT left owed, the PATH3
+// mask): they go into Nominum's VIF1 before each transfer and come back after it. The host sets g_transfer (Android:
+// recomp/android/host/hl_nominum_vu1.cpp); null, the runtime's own VIF1 runs, as before.
+#pragma once
+
+#include <cstdint>
+
+namespace hl_nvu1
+{
+    struct Shared
+    {
+        uint8_t *code;              // 16 KB, the VU1's micro memory
+        uint8_t *data;              // 16 KB, its data memory
+        uint32_t *regs;             // the 23 words of VIFRegisters
+        uint32_t *pendingDirectQwc; // what a DIRECT left owed
+        uint32_t *pendingImageQwc;
+        bool *pendingImageDirectHl;
+        bool *path3Masked;
+    };
+    // path 1 (XGKICK) or 2 (DIRECT/DIRECTHL)
+    using GifFn = void (*)(void *ctx, int path, const uint8_t *data, uint32_t size, bool directHl);
+    using MaskFn = void (*)(void *ctx, bool masked); // MSKPATH3 changed
+    // returns true when the transfer changed the micro memory (MPG)
+    using TransferFn = bool (*)(const Shared &shared, const uint8_t *data, uint32_t size, GifFn gif, MaskFn mask, void *ctx);
+
+    extern TransferFn g_transfer;
+}
