diff --git a/ps2xRuntime/src/lib/hl_vu_worker.cpp b/ps2xRuntime/src/lib/hl_vu_worker.cpp
new file mode 100644
index 0000000..1c377a9
--- /dev/null
+++ b/ps2xRuntime/src/lib/hl_vu_worker.cpp
@@ -0,0 +1,203 @@
+// Hidden Leaf (Android): a thread for what a DMA kick to VIF1 or GIF starts: VIF1 unpacks, VU1 microprograms, XGKICKs and the
+// writes to the ring of PCSX2's GS. In a fight this was 60% of the game thread, and it is parallel on the PS2 as well.
+//
+// The game sees the DMA finish at once, as before: the chain was already copied at the kick, so nothing here reads guest memory.
+// What the worker owns (VU1 memory, vif1_regs, the PATH3 mask) the game thread reaches only after sync(): PS2Memory calls it when
+// the game touches those registers or that memory. A vsync goes through the queue, so the stream keeps its order, and the game
+// may be only one frame ahead of the worker.
+#include "runtime/hl_vu_worker.h"
+#include "runtime/hl_perf.h"
+#include "runtime/ps2_memory.h"
+
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <exception>
+#include <mutex>
+#include <thread>
+#if defined(__linux__)
+#include <sys/prctl.h>
+#endif
+
+namespace hl_vuworker
+{
+    namespace
+    {
+        struct Command
+        {
+            Kind kind = Kind::Call;
+            bool frameEnd = false;
+            PS2Memory *memory = nullptr;
+            std::vector<uint8_t> data;
+            std::function<void()> call;
+        };
+
+        constexpr uint64_t kMaxQueuedBytes = 48ull << 20;
+
+        std::mutex s_mutex;
+        std::condition_variable s_wakeWorker, s_wakeGame;
+        std::deque<Command> s_queue;
+        std::vector<std::vector<uint8_t>> s_free;
+        uint64_t s_queuedBytes = 0;
+        uint32_t s_framesQueued = 0;
+        bool s_running = false; // running a command
+        bool s_workerAsleep = false;
+        bool s_gameWaiting = false;
+        thread_local bool t_worker = false;
+
+        void execute(Command &command)
+        {
+            try
+            {
+                switch (command.kind)
+                {
+                case Kind::Vif1:
+                    command.memory->processVIF1Data(command.data.data(), static_cast<uint32_t>(command.data.size()));
+                    break;
+                case Kind::Gif:
+                    command.memory->submitGifPacket(GifPathId::Path3, command.data.data(), static_cast<uint32_t>(command.data.size()), true);
+                    break;
+                case Kind::Call:
+                    command.call();
+                    break;
+                }
+            }
+            catch (const std::exception &e)
+            {
+                std::fprintf(stderr, "[vuworker] %s\n", e.what());
+            }
+        }
+
+        void workerMain()
+        {
+            t_worker = true;
+#if defined(__linux__)
+            prctl(PR_SET_NAME, "VuWorker", 0, 0, 0);
+#endif
+            std::unique_lock lock(s_mutex);
+            for (;;)
+            {
+                if (s_queue.empty())
+                {
+                    s_running = false;
+                    if (s_gameWaiting)
+                        s_wakeGame.notify_all();
+                    // a moment awake: a kick usually follows, and waking this thread is the game thread's cost
+                    lock.unlock();
+                    for (int i = 0; i < 2000; ++i)
+                    {
+#if defined(__aarch64__)
+                        __asm__ volatile("isb");
+#endif
+                    }
+                    lock.lock();
+                    if (s_queue.empty())
+                    {
+                        s_workerAsleep = true;
+                        s_wakeWorker.wait(lock, [] { return !s_queue.empty(); });
+                        s_workerAsleep = false;
+                    }
+                }
+                Command command = std::move(s_queue.front());
+                s_queue.pop_front();
+                s_running = true;
+                lock.unlock();
+
+                execute(command);
+
+                lock.lock();
+                s_queuedBytes -= command.data.size();
+                if (command.frameEnd)
+                    --s_framesQueued;
+                if (command.data.capacity() != 0u && s_free.size() < 16u)
+                {
+                    command.data.clear();
+                    s_free.push_back(std::move(command.data));
+                }
+                if (s_gameWaiting)
+                    s_wakeGame.notify_all();
+            }
+        }
+
+        void start()
+        {
+            static std::once_flag once;
+            std::call_once(once, [] { std::thread(workerMain).detach(); });
+        }
+
+        void push(Command &&command)
+        {
+            start();
+            std::unique_lock lock(s_mutex);
+            if (s_queuedBytes > kMaxQueuedBytes || (command.frameEnd && s_framesQueued >= 1u))
+            {   // (the game is too far ahead of the worker)
+                hl_perf::Scope wait(hl_perf::kWaitVu);
+                s_gameWaiting = true;
+                const bool frameEnd = command.frameEnd;
+                s_wakeGame.wait(lock, [frameEnd] { return s_queuedBytes <= kMaxQueuedBytes && (!frameEnd || s_framesQueued < 1u); });
+                s_gameWaiting = false;
+            }
+            s_queuedBytes += command.data.size();
+            if (command.frameEnd)
+                ++s_framesQueued;
+            s_queue.push_back(std::move(command));
+            if (s_workerAsleep)
+                s_wakeWorker.notify_one();
+        }
+    }
+
+    bool enabled()
+    {
+        static const bool on = []
+        {
+            const char *v = std::getenv("HL_VUWORKER");
+            return !(v && std::strcmp(v, "0") == 0);
+        }();
+        return on;
+    }
+
+    bool onWorker() { return t_worker; }
+
+    void post(PS2Memory *memory, Kind kind, std::vector<uint8_t> &&data)
+    {
+        Command command;
+        command.kind = kind;
+        command.memory = memory;
+        command.data = std::move(data);
+        push(std::move(command));
+    }
+
+    void postCall(std::function<void()> call, bool frameEnd)
+    {
+        Command command;
+        command.kind = Kind::Call;
+        command.frameEnd = frameEnd;
+        command.call = std::move(call);
+        push(std::move(command));
+    }
+
+    void sync()
+    {
+        if (t_worker || !enabled())
+            return;
+        std::unique_lock lock(s_mutex);
+        if (s_queue.empty() && !s_running)
+            return;
+        hl_perf::Scope wait(hl_perf::kWaitVu);
+        s_gameWaiting = true;
+        s_wakeGame.wait(lock, [] { return s_queue.empty() && !s_running; });
+        s_gameWaiting = false;
+    }
+
+    std::vector<uint8_t> takeBuffer()
+    {
+        std::lock_guard lock(s_mutex);
+        if (s_free.empty())
+            return {};
+        std::vector<uint8_t> buffer = std::move(s_free.back());
+        s_free.pop_back();
+        return buffer;
+    }
+}
