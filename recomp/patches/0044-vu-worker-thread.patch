+                        }
+                    }
+                    off += 16u;
+                }
+            }
+            else if (flg == GIF_FMT_REGLIST)
+                off += ((nloop * nreg + 1u) & ~1u) * 8u;
+            else
+                off += nloop * 16u;
+        }
