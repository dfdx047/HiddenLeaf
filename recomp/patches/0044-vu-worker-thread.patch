+                const uint64_t bytes = static_cast<uint64_t>(nloop) * nreg * 16u;
+                if (!anyAd)
+                {
+                    if (off + bytes > sizeBytes)
+                        return;
+                    off += static_cast<uint32_t>(bytes);
+                    continue;
+                }
+                for (uint32_t i = 0u; i < nloop * nreg; ++i)
