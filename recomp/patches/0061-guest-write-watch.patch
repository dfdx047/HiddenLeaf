+namespace hl_watch
+{
+    extern uint32_t g_addr;
+    void hitFast(uint32_t addr, uint32_t size, uint64_t value);
+}
+#define HL_WATCH_FAST(addr, size, value)                                                         \
+    do                                                                                           \
+    {                                                                                            \
+        const uint32_t hlwA = (addr) & PS2_RAM_MASK;                                             \
+        if (hlwA < hl_watch::g_addr + 8u && hlwA + (size) > hl_watch::g_addr)                    \
+            hl_watch::hitFast(hlwA, (size), (value));                                            \
+    } while (0)
+#else
+#define HL_WATCH_FAST(addr, size, value) ((void)0)
+#endif
+
