+// Hidden Leaf: HL_IOP_THREAD=1, the IOP (and the SPU2 it drives) on a thread of its own. The EE hands the IOP each batch
+// of cycles (advanceIopEeCycles) through a queue and goes on at once; the IOP runs the batches meanwhile, the same batches
+// in the same order, on its own core. The EE waits only when the IOP is more than HL_IOP_LAG EE cycles behind (default
+// 65536, ~220 us of the PS2), and anything the EE asks of the IOP (RPC, SIF DMA into its RAM, its RAM, modules) first
+// waits for the queue to be empty (iopSync), so the IOP is where the EE is, and only one thread ever runs it. What the
+// IOP does to the EE's side (writes to EE RAM: sceSifSetDma, RPC replies; SIF commands, whose EE handlers are guest
+// code) is kept and done on the game thread at the next handover, in order.
+// Why: on the Mi A3 in a fight the IOP and the SPU2 took ~5 ms of each vsync of the game thread, the one that sets the
+// pace; the IOP's batches come in bursts (one in 11 took ~140 us more than the EE's), so one batch of slack was not
+// enough (2026-11-12).
+namespace hl_iopw
+{
+    namespace
+    {
+        thread_local bool t_worker = false;
+        bool s_started = false;
+        std::thread s_thread;
+        ps2x::iop::IopSubsystem *s_iop = nullptr;
+        std::atomic<bool> s_quit{false};
+        std::atomic<bool> s_sleeping{false};
+        std::mutex s_sleepMutex;
+        std::condition_variable s_sleepCv;
+
+        // the batches, and what the EE sends the IOP between them (SIF DMA into its RAM): written by the EE at s_head,
+        // done by the worker from s_tail, in order, so each arrives when the IOP's clock is where the EE's was
+        struct Item
+        {
+            uint8_t kind = 0; // 0 cycles, 1 write to IOP RAM, 2 SIF transfer notice
+            uint64_t cycles = 0;
+            uint32_t address = 0;
+            std::vector<uint8_t> data;
+            ps2x::iop::SifTransfer transfer{};
+        };
+        constexpr uint32_t kRing = 1024u;
+        Item s_ring[kRing];
+        std::atomic<uint32_t> s_head{0}, s_tail{0};
+        std::atomic<uint64_t> s_queued{0}; // EE cycles posted and not yet run
+        uint64_t s_lag = 16000000u; // (HL_IOP_LAG; 65536 and 262144 left the EE waiting after each idle skip, 2026-11-12)
+
+        struct Op
+        {
+            uint8_t kind; // 0 write, 1 zero, 2 SIF command
+            uint32_t address;
+            uint32_t size;
+            uint32_t at;
+        };
+        // (the worker adds while the EE takes: a small lock, taken a few hundred times a frame)
+        std::mutex s_opMutex;
+        std::vector<Op> s_ops;
+        std::vector<uint8_t> s_bytes;
+        std::atomic<uint32_t> s_opCount{0};
+
+        // HL_IOP_STATS=1: every 100000 handovers, where the game thread's IOP time goes
+        struct Stats
+        {
+            uint64_t bigPosts = 0, bigCycles = 0, cycles = 0;
+            uint64_t posts = 0, waits = 0, waitTicks = 0, syncs = 0, syncTicks = 0, rpcs = 0, rpcTicks = 0, xfers = 0, xferTicks = 0, ops = 0, opTicks = 0;
+        } s_stats;
+        std::atomic<uint64_t> s_runTicks{0};
+        std::atomic<uint64_t> s_runMax{0}, s_runMaxCycles{0}, s_slowRuns{0};
+        bool statsOn()
+        {
+            static const bool on = std::getenv("HL_IOP_STATS") != nullptr;
+            return on;
+        }
+
+        inline uint64_t ticks()
+        {
+#if defined(__aarch64__)
+            uint64_t v;
+            __asm__ volatile("mrs %0, cntvct_el0" : "=r"(v));
+            return v;
+#else
+            return static_cast<uint64_t>(std::chrono::steady_clock::now().time_since_epoch().count());
+#endif
+        }
+        inline uint64_t ticksPerUs()
+        {
+#if defined(__aarch64__)
+            uint64_t f;
+            __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f));
+            return std::max<uint64_t>(f / 1000000u, 1u);
+#else
+            return std::max<uint64_t>(static_cast<uint64_t>(std::chrono::steady_clock::period::den) / std::chrono::steady_clock::period::num / 1000000u, 1u);
+#endif
+        }
+        inline void relax()
+        {
+#if defined(__aarch64__)
+            __asm__ volatile("yield");
+#elif defined(__x86_64__) || defined(__i386__)
+            __builtin_ia32_pause();
+#endif
+        }
+
+        void loop()
+        {
+            t_worker = true;
+            ThreadNaming::SetCurrentThreadName("IopWorker");
+            // With the queue empty: HL_IOP_SPIN_US of spinning (default 0), then a nap of HL_IOP_NAP_US (default 300) that the
+            // EE does not cut short unless it waits for the IOP. The IOP needs ~6 ms of the 20 of a vsync: spinning for the
+            // rest took the fourth big core of the Mi A3 from the others (the EE 1-3 ms slower a vsync, 2026-11-12).
+            static const uint64_t spinTicks = []
+            {
+                const char *v = std::getenv("HL_IOP_SPIN_US");
+                return (v ? std::strtoull(v, nullptr, 10) : 0ull) * ticksPerUs();
+            }();
+            static const auto nap = []
+            {
+                const char *v = std::getenv("HL_IOP_NAP_US");
+                return std::chrono::microseconds(v ? std::strtoull(v, nullptr, 10) : 300ull);
+            }();
+            for (;;)
+            {
+                uint64_t since = 0;
+                uint32_t tail = s_tail.load(std::memory_order_relaxed);
+                while (s_head.load(std::memory_order_acquire) == tail)
+                {
+                    if (s_quit.load(std::memory_order_relaxed))
+                        return;
+                    if (!since)
+                        since = ticks();
+                    if (ticks() - since < spinTicks)
+                    {
+                        relax();
+                        continue;
+                    }
+                    std::unique_lock<std::mutex> lock(s_sleepMutex);
+                    s_sleeping.store(true, std::memory_order_seq_cst);
+                    if (s_head.load(std::memory_order_seq_cst) == tail && !s_quit.load(std::memory_order_relaxed))
+                        s_sleepCv.wait_for(lock, nap);
+                    s_sleeping.store(false, std::memory_order_relaxed);
+                    since = 0;
+                }
+                Item &item = s_ring[tail % kRing];
+                if (item.kind != 0u)
+                {
+                    if (item.kind == 1u)
+                        (void)s_iop->writeMemory(item.address, item.data.data(), item.data.size());
+                    else
+                        s_iop->onSifTransfer(item.transfer);
+                    s_tail.store(tail + 1u, std::memory_order_release);
+                    continue;
+                }
+                const uint64_t cycles = item.cycles;
+                const uint64_t t0 = statsOn() ? ticks() : 0u;
+                s_iop->runEeCycles(cycles);
+                if (t0)
+                {
+                    const uint64_t d = ticks() - t0;
+                    s_runTicks.fetch_add(d, std::memory_order_relaxed);
+                    if (d > s_runMax.load(std::memory_order_relaxed))
+                    {
+                        s_runMax.store(d, std::memory_order_relaxed);
+                        s_runMaxCycles.store(cycles, std::memory_order_relaxed);
+                    }
+                    if (d > 500u * ticksPerUs())
+                        s_slowRuns.fetch_add(1u, std::memory_order_relaxed);
+                }
+                s_queued.fetch_sub(cycles, std::memory_order_relaxed);
+                s_tail.store(tail + 1u, std::memory_order_release);
+            }
+        }
+
+        void push(uint8_t kind, uint32_t address, const void *source, size_t size)
+        {
+            std::lock_guard<std::mutex> lock(s_opMutex);
+            const uint32_t at = static_cast<uint32_t>(s_bytes.size());
+            if (source)
+                s_bytes.insert(s_bytes.end(), static_cast<const uint8_t *>(source), static_cast<const uint8_t *>(source) + size);
+            s_ops.push_back({kind, address, static_cast<uint32_t>(size), at});
+            s_opCount.store(static_cast<uint32_t>(s_ops.size()), std::memory_order_release);
+        }
+
+        // The game thread: what the IOP left for the EE's side, done here in order
+        void apply(PS2IopHostAdapter &host)
+        {
+            if (s_opCount.load(std::memory_order_acquire) == 0u)
+                return;
+            static std::vector<Op> ops;
+            static std::vector<uint8_t> bytes;
+            static int depth = 0;
+            // (a SIF handler that calls the IOP back syncs again: the newer ops wait for the outer call to finish)
+            if (depth)
+                return;
+            ++depth;
+            const uint64_t t0 = statsOn() ? ticks() : 0u;
+            {
+                std::lock_guard<std::mutex> lock(s_opMutex);
+                ops.swap(s_ops);
+                bytes.swap(s_bytes);
+                s_opCount.store(0u, std::memory_order_relaxed);
+            }
+            s_stats.ops += ops.size();
+            for (const Op &op : ops)
+            {
+                if (op.kind == 0u)
+                    host.writeGuest(op.address, bytes.data() + op.at, op.size);
+                else if (op.kind == 1u)
+                    host.zeroGuest(op.address, op.size);
+                else
+                    host.sendSifCommand(op.address, bytes.data() + op.at, op.size);
+            }
+            ops.clear();
+            bytes.clear();
+            if (t0)
+                s_stats.opTicks += ticks() - t0;
+            --depth;
+        }
+
+        void wake()
+        {
+            if (s_sleeping.load(std::memory_order_seq_cst))
+            {
+                std::lock_guard<std::mutex> lock(s_sleepMutex);
+                s_sleepCv.notify_one();
+            }
+        }
+
+        void waitUntil(uint64_t maxQueued, uint64_t &count, uint64_t &sum)
+        {
+            if (s_queued.load(std::memory_order_acquire) <= maxQueued && (maxQueued || s_head.load(std::memory_order_relaxed) == s_tail.load(std::memory_order_acquire)))
+                return;
+            hl_perf::Scope waiting(hl_perf::kIop);
+            const uint64_t t0 = statsOn() ? ticks() : 0u;
+            wake();
+            if (maxQueued)
+                while (s_queued.load(std::memory_order_acquire) > maxQueued)
+                    relax();
+            else
+                while (s_head.load(std::memory_order_relaxed) != s_tail.load(std::memory_order_acquire))
+                    relax();
+            if (t0)
+            {
+                ++count;
+                sum += ticks() - t0;
+            }
+        }
+    }
+
+    bool onWorker() { return t_worker; }
+    void deferWrite(uint32_t address, const void *source, size_t size) { push(0, address, source, size); }
+    void deferZero(uint32_t address, size_t size) { push(1, address, nullptr, size); }
+    void deferSifCommand(uint32_t commandId, const void *packet, size_t packetSize) { push(2, commandId, packet, packetSize); }
+
+    bool enabled()
+    {
+        static const bool on = []
+        {
+            const char *v = std::getenv("HL_IOP_THREAD");
+            return v && v[0] == '1';
+        }();
+        return on;
+    }
+
+    // The game thread, before anything that reads or changes the IOP: the queue run, the IOP's EE-side work done
+    void wait(PS2IopHostAdapter &host)
+    {
+        if (!s_started || t_worker)
+            return;
+        waitUntil(0u, s_stats.syncs, s_stats.syncTicks);
+        apply(host);
+    }
+
+    void start(ps2x::iop::IopSubsystem *iop)
+    {
+        s_iop = iop;
+        if (const char *v = std::getenv("HL_IOP_LAG"))
+            s_lag = std::max<uint64_t>(std::strtoull(v, nullptr, 10), 1u);
+        s_quit.store(false);
+        s_thread = std::thread(loop);
+        s_started = true;
+        std::fprintf(stderr, "[iop] the IOP on its own thread (HL_IOP_THREAD=1), up to %llu EE cycles behind\n", static_cast<unsigned long long>(s_lag));
+    }
+
+    void report()
+    {
+        if (!statsOn() || ++s_stats.posts % 100000u)
+            return;
+        const double tpm = static_cast<double>(ticksPerUs()) * 1000.0;
+        std::fprintf(stderr, "[iop] %llu handovers: lag waits %llu (%.1f ms), syncs %llu (%.1f ms), RPC %llu (%.1f ms), SIF in %llu (%.1f ms), EE-side ops %llu (%.1f ms), worker ran %.1f ms\n",
+                     (unsigned long long)s_stats.posts, (unsigned long long)s_stats.waits, s_stats.waitTicks / tpm,
+                     (unsigned long long)s_stats.syncs, s_stats.syncTicks / tpm,
+                     (unsigned long long)s_stats.rpcs, s_stats.rpcTicks / tpm, (unsigned long long)s_stats.xfers, s_stats.xferTicks / tpm,
+                     (unsigned long long)s_stats.ops, s_stats.opTicks / tpm, s_runTicks.exchange(0) / tpm);
+        std::fprintf(stderr, "[iop]   batches over 64k cycles %llu (%llu of %llu cycles), worker runs over 0.5 ms %llu, longest %.2f ms (%llu cycles)\n",
+                     (unsigned long long)s_stats.bigPosts, (unsigned long long)s_stats.bigCycles, (unsigned long long)s_stats.cycles,
+                     (unsigned long long)s_slowRuns.exchange(0), s_runMax.exchange(0) / tpm, (unsigned long long)s_runMaxCycles.load());
+        s_stats = {};
+    }
+    struct Timed
+    {
+        uint64_t *count, *sum, t0;
+        Timed(uint64_t &c, uint64_t &t) : count(&c), sum(&t), t0(statsOn() ? ticks() : 0u) {}
+        ~Timed()
+        {
+            if (t0)
+            {
+                ++*count;
+                *sum += ticks() - t0;
+            }
+        }
+    };
+
+    // The game thread: room for one more item at the head
+    Item &slot()
+    {
+        if (s_head.load(std::memory_order_relaxed) - s_tail.load(std::memory_order_acquire) >= kRing)
+        {
+            hl_perf::Scope waiting(hl_perf::kIop);
+            wake();
+            while (s_head.load(std::memory_order_relaxed) - s_tail.load(std::memory_order_acquire) >= kRing)
+                relax();
+        }
+        return s_ring[s_head.load(std::memory_order_relaxed) % kRing];
+    }
+    void publish()
+    {
+        // (no wake: the worker comes back from its nap by itself; the EE wakes it only when it waits, in waitUntil)
+        s_head.store(s_head.load(std::memory_order_relaxed) + 1u, std::memory_order_seq_cst);
+    }
+    bool queuing() { return s_started && !t_worker; }
+    // EE -> IOP SIF DMA: the bytes, for the IOP to take at its time
+    void queueWrite(uint32_t address, const void *source, size_t size)
+    {
+        Item &item = slot();
+        item.kind = 1u;
+        item.cycles = 0u;
+        item.address = address;
+        item.data.assign(static_cast<const uint8_t *>(source), static_cast<const uint8_t *>(source) + size);
+        publish();
+    }
+    void queueTransfer(const ps2x::iop::SifTransfer &transfer)
+    {
+        Item &item = slot();
+        item.kind = 2u;
+        item.cycles = 0u;
+        item.transfer = transfer;
+        publish();
+    }
+
+    // The game thread: a batch for the IOP
+    void post(PS2IopHostAdapter &host, uint64_t cycles)
+    {
+        report();
+        if (statsOn())
+        {
+            s_stats.cycles += cycles;
+            if (cycles > 65536u)
+            {
+                ++s_stats.bigPosts;
+                s_stats.bigCycles += cycles;
+            }
+        }
+        apply(host);
+        // (the queue has room for 1024 batches; the lag in cycles is the real limit)
+        const uint64_t room = s_lag > cycles ? s_lag - cycles : 0u;
+        if (room == 0u)
+            waitUntil(0u, s_stats.waits, s_stats.waitTicks);
+        else
+            waitUntil(room, s_stats.waits, s_stats.waitTicks);
+        Item &item = slot();
+        item.kind = 0u;
+        item.cycles = cycles;
+        s_queued.fetch_add(cycles, std::memory_order_release);
+        publish();
+    }
+
+    void stop()
+    {
+        if (!s_started)
+            return;
+        s_quit.store(true);
+        {
+            std::lock_guard<std::mutex> lock(s_sleepMutex);
+            s_sleepCv.notify_one();
+        }
+        if (s_thread.joinable())
+            s_thread.join();
+        s_started = false;
+    }
+}
