@@ -765,68 +765,66 @@ namespace ps2recomp
                            inst.rt, inst.rt);
     }
 
+    // VLQI/VSQI/VLQD/VSQD move a quadword between a VF register and the VU0 data memory (4 KB, 256 quadwords; the VI
+    // register holds a quadword index, wrapped to the memory), and step the VI register after (I) or before (D).
+    // VLQx ft, (is): ft = bits 16-20, is = bits 11-15. VSQx fs, (it): fs = bits 11-15, it = bits 16-20.
+    static std::string vu0DataAddress(int vi)
+    {
+        return fmt::format("(((uint32_t)ctx->vi[{}] & 0xFFu) << 4)", vi);
+    }
+
+    static std::string vu0StepVi(int vi, int delta)
+    {
+        // vi0 is hardwired to 0 (and put back after every instruction anyway)
+        return vi == 0 ? std::string() : fmt::format("ctx->vi[{}] = (uint16_t)(ctx->vi[{}] + ({})); ", vi, vi, delta);
+    }
+
+    static std::string vu0Mask(uint8_t dest)
+    {
+        return fmt::format("_mm_castsi128_ps(_mm_set_epi32({}, {}, {}, {}))", (dest & 0x1) ? -1 : 0, (dest & 0x2) ? -1 : 0,
+                           (dest & 0x4) ? -1 : 0, (dest & 0x8) ? -1 : 0);
+    }
+
+    static std::string vu0Load(const Instruction &inst, int step)
+    {
+        const int ft = inst.rt, is = inst.rd;
+        const uint8_t dest = inst.vectorInfo.vectorField;
+        return fmt::format("{{ {}uint8_t *vu0d = runtime->memory().getVU0Data(); "
+                           "__m128 res = _mm_castsi128_ps(_mm_loadu_si128(reinterpret_cast<const __m128i *>(vu0d + {}))); "
+                           "ctx->vu0_vf[{}] = _mm_blendv_ps(ctx->vu0_vf[{}], res, {}); {}}}",
+                           step < 0 ? vu0StepVi(is, -1) : "", vu0DataAddress(is), ft, ft, vu0Mask(dest),
+                           step > 0 ? vu0StepVi(is, 1) : "");
+    }
+
+    static std::string vu0Store(const Instruction &inst, int step)
+    {
+        const int fs = inst.rd, it = inst.rt;
+        const uint8_t dest = inst.vectorInfo.vectorField;
+        return fmt::format("{{ {}uint8_t *vu0d = runtime->memory().getVU0Data(); __m128i *slot = reinterpret_cast<__m128i *>(vu0d + {}); "
+                           "__m128 res = _mm_blendv_ps(_mm_castsi128_ps(_mm_loadu_si128(slot)), ctx->vu0_vf[{}], {}); "
+                           "_mm_storeu_si128(slot, _mm_castps_si128(res)); {}}}",
+                           step < 0 ? vu0StepVi(it, -1) : "", vu0DataAddress(it), fs, vu0Mask(dest),
+                           step > 0 ? vu0StepVi(it, 1) : "");
+    }
+
