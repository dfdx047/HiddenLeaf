+    // Hidden Leaf: where each file sits on the real disc. hl_lbn.txt next to the extracted files (tools/un5.py lbn:
+    // "<first sector, hex> <bytes> <path>" per line) gives the files their sectors on the disc instead of pseudo ones,
+    // so the game sees the numbers it sees on the PS2 and in PCSX2 (docs/registro.md, 2026-11-08).
+    std::unordered_map<std::string, uint32_t> g_cdRealLbn;
+    std::filesystem::path g_cdRealLbnRoot;
+    bool g_cdRealLbnLoaded = false;
+
+    uint32_t cdRealLbn(const std::filesystem::path &root, const std::filesystem::path &file)
+    {
+        if (!g_cdRealLbnLoaded || g_cdRealLbnRoot != root)
+        {
+            g_cdRealLbnLoaded = true;
+            g_cdRealLbnRoot = root;
+            g_cdRealLbn.clear();
+            std::ifstream in(root / "hl_lbn.txt");
+            std::string line;
+            while (std::getline(in, line))
+            {
+                const size_t a = line.find(' ');
+                const size_t b = a == std::string::npos ? a : line.find(' ', a + 1);
+                if (b == std::string::npos)
+                    continue;
+                std::string path = line.substr(b + 1);
+                while (!path.empty() && (path.back() == '\r' || path.back() == '\n'))
+                    path.pop_back();
+                g_cdRealLbn[toLowerAscii(path)] = static_cast<uint32_t>(std::strtoul(line.substr(0, a).c_str(), nullptr, 16));
+            }
+        }
+        std::error_code ec;
+        const std::filesystem::path relative = std::filesystem::relative(file, root, ec);
+        if (ec)
+            return 0u;
+        const auto it = g_cdRealLbn.find(toLowerAscii(relative.generic_string()));
+        return it == g_cdRealLbn.end() ? 0u : it->second;
+    }
