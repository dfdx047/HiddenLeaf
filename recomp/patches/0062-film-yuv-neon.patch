+// Hidden Leaf (patch 0062): YUV 4:2:0 (limited range, BT.601) to RGBA, the same bytes as libswscale's unscaled C converter
+// (yuv2rgb_c_32 with the default colorspace details), without its tables: each channel is Yt[838 + j], j = Y + d(U, V), and
+// the table entry i is clip8(((i - 512) * cy - (384 << 16) - oy + 0x8000) >> 16), so Yt[838 + j] = clip8(((j + 326) * cy
+// - (384 << 16) - oy + 0x8000) >> 16). The NEON path does the same integer steps.
+#pragma once
+#include <cstdint>
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+
+namespace hl_yuv
+{
+    struct Coeffs
+    {
+        int32_t cy, oy, crv, cbu, cgu, cgv; // (cgu, cgv negative)
+        int32_t offR, offB, offGU, offGV;    // -(c >> 9)
+    };
+
+    inline Coeffs coeffs()
+    {
+        // ff_yuv2rgb_coeffs[SWS_CS_ITU601] and ff_yuv2rgb_c_init_tables(fullRange 0, brightness 0, contrast and saturation 1 << 16)
+        const int64_t inv[4] = {104597, 132201, 25675, 53279};
+        int64_t cy = (int64_t(1) << 16) * 255 / 219;
+        const int64_t oy = int64_t(16) << 16;
+        int64_t crv = inv[0], cbu = inv[1], cgu = -inv[2], cgv = -inv[3];
+        crv = (crv * (int64_t(1) << 16) * (int64_t(1) << 16)) >> 32;
+        cbu = (cbu * (int64_t(1) << 16) * (int64_t(1) << 16)) >> 32;
+        cgu = (cgu * (int64_t(1) << 16) * (int64_t(1) << 16)) >> 32;
+        cgv = (cgv * (int64_t(1) << 16) * (int64_t(1) << 16)) >> 32;
+        cy = (cy * (int64_t(1) << 16)) >> 16;
+        crv = ((crv * (int64_t(1) << 16)) + 0x8000) / cy;
+        cbu = ((cbu * (int64_t(1) << 16)) + 0x8000) / cy;
+        cgu = ((cgu * (int64_t(1) << 16)) + 0x8000) / cy;
+        cgv = ((cgv * (int64_t(1) << 16)) + 0x8000) / cy;
+        Coeffs c{};
+        c.cy = int32_t(cy);
+        c.oy = int32_t(oy);
+        c.crv = int32_t(crv);
+        c.cbu = int32_t(cbu);
+        c.cgu = int32_t(cgu);
+        c.cgv = int32_t(cgv);
+        c.offR = int32_t(-(crv >> 9));
+        c.offB = int32_t(-(cbu >> 9));
+        c.offGU = int32_t(-(cgu >> 9));
+        c.offGV = int32_t(-(cgv >> 9));
+        return c;
+    }
+
+    inline uint8_t yt(const Coeffs &c, int32_t j) // j = Y + chroma offset
+    {
+        const int64_t v = (int64_t(j + 326) * c.cy - (int64_t(384) << 16) - c.oy + 0x8000) >> 16;
+        return uint8_t(v < 0 ? 0 : v > 255 ? 255 : v);
+    }
+
+    inline void pixel(const Coeffs &c, int y, int dr, int dg, int db, uint8_t *out)
+    {
+        out[0] = yt(c, y + dr);
+        out[1] = yt(c, y + dg);
+        out[2] = yt(c, y + db);
+        out[3] = 255;
+    }
+
+    // (int64 products: (V * crv) >> 16 is a floor, as in fill_table)
+    inline int dR(const Coeffs &c, int v) { return int((int64_t(v) * c.crv) >> 16) + c.offR; }
+    inline int dB(const Coeffs &c, int u) { return int((int64_t(u) * c.cbu) >> 16) + c.offB; }
+    inline int dG(const Coeffs &c, int u, int v) { return int((int64_t(u) * c.cgu) >> 16) + c.offGU + int((int64_t(v) * c.cgv) >> 16) + c.offGV; }
+
+    // Scalar reference: w and h even.
+    inline void convertScalar(const Coeffs &c, const uint8_t *py, int ys, const uint8_t *pu, int us, const uint8_t *pv, int vs,
+                              uint8_t *dst, int ds, int w, int h)
+    {
+        for (int row = 0; row < h; ++row)
+        {
+            const uint8_t *yr = py + row * ys, *ur = pu + (row >> 1) * us, *vr = pv + (row >> 1) * vs;
+            uint8_t *d = dst + row * ds;
+            for (int x = 0; x < w; ++x)
+            {
+                const int u = ur[x >> 1], v = vr[x >> 1];
+                pixel(c, yr[x], dR(c, v), dG(c, u, v), dB(c, u), d + x * 4);
+            }
+        }
+    }
+
+#if defined(__aarch64__)
+    // NEON: 16 pixels a step (w a multiple of 16). The chroma offsets in 16 bits (|d| < 512), the luma step in 32 bits.
+    inline uint8x8_t ytNeon(int16x8_t j, int32x4_t cy, int32x4_t base)
+    {
+        // ((j + 326) * cy - (384 << 16) - oy + 0x8000) >> 16, then clip to 0..255; base = 326 * cy - (384 << 16) - oy + 0x8000
+        const int32x4_t lo = vmlaq_s32(base, vmovl_s16(vget_low_s16(j)), cy);
+        const int32x4_t hi = vmlaq_s32(base, vmovl_s16(vget_high_s16(j)), cy);
+        const int16x8_t v = vcombine_s16(vshrn_n_s32(lo, 16), vshrn_n_s32(hi, 16));
+        return vqmovun_s16(v);
+    }
+
+    // (v * k) >> 16 for 8 values of 0..255 (floor, as the int64 shift of fill_table), plus off, in 16 bits
+    inline int16x8_t chromaNeon(uint16x8_t v, int32_t k, int32_t off)
+    {
+        const int32x4_t kk = vdupq_n_s32(k), oo = vdupq_n_s32(off);
+        const int32x4_t lo = vaddq_s32(vshrq_n_s32(vmulq_s32(vreinterpretq_s32_u32(vmovl_u16(vget_low_u16(v))), kk), 16), oo);
+        const int32x4_t hi = vaddq_s32(vshrq_n_s32(vmulq_s32(vreinterpretq_s32_u32(vmovl_u16(vget_high_u16(v))), kk), 16), oo);
+        return vcombine_s16(vmovn_s32(lo), vmovn_s32(hi));
+    }
+
+    inline void rowNeon(const uint8_t *yr, uint8_t *d, int16x8x2_t rr, int16x8x2_t gg, int16x8x2_t bb, int32x4_t cy, int32x4_t base,
+                        uint8_t alpha = 255)
+    {
+        const uint8x16_t yv = vld1q_u8(yr);
+        const int16x8_t y0 = vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(yv)));
+        const int16x8_t y1 = vreinterpretq_s16_u16(vmovl_u8(vget_high_u8(yv)));
+        uint8x16x4_t out;
+        out.val[0] = vcombine_u8(ytNeon(vaddq_s16(y0, rr.val[0]), cy, base), ytNeon(vaddq_s16(y1, rr.val[1]), cy, base));
+        out.val[1] = vcombine_u8(ytNeon(vaddq_s16(y0, gg.val[0]), cy, base), ytNeon(vaddq_s16(y1, gg.val[1]), cy, base));
+        out.val[2] = vcombine_u8(ytNeon(vaddq_s16(y0, bb.val[0]), cy, base), ytNeon(vaddq_s16(y1, bb.val[1]), cy, base));
+        out.val[3] = vdupq_n_u8(alpha);
+        vst4q_u8(d, out);
+    }
+
+    // NEON: 16 pixels of two rows a step (w a multiple of 16, h even); the two rows share their chroma.
+    inline void convertNeon(const Coeffs &c, const uint8_t *py, int ys, const uint8_t *pu, int us, const uint8_t *pv, int vs,
+                            uint8_t *dst, int ds, int w, int h)
+    {
+        const int32x4_t cy = vdupq_n_s32(c.cy);
+        const int32x4_t base = vdupq_n_s32(326 * c.cy - (384 << 16) - c.oy + 0x8000);
+        for (int row = 0; row < h; row += 2)
+        {
+            const uint8_t *y0r = py + row * ys, *y1r = y0r + ys, *ur = pu + (row >> 1) * us, *vr = pv + (row >> 1) * vs;
+            uint8_t *d0 = dst + row * ds, *d1 = d0 + ds;
+            for (int x = 0; x < w; x += 16)
+            {
+                const uint16x8_t u = vmovl_u8(vld1_u8(ur + (x >> 1))), v = vmovl_u8(vld1_u8(vr + (x >> 1)));
+                const int16x8_t r = chromaNeon(v, c.crv, c.offR);
+                const int16x8_t b = chromaNeon(u, c.cbu, c.offB);
+                const int16x8_t g = vaddq_s16(chromaNeon(u, c.cgu, c.offGU), chromaNeon(v, c.cgv, c.offGV));
+                const int16x8x2_t rr = vzipq_s16(r, r), gg = vzipq_s16(g, g), bb = vzipq_s16(b, b);
+                rowNeon(y0r + x, d0 + x * 4, rr, gg, bb, cy, base);
+                rowNeon(y1r + x, d1 + x * 4, rr, gg, bb, cy, base);
+            }
+        }
+    }
+#endif
+}
+
+namespace hl_yuv
+{
+    // The film's frame straight into the guest's image (sceMpegGetPicture's RGB32 layout): columns of 16 pixels, each column
+    // outHeight rows of 16 * 4 bytes, alpha 0x80; rows past the picture are black. w a multiple of 16, h even.
+    inline void convertToGuestColumns(const uint8_t *py, int ys, const uint8_t *pu, int us, const uint8_t *pv, int vs, int w, int h,
+                                      int outHeight, uint8_t *dest)
+    {
+        static const Coeffs c = coeffs();
+#if defined(__aarch64__)
+        const int32x4_t cy = vdupq_n_s32(c.cy);
+        const int32x4_t base = vdupq_n_s32(326 * c.cy - (384 << 16) - c.oy + 0x8000);
+#endif
+        for (int x = 0; x < w; x += 16)
+        {
+            uint8_t *column = dest + static_cast<size_t>(x / 16) * static_cast<size_t>(outHeight) * 64u;
+            for (int row = 0; row < h; row += 2)
+            {
+                const uint8_t *y0r = py + row * ys, *ur = pu + (row >> 1) * us, *vr = pv + (row >> 1) * vs;
+                uint8_t *d0 = column + static_cast<size_t>(row) * 64u;
+#if defined(__aarch64__)
+                const uint16x8_t u = vmovl_u8(vld1_u8(ur + (x >> 1))), v = vmovl_u8(vld1_u8(vr + (x >> 1)));
+                const int16x8_t r = chromaNeon(v, c.crv, c.offR);
+                const int16x8_t b = chromaNeon(u, c.cbu, c.offB);
+                const int16x8_t g = vaddq_s16(chromaNeon(u, c.cgu, c.offGU), chromaNeon(v, c.cgv, c.offGV));
+                const int16x8x2_t rr = vzipq_s16(r, r), gg = vzipq_s16(g, g), bb = vzipq_s16(b, b);
+                rowNeon(y0r + x, d0, rr, gg, bb, cy, base, 0x80u);
+                rowNeon(y0r + ys + x, d0 + 64, rr, gg, bb, cy, base, 0x80u);
+#else
+                for (int r2 = 0; r2 < 2; ++r2)
+                    for (int i = 0; i < 16; ++i)
+                    {
+                        const int u = ur[(x + i) >> 1], v = vr[(x + i) >> 1];
+                        uint8_t *o = d0 + r2 * 64 + i * 4;
+                        pixel(c, y0r[r2 * ys + x + i], dR(c, v), dG(c, u, v), dB(c, u), o);
+                        o[3] = 0x80u;
+                    }
+#endif
+            }
+            for (int row = h; row < outHeight; ++row)
+                for (int i = 0; i < 16; ++i)
+                {
+                    uint8_t *o = column + static_cast<size_t>(row) * 64u + i * 4;
+                    o[0] = o[1] = o[2] = 0u;
+                    o[3] = 0x80u;
+                }
+        }
+    }
+}
