+bool EeScheduler::guestInterruptsMasked() const
+{
+    // Status.EIE (bit 16) is what the game's DI/EI clear and set around its critical sections
+    const GuestThread *running = currentThread();
+    return running != nullptr && !m_insideInterrupt && (running->activeContext().cop0_status & 0x10000u) == 0u;
+}
