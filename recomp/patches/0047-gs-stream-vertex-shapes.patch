+    // The VU1 programs of this game send {FOG, STQ, RGBA, XYZ2} and the same with NOPs in it, four registers per vertex, and
+    // PCSX2's GS has loops for vertices only in the shapes without NOPs: this way each register is a call through a pointer.
+    // The same vertices fit those shapes: the fog goes in XYZF2, which also has room for Z as long as it fits 24 bits (a tag
+    // with a larger Z stays as it came). HL_GSCOMPACT=0 turns it off.
+    std::vector<uint8_t> s_compact;
+
+    uint32_t compactVertices(const uint8_t *data, uint32_t size)
+    {
+        if (s_compact.size() < size)
+            s_compact.resize(size);
+        uint8_t *out = s_compact.data();
+        uint32_t offset = 0u;
+        while (offset + 16u <= size)
+        {
+            uint64_t lo, hi;
+            std::memcpy(&lo, data + offset, 8u);
+            std::memcpy(&hi, data + offset + 8u, 8u);
+            const uint32_t qwords = tagQwords(lo);
+            const uint8_t *from = data + offset + 16u;
+            const uint32_t nloop = static_cast<uint32_t>(lo & 0x7FFFu);
+            uint32_t newNreg = 0u;
+            uint64_t newRegs = 0u;
+            if (((lo >> 58) & 3u) == 0u && ((lo >> 60) & 15u) == 4u && nloop != 0u)
+            {
+                switch (hi & 0xFFFFu)
+                {
+                case 0x512Au:
+                {
+                    bool fits = true;
+                    for (uint32_t i = 0u; i < nloop && fits; ++i)
+                    {
+                        uint32_t z;
+                        std::memcpy(&z, from + i * 64u + 48u + 8u, 4u);
+                        fits = z <= 0xFFFFFFu;
+                    }
+                    if (fits)
+                    {
+                        newNreg = 3u;
+                        newRegs = 0x412u;
+                    }
+                    break;
+                }
+                case 0x512Fu:
+                    newNreg = 3u;
+                    newRegs = 0x512u;
+                    break;
+                case 0x5FF2u:
+                    newNreg = 2u;
+                    newRegs = 0x52u;
+                    break;
+                case 0x5FFFu:
+                    newNreg = 1u;
+                    newRegs = 0x5u;
+                    break;
+                default:
+                    break;
+                }
+            }
+            if (newNreg == 0u)
+            {
+                std::memcpy(out, data + offset, 16u + qwords * 16u);
+                out += 16u + qwords * 16u;
+            }
+            else
+            {
+                lo = (lo & ~(15ull << 60)) | (static_cast<uint64_t>(newNreg) << 60);
+                std::memcpy(out, &lo, 8u);
+                std::memcpy(out + 8u, &newRegs, 8u);
+                out += 16u;
+                if (newRegs == 0x412u)
+                {
+                    for (uint32_t i = 0u; i < nloop; ++i, from += 64u, out += 48u)
+                    {
+                        std::memcpy(out, from + 16u, 32u + 8u);
+                        uint64_t fog, xyz;
+                        std::memcpy(&fog, from + 8u, 8u);
+                        std::memcpy(&xyz, from + 48u + 8u, 8u);
+                        xyz = ((xyz & 0xFFFFFFull) << 4) | (fog & (0xFFull << 36)) | (xyz & (1ull << 47));
+                        std::memcpy(out + 40u, &xyz, 8u);
+                    }
+                }
+                else if (newNreg == 3u)
+                {
+                    for (uint32_t i = 0u; i < nloop; ++i, from += 64u, out += 48u)
+                        std::memcpy(out, from + 16u, 48u);
+                }
+                else if (newNreg == 2u)
+                {
+                    for (uint32_t i = 0u; i < nloop; ++i, from += 64u, out += 32u)
+                    {
+                        std::memcpy(out, from, 16u);
+                        std::memcpy(out + 16u, from + 48u, 16u);
+                    }
+                }
+                else
+                {
+                    for (uint32_t i = 0u; i < nloop; ++i, from += 64u, out += 16u)
+                        std::memcpy(out, from + 48u, 16u);
+                }
+            }
+            offset += 16u + qwords * 16u;
+        }
+        return static_cast<uint32_t>(out - s_compact.data());
+    }
