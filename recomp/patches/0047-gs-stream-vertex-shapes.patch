+    // HL_GSCAP=<file>:<vsync>:<count>: the GIF packets of <count> vsyncs from <vsync>: [path u32][size u32][bytes], and a
+    // record with path 0xFF at each vsync (to look at a frame on the PC: tools/gscap.py)
+    uint32_t s_capVsync = 0u;
+    FILE *capFile()
+    {
+        static uint32_t s_from = 0u, s_count = 0u;
+        static FILE *const s_file = []() -> FILE * {
+            const char *env = std::getenv("HL_GSCAP");
+            if (!env)
+                return nullptr;
+            char path[256]{};
+            if (std::sscanf(env, "%255[^:]:%u:%u", path, &s_from, &s_count) != 3)
+                return nullptr;
+            return std::fopen(path, "wb");
+        }();
+        if (!s_file || s_capVsync < s_from || s_capVsync >= s_from + s_count)
+            return nullptr;
+        return s_file;
+    }
