+// Code the game loads at run time (overlays): a game module sets this to find the recompiled function for a PC
+// outside the generated table, from what is in guest memory now. Returns nullptr when there is none.
+using PS2OverlayResolver = PS2Runtime::RecompiledFunction (*)(PS2Runtime *runtime, uint32_t address);
+extern PS2OverlayResolver g_ps2OverlayResolver;
