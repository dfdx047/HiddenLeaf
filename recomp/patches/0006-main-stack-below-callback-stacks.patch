+void PS2Runtime::excludeAsyncCallbackStackRange(uint32_t low, uint32_t high)
+{
+    std::lock_guard<std::mutex> lock(m_asyncCallbackStackMutex);
+    // the callback stacks are carved down from m_asyncCallbackStackTop: start them under the range when they would
+    // reach into it (SetupThread(-1) puts the main stack right under the top of RAM, where they began)
+    if (low < high && low < m_asyncCallbackStackTop && high > m_asyncCallbackStackFloor)
+    {
+        m_asyncCallbackStackTop = std::max(low & ~0xFu, m_asyncCallbackStackFloor);
+    }
+}
