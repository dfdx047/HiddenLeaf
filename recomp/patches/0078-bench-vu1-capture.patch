+extern std::mutex g_hlGifCapMutex;
+extern std::FILE *g_hlVuCap;
+// HLB_VU1TRACE=K0,K1: each instruction (pc, VI, VF) of the captured starts K0..K1, and the code once at K0
+static uint32_t g_hlVuStart = 0;
+static bool hlVuTracing()
+{
+    static uint32_t k0 = 1, k1 = 0;
+    static const bool read = [] { if (const char *v = std::getenv("HLB_VU1TRACE")) std::sscanf(v, "%u,%u", &k0, &k1); return true; }();
+    (void)read;
+    return g_hlVuStart != 0 && g_hlVuStart - 1 >= k0 && g_hlVuStart - 1 <= k1;
+}
+static void hlVuTraceStep(const VU1State &s)
+{
+    std::lock_guard<std::mutex> lock(g_hlGifCapMutex);
+    if (g_hlVuCap == nullptr || !hlVuTracing())
+        return;
+    const uint32_t h[3] = {0xA3u, 4u + 32u + 512u, s.pc};
+    std::fwrite(h, 4, 3, g_hlVuCap);
+    for (int i = 0; i < 16; ++i)
+    {
+        const uint16_t w = static_cast<uint16_t>(s.vi[i]);
+        std::fwrite(&w, 2, 1, g_hlVuCap);
+    }
+    std::fwrite(s.vf, 1, 512u, g_hlVuCap);
+}
+static void hlVuCapWrite(const VU1State &s, const uint8_t *data, uint32_t dataSize, const uint8_t *code)
+{
+    std::lock_guard<std::mutex> lock(g_hlGifCapMutex);
+    if (g_hlVuCap == nullptr || dataSize != 0x4000u)
+        return;
+    ++g_hlVuStart;
+    if (code != nullptr)
+    {
+        uint32_t fnv = 2166136261u; // the code's FNV-1a, each start
+        for (uint32_t i = 0; i < 0x4000u; ++i)
+            fnv = (fnv ^ code[i]) * 16777619u;
+        const uint32_t c[3] = {0xA6u, 4u, fnv};
+        std::fwrite(c, 4, 3, g_hlVuCap);
+        static uint32_t lastFnv = 0;
+        if (fnv != lastFnv) // the code itself, when it changed
+        {
+            lastFnv = fnv;
+            const uint32_t k[2] = {0xA7u, 0x4000u};
+            std::fwrite(k, 4, 2, g_hlVuCap);
+            std::fwrite(code, 1, 0x4000u, g_hlVuCap);
+        }
+    }
+    if (hlVuTracing() && code != nullptr)
+    {
+        static bool codeDone = false;
+        if (!codeDone)
+        {
+            codeDone = true;
+            const uint32_t c[2] = {0xA4u, 0x4000u};
+            std::fwrite(c, 4, 2, g_hlVuCap);
+            std::fwrite(code, 1, 0x4000u, g_hlVuCap);
+        }
+    }
+    const uint32_t h[3] = {0xA1u, 4u + 0x4000u + 512u + 64u, s.pc};
+    std::fwrite(h, 4, 3, g_hlVuCap);
+    std::fwrite(data, 1, 0x4000u, g_hlVuCap);
+    std::fwrite(s.vf, 1, 512u, g_hlVuCap);
+    for (int i = 0; i < 16; ++i)
+    {
+        const uint32_t w = static_cast<uint32_t>(s.vi[i]) & 0xFFFFu;
+        std::fwrite(&w, 4, 1, g_hlVuCap);
+    }
+}
