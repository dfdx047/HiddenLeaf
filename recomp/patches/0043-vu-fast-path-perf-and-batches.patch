diff --git a/ps2xRuntime/src/lib/hl_perf.cpp b/ps2xRuntime/src/lib/hl_perf.cpp
new file mode 100644
index 0000000..037cb73
--- /dev/null
+++ b/ps2xRuntime/src/lib/hl_perf.cpp
@@ -0,0 +1,247 @@
+// Hidden Leaf: the per-frame numbers of HL_PERF=1 (see runtime/hl_perf.h). Every second a line in the log and on the overlay.
+// HL_PERF_FROM=<vsync>: the fixed measure: from that vsync 10 s of warm-up, then 30 s measured, then a [perf] RESULT line.
+#include "runtime/hl_perf.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+#if defined(__linux__)
+#include <dirent.h>
+#endif
+
+namespace hl_perf
+{
+    bool g_on = false;
+
+    namespace
+    {
+        thread_local bool t_game = false;
+        Cat s_current = kEe;
+        uint64_t s_last = 0;
+        uint64_t s_ticks[kCount] = {};
+        std::atomic<uint64_t> s_bytes{0};
+
+        inline uint64_t now()
+        {
+#if defined(__aarch64__)
+            uint64_t v;
+            __asm__ volatile("mrs %0, cntvct_el0" : "=r"(v));
+            return v;
+#else
+            return static_cast<uint64_t>(std::chrono::steady_clock::now().time_since_epoch().count());
+#endif
+        }
+
+        double ticksPerMs()
+        {
+#if defined(__aarch64__)
+            uint64_t f;
+            __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(f));
+            return static_cast<double>(f) / 1000.0;
+#else
+            return static_cast<double>(std::chrono::steady_clock::period::den) / std::chrono::steady_clock::period::num / 1000.0;
+#endif
+        }
+
+        struct Window
+        {
+            uint64_t startTick = 0;
+            uint64_t ticks[kCount] = {};
+            uint64_t gsNs = 0;
+            uint64_t bytes = 0;
+            uint32_t frames = 0;
+            std::vector<float> frameMs;
+        };
+
+        // CPU time of PCSX2's GS threads ("GS", and "CPU Thread" that feeds it)
+        uint64_t gsThreadsNs()
+        {
+            uint64_t total = 0;
+#if defined(__linux__)
+            DIR *dir = opendir("/proc/self/task");
+            if (!dir)
+                return 0;
+            while (dirent *entry = readdir(dir))
+            {
+                if (entry->d_name[0] == '.')
+                    continue;
+                char path[96], comm[32] = {};
+                std::snprintf(path, sizeof(path), "/proc/self/task/%s/comm", entry->d_name);
+                FILE *f = std::fopen(path, "r");
+                if (!f)
+                    continue;
+                const bool ok = std::fgets(comm, sizeof(comm), f) != nullptr;
+                std::fclose(f);
+                if (!ok || (std::strncmp(comm, "GS\n", 3) != 0 && std::strncmp(comm, "CPU Thread\n", 11) != 0))
+                    continue;
+                std::snprintf(path, sizeof(path), "/proc/self/task/%s/schedstat", entry->d_name);
+                f = std::fopen(path, "r");
+                if (!f)
+                    continue;
+                unsigned long long ns = 0;
+                if (std::fscanf(f, "%llu", &ns) == 1)
+                    total += ns;
+                std::fclose(f);
+            }
+            closedir(dir);
+#endif
+            return total;
+        }
+
+        std::mutex s_lineMutex;
+        std::string s_line;
+
+        Window s_second, s_measure;
+        uint64_t s_gsLast = 0;
+        uint64_t s_lastVsync = 0, s_secondStart = 0, s_measureStart = 0;
+        enum class Phase { Off, Waiting, Warm, Measuring, Done } s_phase = Phase::Off;
+        uint32_t s_from = 0;
+
+        void accumulate(Window &w, const uint64_t *deltaTicks, uint64_t gsNs, uint64_t bytes)
+        {
+            for (int i = 0; i < kCount; ++i)
+                w.ticks[i] += deltaTicks[i];
+            w.gsNs += gsNs;
+            w.bytes += bytes;
+        }
+
+        std::string describe(const Window &w, double fps, double tpm)
+        {
+            const double frames = std::max<uint32_t>(w.frames, 1u);
+            const auto ms = [&](Cat c) { return static_cast<double>(w.ticks[c]) / tpm / frames; };
+            char text[256];
+            std::snprintf(text, sizeof(text), "%.1f fps | EE %.1f VU0 %.1f VU1 %.1f GS %.1f IOP %.1f parse %.1f ring %.1f waitGS %.1f idle %.1f ms | %.2f MB/f",
+                          fps, ms(kEe), ms(kVu0), ms(kVu1), static_cast<double>(w.gsNs) / 1e6 / frames, ms(kIop), ms(kGifParse), ms(kRing), ms(kWaitGs), ms(kIdle),
+                          static_cast<double>(w.bytes) / 1048576.0 / frames);
+            return text;
+        }
+    }
+
+    Cat switchTo(Cat next)
+    {
+        if (!t_game)
+            return next;
+        const uint64_t t = now();
+        s_ticks[s_current] += t - s_last;
+        s_last = t;
+        const Cat previous = s_current;
+        s_current = next;
+        return previous;
+    }
+
+    void backToEe()
+    {
+        if (g_on && s_current != kEe)
+            switchTo(kEe);
+    }
+
+    void startOnGameThread()
+    {
+        if (!std::getenv("HL_PERF"))
+            return;
+        t_game = true;
+        s_last = s_secondStart = s_lastVsync = now();
+        if (const char *from = std::getenv("HL_PERF_FROM"))
+        {
+            s_from = static_cast<uint32_t>(std::atoi(from));
+            s_phase = Phase::Waiting;
+        }
+        g_on = true;
+    }
+
+    void addStreamBytes(uint64_t bytes)
+    {
+        if (g_on)
+            s_bytes.fetch_add(bytes, std::memory_order_relaxed);
+    }
+
+    void onVsync(uint32_t tick)
+    {
+        if (!g_on || !t_game)
+            return;
+        static const double tpm = ticksPerMs();
+        const Cat here = switchTo(s_current); // (brings the counters up to now)
+        (void)here;
+        const uint64_t t = s_last;
+        const float frameMs = static_cast<float>(static_cast<double>(t - s_lastVsync) / tpm);
+        s_lastVsync = t;
+        ++s_second.frames;
+
+        if (s_phase == Phase::Waiting && tick >= s_from)
+        {
+            s_phase = Phase::Warm;
+            s_measureStart = t;
+            std::fprintf(stderr, "[perf] vsync %u: 10 s of warm-up\n", tick);
+        }
+        else if (s_phase == Phase::Warm && static_cast<double>(t - s_measureStart) / tpm >= 10000.0)
+        {
+            s_phase = Phase::Measuring;
+            s_measureStart = t;
+            s_measure = {};
+            std::fprintf(stderr, "[perf] vsync %u: measuring 30 s\n", tick);
+        }
+        if (s_phase == Phase::Measuring)
+        {
+            ++s_measure.frames;
+            s_measure.frameMs.push_back(frameMs);
+        }
+
+        if (static_cast<double>(t - s_secondStart) / tpm < 1000.0)
+            return;
+
+        // a second is up: everything since the last one
+        static uint64_t s_prev[kCount] = {};
+        uint64_t delta[kCount];
+        for (int i = 0; i < kCount; ++i)
+        {
+            delta[i] = s_ticks[i] - s_prev[i];
+            s_prev[i] = s_ticks[i];
+        }
+        const uint64_t gsNow = gsThreadsNs();
+        const uint64_t gsDelta = gsNow - s_gsLast;
+        s_gsLast = gsNow;
+        const uint64_t bytes = s_bytes.exchange(0, std::memory_order_relaxed);
+        accumulate(s_second, delta, gsDelta, bytes);
+        if (s_phase == Phase::Measuring)
+            accumulate(s_measure, delta, gsDelta, bytes);
+
+        const double fps = s_second.frames * 1000.0 / (static_cast<double>(t - s_secondStart) / tpm);
+        const std::string text = describe(s_second, fps, tpm);
+        {
+            std::lock_guard<std::mutex> lock(s_lineMutex);
+            s_line = text;
+        }
+        std::fprintf(stderr, "[perf] v%u %s\n", tick, text.c_str());
+        s_second = {};
+        s_secondStart = t;
+
+        if (s_phase == Phase::Measuring && static_cast<double>(t - s_measureStart) / tpm >= 30000.0)
+        {
+            s_phase = Phase::Done;
+            const double seconds = static_cast<double>(t - s_measureStart) / tpm / 1000.0;
+            std::vector<float> sorted = s_measure.frameMs;
+            std::sort(sorted.begin(), sorted.end(), [](float a, float b) { return a > b; });
+            const size_t worst = std::max<size_t>(1u, sorted.size() / 100u);
+            double sum = 0.0;
+            for (size_t i = 0; i < worst && i < sorted.size(); ++i)
+                sum += sorted[i];
+            const double low = sum > 0.0 ? 1000.0 / (sum / static_cast<double>(worst)) : 0.0;
+            const std::string result = describe(s_measure, s_measure.frames / seconds, tpm);
+            std::fprintf(stderr, "[perf] RESULT low1 %.1f fps, %u frames in %.1f s: %s\n", low, s_measure.frames, seconds, result.c_str());
+        }
+    }
+
+    const char *line()
+    {
+        static std::string copy;
+        std::lock_guard<std::mutex> lock(s_lineMutex);
+        copy = s_line;
+        return copy.c_str();
+    }
+}
