+// HL_VUCENSUS=<dir>: which microprograms the game runs: a binary of each distinct image in <dir>, a table in the log.
+namespace
+{
+    struct VuProgStat
+    {
+        uint64_t runs = 0, cycles = 0;
+        uint32_t maxPc = 0;
+        std::map<uint32_t, uint64_t> entries;
+    };
+    const char *vuCensusDir()
+    {
+        static const char *dir = std::getenv("HL_VUCENSUS");
+        return dir;
+    }
+    uint64_t vuFnv(const uint8_t *data, uint32_t size)
+    {
+        uint64_t h = 1469598103934665603ull;
+        for (uint32_t i = 0; i < size; ++i)
+            h = (h ^ data[i]) * 1099511628211ull;
+        return h;
+    }
+    std::map<uint64_t, VuProgStat> s_vuStats[2];
+    struct VuCensus
+    {
+        VuProgStat *stat = nullptr;
+        const uint64_t &cycle;
+        uint64_t start;
+        VuCensus(bool vu1, const uint8_t *code, uint32_t size, PS2Memory *memory, uint32_t pc, const uint64_t &cycleRef)
+            : cycle(cycleRef), start(cycleRef)
+        {
+            if (!vuCensusDir() || !memory)
+                return;
+            static uint64_t s_gen[2] = {~0ull, ~0ull}, s_hash[2] = {};
+            const uint64_t gen = vu1 ? memory->getVU1CodeGeneration() : memory->getVU0CodeGeneration();
+            if (gen != s_gen[vu1])
+            {
+                s_gen[vu1] = gen;
+                const uint64_t h = vuFnv(code, size);
+                s_hash[vu1] = h;
+                if (s_vuStats[vu1].find(h) == s_vuStats[vu1].end())
+                {
+                    char path[512];
+                    std::snprintf(path, sizeof(path), "%s/vu%d_%016llx.bin", vuCensusDir(), vu1 ? 1 : 0, static_cast<unsigned long long>(h));
+                    if (FILE *f = std::fopen(path, "wb"))
+                    {
+                        std::fwrite(code, 1, size, f);
+                        std::fclose(f);
+                    }
+                }
+            }
+            stat = &s_vuStats[vu1][s_hash[vu1]];
+            ++stat->runs;
+            ++stat->entries[pc];
+        }
+        ~VuCensus()
+        {
+            if (!stat)
+                return;
+            stat->cycles += cycle - start;
+            static auto s_last = std::chrono::steady_clock::now();
+            const auto now = std::chrono::steady_clock::now();
+            if (now - s_last < std::chrono::seconds(10))
+                return;
+            s_last = now;
+            for (int u = 0; u < 2; ++u)
+                for (const auto &[hash, s] : s_vuStats[u])
+                {
+                    std::string entries;
+                    for (const auto &[pc, n] : s.entries)
+                        entries += " " + std::to_string(pc) + ":" + std::to_string(n);
+                    std::fprintf(stderr, "[vucensus] vu%d %016llx runs=%llu cycles=%llu entries%s\n", u, static_cast<unsigned long long>(hash),
+                                 static_cast<unsigned long long>(s.runs), static_cast<unsigned long long>(s.cycles), entries.c_str());
+                }
+        }
+    };
+}
