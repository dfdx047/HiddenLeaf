diff --git a/ps2xRuntime/include/runtime/hl_perf.h b/ps2xRuntime/include/runtime/hl_perf.h
new file mode 100644
index 0000000..3a3c6f4
--- /dev/null
+++ b/ps2xRuntime/include/runtime/hl_perf.h
@@ -0,0 +1,44 @@
+#pragma once
+// Hidden Leaf: HL_PERF=1: where the time of a frame goes (src/lib/hl_perf.cpp). The game thread is always in exactly one
+// category, so they add up to the frame. The GS is another thread: its CPU time, read from the kernel.
+#include <cstdint>
+
+namespace hl_perf
+{
+    enum Cat : int
+    {
+        kEe,      // the recompiled game code (and the runtime's stubs)
+        kVu0,     // VU0 microprograms (VCALLMS)
+        kVu1,     // VU1 microprograms
+        kIop,     // the IOP: sound driver, disc
+        kGifParse,// the runtime's own parse of the GS stream, for its registers
+        kRing,    // writing the stream for PCSX2's GS
+        kWaitGs,  // the game waiting for PCSX2's GS, which is behind
+        kIdle,    // waiting for the next vsync or event: spare time
+        kCount
+    };
+
+    extern bool g_on;
+    Cat switchTo(Cat next);
+
+    struct Scope
+    {
+        Cat prev = kEe;
+        explicit Scope(Cat c)
+        {
+            if (g_on)
+                prev = switchTo(c);
+        }
+        ~Scope()
+        {
+            if (g_on)
+                switchTo(prev);
+        }
+    };
+
+    void startOnGameThread();             // the thread measured; reads HL_PERF
+    void backToEe();                      // at the dispatcher: a thread switch leaves no scope to close
+    void onVsync(uint32_t tick);          // once per guest vsync
+    void addStreamBytes(uint64_t bytes);  // the frame's GS stream
+    const char *line();                   // the last second, for the overlay; empty when off
+}
