+            // Games that stub malloc to the runtime heap and take all of it at boot (UN5) leave nothing here; without a
+            // fallback every stream callback was dropped and the movie waited forever for its audio. The fallback is
+            // a ring outside the game's memory (the async callback area); a slot lives until 256 callbacks later.
+            uint32_t cbDataAddr = runtime->guestMalloc(kMpegCallbackDataSize, 16u);
+            const bool fromHeap = cbDataAddr != 0u;
+            if (!fromHeap)
             {
-                return;
+                constexpr uint32_t kRingSlots = 256u;
+                static uint32_t s_ringBase = 0u;
+                static uint32_t s_ringNext = 0u;
+                if (s_ringBase == 0u)
+                {
+                    const uint32_t top = runtime->reserveAsyncCallbackStack(kRingSlots * kMpegCallbackDataSize, 16u);
+                    s_ringBase = top != 0u ? top - kRingSlots * kMpegCallbackDataSize : 0u;
+                }
+                if (s_ringBase == 0u)
+                {
+                    return;
+                }
+                cbDataAddr = s_ringBase + (s_ringNext++ % kRingSlots) * kMpegCallbackDataSize;
             }
             if (!writeMpegCallbackData(rdram, cbDataAddr, event))
             {
-                runtime->guestFree(cbDataAddr);
+                if (fromHeap)
