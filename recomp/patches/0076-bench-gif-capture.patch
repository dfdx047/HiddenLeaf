+// Hidden Leaf bench (lab): hl_bench's HLB_GIFCAP writes the GIF packets of a few vsyncs in the HL_GSCAP format
+std::mutex g_hlGifCapMutex;
+std::FILE *g_hlGifCap = nullptr;
+void hlGifCapWrite(uint32_t path, const uint8_t *data, uint32_t size)
+{
+    std::lock_guard<std::mutex> lock(g_hlGifCapMutex);
+    if (g_hlGifCap == nullptr)
+        return;
+    const uint32_t h[2] = {path, size};
+    std::fwrite(h, 4, 2, g_hlGifCap);
+    std::fwrite(data, 1, size, g_hlGifCap);
+}
 
