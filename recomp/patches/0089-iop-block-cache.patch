+        case 0x0B: alu(&sltiu, rt); op.imm = simm; break;
+        case 0x0C: alu(&andi, rt); op.imm = imm; break;
+        case 0x0D: alu(&ori, rt); op.imm = imm; break;
+        case 0x0E: alu(&xori, rt); op.imm = imm; break;
+        case 0x0F: alu(&lui, rt); op.imm = imm << 16u; break;
+        case 0x20: d.fn = &lb; break;
+        case 0x24: d.fn = &lbu; break;
+        case 0x21: d.fn = &lh; break;
+        case 0x25: d.fn = &lhu; break;
+        case 0x22: d.fn = &lwl; break;
+        case 0x23: d.fn = &lw; break;
+        case 0x26: d.fn = &lwr; break;
+        case 0x28: d.fn = &sb; break;
+        case 0x29: d.fn = &sh; break;
