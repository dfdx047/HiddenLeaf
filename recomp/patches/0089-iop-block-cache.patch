+    // Runs a block from its first instruction, at most limit instructions. Returns how many it ran (0: none; the
+    // interpreter runs the first) and leaves cpu exactly as the interpreter would after them.
+    inline uint32_t iopRunBlock(const IopBlock &b, IopCpuState &cpu, IopMemory &mem, uint32_t limit)
+    {
+        IopBlockCtx c;
+        c.gpr = cpu.gpr.data();
+        c.cpu = &cpu;
+        c.mem = &mem;
+        c.ram = mem.ramData();
+        c.curLoad = 0;
+        c.newLoad = 0;
+        c.branchTaken = 0;
+        c.branchTarget = 0;
+        const IopOp *ops = b.ops.data();
+        const uint32_t n = b.count;
+        const uint32_t stop = limit < n ? limit : n; // (limit: an event of the IOP's falls inside; stop before it)
+        uint32_t i = 0;
+        // a load still pending from before the block (the last op of the block before): applied after op 0, as the
+        // interpreter does, unless op 0 writes that register itself
+        if (cpu.pendingLoad && stop != 0u)
+        {
+            const IopOp &op = ops[0];
+            if (!op.fn(c, op))
+                return 0u;
+            if (cpu.pendingLoadReg != op.written)
+                c.gpr[cpu.pendingLoadReg] = cpu.pendingLoadValue;
+            c.curLoad = c.newLoad;
+            i = 1u;
+        }
+        for (; i < stop; ++i)
+        {
+            const IopOp &op = ops[i];
+            if (!op.fn(c, op))
+                break;
+            if (op.applyReg)
+                c.gpr[op.applyReg] = c.curLoad;
+            c.curLoad = c.newLoad;
+        }
+        cpu.exception = false;
+        cpu.yielded = false;
+        if (i == n)
+        {
+            cpu.pendingLoad = b.lastLoadReg != 0u;
+            cpu.pendingLoadReg = b.lastLoadReg;
+            if (cpu.pendingLoad)
+                cpu.pendingLoadValue = c.curLoad;
+            cpu.branchPending = false;
+            cpu.pc = (b.branchAt != ~0u && c.branchTaken) ? c.branchTarget : b.start + n * 4u;
+            return n;
+        }
+        // stopped before op i: the state after op i-1 (its load still pending; inside a taken delay slot, the branch
+        // pending)
+        if (i == 0u)
+            return 0u;
+        const uint8_t pendingReg = ops[i].prevLoad;
+        cpu.pendingLoad = pendingReg != 0u;
+        cpu.pendingLoadReg = pendingReg;
+        if (cpu.pendingLoad)
+            cpu.pendingLoadValue = c.curLoad;
+        cpu.pc = b.start + i * 4u;
+        cpu.branchPending = false;
+        if (b.branchAt != ~0u && i == b.branchAt + 1u && c.branchTaken)
+        {
+            cpu.branchPending = true;
+            cpu.branchTarget = c.branchTarget;
+        }
+        return i;
+    }
+}
