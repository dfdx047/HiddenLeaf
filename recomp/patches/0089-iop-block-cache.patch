diff --git a/ps2xIOP/src/emulator/core/iop_blocks.h b/ps2xIOP/src/emulator/core/iop_blocks.h
new file mode 100644
index 0000000..d8e2f8c
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_blocks.h
@@ -0,0 +1,546 @@
+#pragma once
+// Hidden Leaf: the IOP's block cache. The IOP interpreter decodes and checks every instruction on its own
+// (IopEmulator::Impl::step: the interrupt test, the import test, the fetch, the decode, the load delay, the DMA start);
+// on the devices the sound modules (CRI's ADX driver, modhsyn, libsd) took ~25% of the EE thread through it. Here a run
+// of plain instructions (ALU, RAM loads and stores, one branch with its delay slot) is decoded once and run with the
+// interpreter's exact results: the same registers, the load delay slot, HI/LO, the branch delay slot. What the block does
+// not do it leaves to the interpreter, which then runs from that very instruction with the very same state: a trap (ADD,
+// ADDI, SUB overflow; a misaligned address), a load or store outside RAM (hardware, SPU2: they depend on the IOP's
+// clock), COP0, SYSCALL, BREAK, an import stub. The caller (step) runs a block only when no interrupt, DMA end, guest
+// callback or the end of the time slice falls inside it, so the IOP's state at every slice end is the interpreter's,
+// bit for bit (HL_IOP_HASH checks it). HL_IOP_BLOCKS=0 turns the cache off.
+#include "iop_cpu.h"
+#include "iop_memory.h"
+
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    struct IopBlockCtx
+    {
+        uint32_t *gpr;
+        IopCpuState *cpu;
+        IopMemory *mem;
+        uint8_t *ram;
+        uint32_t curLoad;
+        uint32_t newLoad;
+        uint32_t branchTaken;
+        uint32_t branchTarget;
+    };
+
+    struct IopOp;
+    using IopOpFn = bool (*)(IopBlockCtx &, const IopOp &); // false: stop before this op (the interpreter does it)
+
+    struct IopOp
+    {
+        IopOpFn fn;
+        uint32_t imm; // the sign- or zero-extended immediate, the jump target, or the return address
+        uint32_t pc;
+        uint8_t rs, rt, rd, sa;
+        uint8_t applyReg; // the register of the previous op's load, written after this op (0: none)
+        uint8_t prevLoad; // the previous op's load register, still pending when this op starts (0: none)
+        uint8_t written;  // the register the interpreter's write() sets (0: none): for a load pending on entry
+    };
+
+    struct IopBlock
+    {
+        uint32_t start = 0;      // its first instruction (as the PC had it)
+        uint32_t phys = 0;
+        uint32_t count = 0;      // 0: nothing to run from here (the interpreter)
+        uint32_t branchAt = ~0u; // the index of its branch (its delay slot is the last op)
+        uint32_t genFirst = 0, genLast = 0;
+        uint8_t lastLoadReg = 0; // the register the last op loads (its load is still pending at the end)
+        std::vector<IopOp> ops;
+    };
+
+    namespace iopops
+    {
+        using C = IopBlockCtx;
+        using O = IopOp;
+        inline bool nop(C &, const O &) { return true; }
+        inline bool sll(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rt] << o.sa; return true; }
+        inline bool srl(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rt] >> o.sa; return true; }
+        inline bool sra(C &c, const O &o) { c.gpr[o.rd] = static_cast<uint32_t>(static_cast<int32_t>(c.gpr[o.rt]) >> o.sa); return true; }
+        inline bool sllv(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rt] << (c.gpr[o.rs] & 31u); return true; }
+        inline bool srlv(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rt] >> (c.gpr[o.rs] & 31u); return true; }
+        inline bool srav(C &c, const O &o) { c.gpr[o.rd] = static_cast<uint32_t>(static_cast<int32_t>(c.gpr[o.rt]) >> (c.gpr[o.rs] & 31u)); return true; }
+        inline bool mfhi(C &c, const O &o) { c.gpr[o.rd] = c.cpu->hi; return true; }
+        inline bool mflo(C &c, const O &o) { c.gpr[o.rd] = c.cpu->lo; return true; }
+        inline bool mthi(C &c, const O &o) { c.cpu->hi = c.gpr[o.rs]; return true; }
+        inline bool mtlo(C &c, const O &o) { c.cpu->lo = c.gpr[o.rs]; return true; }
+        inline bool mult(C &c, const O &o)
+        {
+            const int64_t r = static_cast<int64_t>(static_cast<int32_t>(c.gpr[o.rs])) * static_cast<int64_t>(static_cast<int32_t>(c.gpr[o.rt]));
+            c.cpu->lo = static_cast<uint32_t>(r);
+            c.cpu->hi = static_cast<uint32_t>(static_cast<uint64_t>(r) >> 32u);
+            return true;
+        }
+        inline bool multu(C &c, const O &o)
+        {
+            const uint64_t r = static_cast<uint64_t>(c.gpr[o.rs]) * c.gpr[o.rt];
+            c.cpu->lo = static_cast<uint32_t>(r);
+            c.cpu->hi = static_cast<uint32_t>(r >> 32u);
+            return true;
+        }
+        inline bool div(C &c, const O &o)
+        {
+            const int32_t l = static_cast<int32_t>(c.gpr[o.rs]), r = static_cast<int32_t>(c.gpr[o.rt]);
+            if (r == 0)
+            {
+                c.cpu->lo = l >= 0 ? 0xFFFFFFFFu : 1u;
+                c.cpu->hi = static_cast<uint32_t>(l);
+            }
+            else if (l == std::numeric_limits<int32_t>::min() && r == -1)
+            {
+                c.cpu->lo = static_cast<uint32_t>(l);
+                c.cpu->hi = 0u;
+            }
+            else
+            {
+                c.cpu->lo = static_cast<uint32_t>(l / r);
+                c.cpu->hi = static_cast<uint32_t>(l % r);
+            }
+            return true;
+        }
+        inline bool divu(C &c, const O &o)
+        {
+            const uint32_t l = c.gpr[o.rs], r = c.gpr[o.rt];
+            if (r == 0u)
+            {
+                c.cpu->lo = 0xFFFFFFFFu;
+                c.cpu->hi = l;
+            }
+            else
+            {
+                c.cpu->lo = l / r;
+                c.cpu->hi = l % r;
+            }
+            return true;
+        }
+        inline bool add(C &c, const O &o)
+        {
+            const int64_t r = static_cast<int64_t>(static_cast<int32_t>(c.gpr[o.rs])) + static_cast<int32_t>(c.gpr[o.rt]);
+            if (r > std::numeric_limits<int32_t>::max() || r < std::numeric_limits<int32_t>::min())
+                return false;
+            if (o.rd)
+                c.gpr[o.rd] = static_cast<uint32_t>(static_cast<int32_t>(r));
+            return true;
+        }
+        inline bool sub(C &c, const O &o)
+        {
+            const int64_t r = static_cast<int64_t>(static_cast<int32_t>(c.gpr[o.rs])) - static_cast<int32_t>(c.gpr[o.rt]);
+            if (r > std::numeric_limits<int32_t>::max() || r < std::numeric_limits<int32_t>::min())
+                return false;
+            if (o.rd)
+                c.gpr[o.rd] = static_cast<uint32_t>(static_cast<int32_t>(r));
+            return true;
+        }
+        inline bool addi(C &c, const O &o)
+        {
+            const int64_t r = static_cast<int64_t>(static_cast<int32_t>(c.gpr[o.rs])) + static_cast<int32_t>(o.imm);
+            if (r > std::numeric_limits<int32_t>::max() || r < std::numeric_limits<int32_t>::min())
+                return false;
+            if (o.rt)
+                c.gpr[o.rt] = static_cast<uint32_t>(static_cast<int32_t>(r));
+            return true;
+        }
+        inline bool addu(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rs] + c.gpr[o.rt]; return true; }
+        inline bool subu(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rs] - c.gpr[o.rt]; return true; }
+        inline bool and_(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rs] & c.gpr[o.rt]; return true; }
+        inline bool or_(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rs] | c.gpr[o.rt]; return true; }
+        inline bool xor_(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rs] ^ c.gpr[o.rt]; return true; }
+        inline bool nor(C &c, const O &o) { c.gpr[o.rd] = ~(c.gpr[o.rs] | c.gpr[o.rt]); return true; }
+        inline bool slt(C &c, const O &o) { c.gpr[o.rd] = static_cast<int32_t>(c.gpr[o.rs]) < static_cast<int32_t>(c.gpr[o.rt]) ? 1u : 0u; return true; }
+        inline bool sltu(C &c, const O &o) { c.gpr[o.rd] = c.gpr[o.rs] < c.gpr[o.rt] ? 1u : 0u; return true; }
+        inline bool addiu(C &c, const O &o) { c.gpr[o.rt] = c.gpr[o.rs] + o.imm; return true; }
+        inline bool slti(C &c, const O &o) { c.gpr[o.rt] = static_cast<int32_t>(c.gpr[o.rs]) < static_cast<int32_t>(o.imm) ? 1u : 0u; return true; }
+        inline bool sltiu(C &c, const O &o) { c.gpr[o.rt] = c.gpr[o.rs] < o.imm ? 1u : 0u; return true; }
+        inline bool andi(C &c, const O &o) { c.gpr[o.rt] = c.gpr[o.rs] & o.imm; return true; }
+        inline bool ori(C &c, const O &o) { c.gpr[o.rt] = c.gpr[o.rs] | o.imm; return true; }
+        inline bool xori(C &c, const O &o) { c.gpr[o.rt] = c.gpr[o.rs] ^ o.imm; return true; }
+        inline bool lui(C &c, const O &o) { c.gpr[o.rt] = o.imm; return true; }
+
+        // branches: the condition and the target (the delay slot runs next; the block ends after it)
+        inline bool beq(C &c, const O &o) { c.branchTaken = c.gpr[o.rs] == c.gpr[o.rt]; c.branchTarget = o.imm; return true; }
+        inline bool bne(C &c, const O &o) { c.branchTaken = c.gpr[o.rs] != c.gpr[o.rt]; c.branchTarget = o.imm; return true; }
+        inline bool blez(C &c, const O &o) { c.branchTaken = static_cast<int32_t>(c.gpr[o.rs]) <= 0; c.branchTarget = o.imm; return true; }
+        inline bool bgtz(C &c, const O &o) { c.branchTaken = static_cast<int32_t>(c.gpr[o.rs]) > 0; c.branchTarget = o.imm; return true; }
+        inline bool bltz(C &c, const O &o) { c.branchTaken = static_cast<int32_t>(c.gpr[o.rs]) < 0; c.branchTarget = o.imm; return true; }
+        inline bool bgez(C &c, const O &o) { c.branchTaken = static_cast<int32_t>(c.gpr[o.rs]) >= 0; c.branchTarget = o.imm; return true; }
+        inline bool bltzal(C &c, const O &o)
+        {
+            c.branchTaken = static_cast<int32_t>(c.gpr[o.rs]) < 0; // (the interpreter tests before it writes RA)
+            c.branchTarget = o.imm;
+            c.gpr[31] = o.pc + 8u;
+            return true;
+        }
+        inline bool bgezal(C &c, const O &o)
+        {
+            c.branchTaken = static_cast<int32_t>(c.gpr[o.rs]) >= 0;
+            c.branchTarget = o.imm;
+            c.gpr[31] = o.pc + 8u;
+            return true;
+        }
+        inline bool j(C &c, const O &o) { c.branchTaken = 1u; c.branchTarget = o.imm; return true; }
+        inline bool jal(C &c, const O &o) { c.branchTaken = 1u; c.branchTarget = o.imm; c.gpr[31] = o.pc + 8u; return true; }
+        inline bool jr(C &c, const O &o) { c.branchTaken = 1u; c.branchTarget = c.gpr[o.rs]; return true; }
+        inline bool jalr(C &c, const O &o)
+        {
+            c.branchTaken = 1u;
+            c.branchTarget = c.gpr[o.rs]; // (read before the write: JALR rs, rs)
+            c.gpr[o.rd] = o.pc + 8u;
+            return true;
+        }
+
+        // loads and stores: RAM only (the rest depends on the IOP's clock: the interpreter does it)
+        inline bool ramAt(uint32_t address, uint32_t size, uint32_t &phys)
+        {
+            phys = IopMemory::physicalAddress(address);
+            return phys <= IopMemory::RamSize - size;
+        }
+        inline bool lb(C &c, const O &o)
+        {
+            uint32_t p;
+            if (!ramAt(c.gpr[o.rs] + o.imm, 1u, p))
+                return false;
+            c.newLoad = static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(c.ram[p])));
+            return true;
+        }
+        inline bool lbu(C &c, const O &o)
+        {
+            uint32_t p;
+            if (!ramAt(c.gpr[o.rs] + o.imm, 1u, p))
+                return false;
+            c.newLoad = c.ram[p];
+            return true;
+        }
+        inline bool lh(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if ((a & 1u) || !ramAt(a, 2u, p))
+                return false;
+            int16_t v;
+            std::memcpy(&v, c.ram + p, 2);
+            c.newLoad = static_cast<uint32_t>(static_cast<int32_t>(v));
+            return true;
+        }
+        inline bool lhu(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if ((a & 1u) || !ramAt(a, 2u, p))
+                return false;
+            uint16_t v;
+            std::memcpy(&v, c.ram + p, 2);
+            c.newLoad = v;
+            return true;
+        }
+        inline bool lw(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if ((a & 3u) || !ramAt(a, 4u, p))
+                return false;
+            std::memcpy(&c.newLoad, c.ram + p, 4);
+            return true;
+        }
+        inline bool lwl(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if (!ramAt(a & ~3u, 4u, p))
+                return false;
+            uint32_t m;
+            std::memcpy(&m, c.ram + p, 4);
+            static constexpr uint32_t masks[4] = {0x00FFFFFFu, 0x0000FFFFu, 0x000000FFu, 0x00000000u};
+            static constexpr uint32_t shifts[4] = {24u, 16u, 8u, 0u};
+            c.newLoad = (c.gpr[o.rt] & masks[a & 3u]) | (m << shifts[a & 3u]);
+            return true;
+        }
+        inline bool lwr(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if (!ramAt(a & ~3u, 4u, p))
+                return false;
+            uint32_t m;
+            std::memcpy(&m, c.ram + p, 4);
+            static constexpr uint32_t masks[4] = {0x00000000u, 0xFF000000u, 0xFFFF0000u, 0xFFFFFF00u};
+            static constexpr uint32_t shifts[4] = {0u, 8u, 16u, 24u};
+            c.newLoad = (c.gpr[o.rt] & masks[a & 3u]) | (m >> shifts[a & 3u]);
+            return true;
+        }
+        inline bool sb(C &c, const O &o)
+        {
+            uint32_t p;
+            if (!ramAt(c.gpr[o.rs] + o.imm, 1u, p))
+                return false;
+            c.mem->write8(p, static_cast<uint8_t>(c.gpr[o.rt]));
+            return true;
+        }
+        inline bool sh(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if ((a & 1u) || !ramAt(a, 2u, p))
+                return false;
+            c.mem->write16(p, static_cast<uint16_t>(c.gpr[o.rt]));
+            return true;
+        }
+        inline bool sw(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if ((a & 3u) || !ramAt(a, 4u, p))
+                return false;
+            c.mem->write32(p, c.gpr[o.rt]);
+            return true;
+        }
+        inline bool swl(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if (!ramAt(a & ~3u, 4u, p))
+                return false;
+            uint32_t old;
+            std::memcpy(&old, c.ram + p, 4);
+            const uint32_t v = c.gpr[o.rt];
+            uint32_t r = old;
+            switch (a & 3u)
+            {
+            case 0u: r = (old & 0xFFFFFF00u) | (v >> 24u); break;
+            case 1u: r = (old & 0xFFFF0000u) | (v >> 16u); break;
+            case 2u: r = (old & 0xFF000000u) | (v >> 8u); break;
+            case 3u: r = v; break;
+            }
+            c.mem->write32(p, r);
+            return true;
+        }
+        inline bool swr(C &c, const O &o)
+        {
+            const uint32_t a = c.gpr[o.rs] + o.imm;
+            uint32_t p;
+            if (!ramAt(a & ~3u, 4u, p))
+                return false;
+            uint32_t old;
+            std::memcpy(&old, c.ram + p, 4);
+            const uint32_t v = c.gpr[o.rt];
+            uint32_t r = old;
+            switch (a & 3u)
+            {
+            case 0u: r = v; break;
+            case 1u: r = (old & 0x000000FFu) | (v << 8u); break;
+            case 2u: r = (old & 0x0000FFFFu) | (v << 16u); break;
+            case 3u: r = (old & 0x00FFFFFFu) | (v << 24u); break;
+            }
+            c.mem->write32(p, r);
+            return true;
+        }
+    }
+
+    // One decoded instruction: its handler, what it writes (for the load delay rule), whether it is a load, a branch.
+    struct IopDecoded
+    {
+        IopOpFn fn = nullptr; // nullptr: not for a block
+        uint8_t written = 0;  // the register the interpreter's write() sets (0: none)
+        uint8_t loadReg = 0;  // a load: the register it schedules (0: none)
+        bool branch = false;
+        bool registerTarget = false; // JR/JALR (the target comes from the register)
+        uint32_t target = 0;  // the target of a PC-relative or J/JAL branch
+    };
+
+    inline IopDecoded iopDecode(uint32_t pc, uint32_t in, IopOp &op)
+    {
+        using namespace iopops;
+        IopDecoded d;
+        const uint32_t opcode = in >> 26u, rs = (in >> 21u) & 31u, rt = (in >> 16u) & 31u, rd = (in >> 11u) & 31u;
+        const uint32_t sa = (in >> 6u) & 31u, funct = in & 63u, imm = in & 0xFFFFu;
+        const uint32_t simm = static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(imm)));
+        op.rs = static_cast<uint8_t>(rs);
+        op.rt = static_cast<uint8_t>(rt);
+        op.rd = static_cast<uint8_t>(rd);
+        op.sa = static_cast<uint8_t>(sa);
+        op.pc = pc;
+        op.imm = 0;
+        auto alu = [&](IopOpFn fn, uint32_t dest)
+        {
+            d.fn = dest ? fn : &nop; // (the interpreter's write() leaves R0 alone)
+            d.written = static_cast<uint8_t>(dest);
+        };
+        auto branch = [&](IopOpFn fn)
+        {
+            d.fn = fn;
+            d.branch = true;
+            d.target = pc + 4u + (simm << 2u);
+        };
+        switch (opcode)
+        {
+        case 0x00:
+            switch (funct)
+            {
+            case 0x00: alu(&sll, rd); break;
+            case 0x02: alu(&srl, rd); break;
+            case 0x03: alu(&sra, rd); break;
+            case 0x04: alu(&sllv, rd); break;
+            case 0x06: alu(&srlv, rd); break;
+            case 0x07: alu(&srav, rd); break;
+            case 0x08: d.fn = &jr; d.branch = true; d.registerTarget = true; break;
+            case 0x09:
+                if (rd == 0u)
+                    op.rd = 31u;
+                d.fn = &jalr;
+                d.branch = true;
+                d.registerTarget = true;
+                d.written = op.rd;
+                break;
+            case 0x10: alu(&mfhi, rd); break;
+            case 0x11: d.fn = &mthi; break;
+            case 0x12: alu(&mflo, rd); break;
+            case 0x13: d.fn = &mtlo; break;
+            case 0x18: d.fn = &mult; break;
+            case 0x19: d.fn = &multu; break;
+            case 0x1A: d.fn = &div; break;
+            case 0x1B: d.fn = &divu; break;
+            case 0x20: d.fn = &add; d.written = static_cast<uint8_t>(rd); break;
+            case 0x21: alu(&addu, rd); break;
+            case 0x22: d.fn = &sub; d.written = static_cast<uint8_t>(rd); break;
+            case 0x23: alu(&subu, rd); break;
+            case 0x24: alu(&and_, rd); break;
+            case 0x25: alu(&or_, rd); break;
+            case 0x26: alu(&xor_, rd); break;
+            case 0x27: alu(&nor, rd); break;
+            case 0x2A: alu(&slt, rd); break;
+            case 0x2B: alu(&sltu, rd); break;
+            default: break; // SYSCALL, BREAK and the rest: the interpreter
+            }
+            break;
+        case 0x01:
+            switch (rt)
+            {
+            case 0x00: branch(&bltz); break;
+            case 0x01: branch(&bgez); break;
+            case 0x10: branch(&bltzal); d.written = 31u; break;
+            case 0x11: branch(&bgezal); d.written = 31u; break;
+            default: break;
+            }
+            break;
+        case 0x02:
+        case 0x03:
+            d.fn = opcode == 0x02 ? &j : &jal;
+            d.branch = true;
+            d.target = ((pc + 4u) & 0xF0000000u) | ((in & 0x03FFFFFFu) << 2u);
+            if (opcode == 0x03)
+                d.written = 31u;
+            break;
+        case 0x04: branch(&beq); break;
+        case 0x05: branch(&bne); break;
