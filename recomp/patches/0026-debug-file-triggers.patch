+        // Hidden Leaf: a file named hl_pad in the working directory ("UP UP CROSS") is read and removed; each button is
+        // then held for 6 vsyncs and released for 6, so menus can be driven while the game runs
+        void applyPadFile(PadInputState &state, PS2Runtime *runtime)
         {
+            static std::deque<uint16_t> queue;
+            static uint64_t phaseStart = 0u;
+            static bool holding = false;
+            if (runtime == nullptr)
+            {
+                return;
+            }
+            const uint64_t tick = runtime->eeScheduler().currentVSyncTick();
+            static uint64_t lastCheck = ~0ull;
+            if (tick != lastCheck)
+            {
+                lastCheck = tick;
+                std::ifstream file("hl_pad");
+                if (file)
+                {
+                    std::string word;
+                    while (file >> word)
+                    {
+                        static const std::unordered_map<std::string, uint16_t> names = {
+                            {"SELECT", kPadBtnSelect}, {"START", kPadBtnStart}, {"UP", kPadBtnUp},
+                            {"RIGHT", kPadBtnRight}, {"DOWN", kPadBtnDown}, {"LEFT", kPadBtnLeft}, {"L2", kPadBtnL2},
+                            {"R2", kPadBtnR2}, {"L1", kPadBtnL1}, {"R1", kPadBtnR1}, {"TRIANGLE", kPadBtnTriangle},
+                            {"CIRCLE", kPadBtnCircle}, {"CROSS", kPadBtnCross}, {"SQUARE", kPadBtnSquare},
+                            {"WAIT", 0u}};
+                        const auto it = names.find(word);
+                        if (it != names.end())
+                        {
+                            queue.push_back(it->second);
+                        }
+                    }
+                    file.close();
+                    std::remove("hl_pad");
+                    std::cerr << "[hl_pad] tick " << tick << ": " << queue.size() << " queued" << std::endl;
+                }
+            }
+            if (queue.empty())
+            {
+                return;
+            }
+            if (phaseStart == 0u)
+            {
+                phaseStart = tick;
+                holding = true;
+            }
+            if (holding && tick - phaseStart >= 6u)
+            {
+                holding = false;
+                phaseStart = tick;
+            }
+            else if (!holding && tick - phaseStart >= 6u)
+            {
+                queue.pop_front();
+                phaseStart = queue.empty() ? 0u : tick;
+                holding = true;
+                if (queue.empty())
+                {
+                    return;
+                }
+            }
+            if (holding && queue.front() != 0u)
+            {
+                setButton(state, queue.front(), true);
+            }
+        }
+
