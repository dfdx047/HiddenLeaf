+void EeScheduler::skipIdleCycles()
+{
+    // in steps, so an event raised meanwhile (the IOP runs inside accountCycles, EE timers) stops the skip
+    constexpr uint64_t kStep = 8192u;
+    uint64_t target = m_nextDeadlineCycle.load(std::memory_order_acquire);
+    const uint64_t timerCycles = m_runtime.memory().cyclesUntilNextEeTimerInterrupt();
+    if (timerCycles != std::numeric_limits<uint64_t>::max() && (target == 0u || m_eeCycle + timerCycles < target))
+    {
+        target = m_eeCycle + timerCycles;
+    }
+    while (target > m_eeCycle && !m_checkpointPending.load(std::memory_order_acquire) &&
+           !m_stopRequested.load(std::memory_order_acquire))
+    {
+        accountCycles(static_cast<uint32_t>(std::min<uint64_t>(target - m_eeCycle, kStep)));
+    }
+}
