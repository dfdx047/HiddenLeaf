+    int acquireModFd(ModFile &m)
+    {
+        if (m.fd >= 0)
+        {
+            m.lastUse = ++s_modFdTick;
+            return m.fd;
+        }
+        if (s_modOpenCount >= kMaxModFds)
+        {
+            ModFile *oldest = nullptr;
+            for (ModFile &other : s_mods)
+            {
+                if (other.fd >= 0 && (oldest == nullptr || other.lastUse < oldest->lastUse))
+                    oldest = &other;
+            }
+            if (oldest != nullptr)
+            {
+                ::close(oldest->fd);
+                oldest->fd = -1;
+                --s_modOpenCount;
+            }
+        }
+        m.fd = ::open(m.host.c_str(), O_RDONLY | O_CLOEXEC);
+        if (m.fd >= 0)
+        {
+            m.lastUse = ++s_modFdTick;
+            ++s_modOpenCount;
+        }
+        return m.fd;
+    }
