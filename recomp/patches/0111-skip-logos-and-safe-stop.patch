+    // Hidden Leaf: the last top-level dispatches (pc, ra, sp) of each thread, for HL_EE_DUMP
+    struct HlDispatchRing
+    {
+        std::array<std::array<uint32_t, 3>, 64> pcs{};
+        uint32_t next = 0u;
+    };
+
+    std::unordered_map<int, HlDispatchRing> &hlDispatchRing()
+    {
+        static std::unordered_map<int, HlDispatchRing> rings;
+        return rings;
+    }
+
+    // Hidden Leaf (patch 0063): per thread, the last scheduler events and the base context (the thread's own, under any
+    // invocation) at each: 'P' an invocation pushed (kind), 'O' one finished (after its onComplete), 'R' the thread made
+    // running. Printed with the dispatches when a thread jumps into nothing.
+    struct HlEventRing
+    {
+        std::array<std::array<uint32_t, 5>, 32> ev{};
+        uint32_t next = 0u;
+    };
+
+    std::unordered_map<int, HlEventRing> &hlEventRing()
+    {
+        static std::unordered_map<int, HlEventRing> rings;
+        return rings;
+    }
+
+    void hlEvent(const GuestThread &t, char tag, uint32_t kind)
+    {
+        auto &r = hlEventRing()[t.id];
+        r.ev[r.next] = {static_cast<uint32_t>(tag) | (kind << 8u), t.context.pc, getRegU32(&t.context, 31), getRegU32(&t.context, 29),
+                        static_cast<uint32_t>(t.invocations.size())};
+        r.next = (r.next + 1u) % 32u;
+        // (and in the dispatch ring, in order with the dispatches: 0xEE00<tag><kind>(ra <base pc> sp <base sp>))
+        auto &d = hlDispatchRing()[t.id];
+        d.pcs[d.next] = {0xEE000000u | (static_cast<uint32_t>(tag) << 8u) | (kind & 0xFFu), t.context.pc, getRegU32(&t.context, 29)};
+        d.next = (d.next + 1u) % 64u;
+    }
