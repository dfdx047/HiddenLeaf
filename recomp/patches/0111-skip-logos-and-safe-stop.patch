+// Hidden Leaf: back to the dispatcher. Guest threads switch thousands of times a frame in places, and a C++ throw costs
+// milliseconds on Android (the unwinder walks every loaded library for every frame on the way, in dl_iterate_phdr, twice).
+// What lies between here and run() is generated code and syscall stubs with nothing to destroy; the one caller with
+// something to destroy (invokeCurrentSequence) still throws.
+[[noreturn]] void EeScheduler::jumpToDispatcher()
+{
+    if (m_transferJump)
+        _longjmp(*static_cast<jmp_buf *>(m_transferJump), 1);
+    throw EeDispatcherTransfer{};
+}
