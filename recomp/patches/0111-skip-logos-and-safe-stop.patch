+template <typename F>
+__attribute__((noinline)) void EeScheduler::guarded(F &&body)
+{
+    jmp_buf here;
+    void *const outer = m_transferJump;
+    m_transferJump = &here;
+    if (_setjmp(here) == 0)
+        body();
+    m_transferJump = outer;
+    hl_perf::backToEe();
+}
