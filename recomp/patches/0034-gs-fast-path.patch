diff --git a/ps2xRuntime/src/lib/gs/gs_cpu_fast.inl b/ps2xRuntime/src/lib/gs/gs_cpu_fast.inl
new file mode 100644
index 0000000..f624567
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_cpu_fast.inl
@@ -0,0 +1,888 @@
+// Hidden Leaf: the fast path of the software GS. The same pipeline as WritePixel, SampleTexture, DrawTriangle and
+// DrawSprite, without a call and a table lookup per VRAM access: what depends only on the registers is decoded once per
+// primitive, the swizzle tables are read directly and the palette is decoded in advance. Included by gs_cpu_backend.cpp.
+//
+// What it does not cover goes to the old path, which stays as the reference: unknown formats and a texture read from
+// the pages being drawn to (there the texture page cache decides what is seen). HL_GS_VERIFY=N renders one primitive in
+// N with both paths and logs where they differ.
+
+namespace
+{
+    constexpr uint32_t kVramByteMask = static_cast<uint32_t>(GSMem::MEMORY_SIZE) - 1u;
+
+    struct FastSwizzle
+    {
+        const uint16_t *table = nullptr;
+        uint32_t xMask = 0u, yMask = 0u, xShift = 0u, yShift = 0u, basePage = 0u, pagesPerRow = 0u, pagePixels = 0u;
+
+        bool init(uint32_t psm, uint32_t block, uint32_t bw)
+        {
+            const GSMem::FastPageInfo info = GSMem::GetFastPageInfo(psm);
+            if (!info.table)
+                return false;
+            pagePixels = info.pageWidth * info.pageHeight;
+            table = info.table + (block % 32u) * pagePixels;
+            xMask = info.pageWidth - 1u;
+            yMask = info.pageHeight - 1u;
+            xShift = info.xShift;
+            yShift = info.yShift;
+            basePage = block / 32u;
+            pagesPerRow = (bw * 64u) / info.pageWidth;
+            return true;
+        }
+
+        inline uint32_t pixel(uint32_t x, uint32_t y) const
+        {
+            const uint32_t page = basePage + (y >> yShift) * pagesPerRow + (x >> xShift);
+            return page * pagePixels + table[((y & yMask) << xShift) + (x & xMask)];
+        }
+    };
+
+    inline uint32_t vramLoad32(const uint8_t *vram, uint32_t byte)
+    {
+        uint32_t v;
+        std::memcpy(&v, vram + (byte & (kVramByteMask & ~3u)), sizeof(v));
+        return v;
+    }
+
+    inline uint32_t vramLoad16(const uint8_t *vram, uint32_t byte)
+    {
+        uint16_t v;
+        std::memcpy(&v, vram + (byte & (kVramByteMask & ~1u)), sizeof(v));
+        return v;
+    }
+
+    inline void vramStore32(uint8_t *vram, uint32_t byte, uint32_t value)
+    {
+        std::memcpy(vram + (byte & (kVramByteMask & ~3u)), &value, sizeof(value));
+    }
+
+    inline void vramStore16(uint8_t *vram, uint32_t byte, uint32_t value)
+    {
+        const uint16_t v = static_cast<uint16_t>(value);
+        std::memcpy(vram + (byte & (kVramByteMask & ~1u)), &v, sizeof(v));
+    }
+
+    enum : uint8_t
+    {
+        kStore32 = 0u,
+        kStore24 = 1u,
+        kStore16 = 2u
+    };
+
+    struct FastPixel
+    {
+        uint8_t *vram = nullptr;
+        FastSwizzle fb, zb;
+        uint32_t fbmsk = 0u;
+        uint8_t fmt = 0u, zfmt = 0u;
+        bool fge = false, abe = false, pabe = false, ate = false, date = false, datm = false;
+        bool zte = false, zmask = false, fba = false, needZ = false;
+        uint8_t atst = 0u, aref = 0u, afail = 0u, ztst = 1u;
+        uint8_t asel = 0u, bsel = 0u, csel = 0u, dsel = 0u, fix = 0u;
+        uint8_t fogR = 0u, fogG = 0u, fogB = 0u;
+
+        bool init(const GSDrawState &state, uint8_t *mem)
+        {
+            const auto &ctx = state.context;
+            vram = mem;
+            const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+            switch (ctx.frame.psm)
+            {
+            case GS_PSM_CT32:
+                fmt = kStore32;
+                break;
+            case GS_PSM_CT24:
+                fmt = kStore24;
+                break;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+                fmt = kStore16;
+                break;
+            default:
+                return false;
+            }
+            if (!fb.init(ctx.frame.psm, GSInternal::framePageBaseToBlock(ctx.frame.fbp), fbw))
+                return false;
+
+            const uint64_t test = ctx.test;
+            zte = ((test >> 16) & 1u) != 0u;
+            ztst = zte ? static_cast<uint8_t>((test >> 17) & 3u) : 1u;
+            zmask = ctx.zbuf.zmask;
+            needZ = zte && (ztst >= 2u || !zmask);
+            if (needZ)
+            {
+                switch (ctx.zbuf.psm)
+                {
+                case GS_PSM_Z32:
+                    zfmt = kStore32;
+                    break;
+                case GS_PSM_Z24:
+                    zfmt = kStore24;
+                    break;
+                case GS_PSM_Z16:
+                case GS_PSM_Z16S:
+                    zfmt = kStore16;
+                    break;
+                default:
+                    return false;
+                }
+                if (!zb.init(ctx.zbuf.psm, GSInternal::framePageBaseToBlock(ctx.zbuf.zbp), fbw))
+                    return false;
+            }
+
+            ate = (test & 1u) != 0u;
+            atst = static_cast<uint8_t>((test >> 1) & 7u);
+            aref = static_cast<uint8_t>((test >> 4) & 0xFFu);
+            afail = static_cast<uint8_t>((test >> 12) & 3u);
+            date = ((test >> 14) & 1u) != 0u && fmt != kStore24;
+            datm = ((test >> 15) & 1u) != 0u;
+
+            fge = state.prim.fge;
+            fogR = state.fogR;
+            fogG = state.fogG;
+            fogB = state.fogB;
+            abe = state.prim.abe;
+            pabe = state.pabe;
+            asel = static_cast<uint8_t>(ctx.alpha & 3u);
+            bsel = static_cast<uint8_t>((ctx.alpha >> 2) & 3u);
+            csel = static_cast<uint8_t>((ctx.alpha >> 4) & 3u);
+            dsel = static_cast<uint8_t>((ctx.alpha >> 6) & 3u);
+            fix = static_cast<uint8_t>((ctx.alpha >> 32) & 0xFFu);
+            fba = (ctx.fba & 1ull) != 0ull && fmt != kStore24;
+            fbmsk = ctx.frame.fbmsk;
+            return true;
+        }
+
+        inline bool alphaPasses(uint8_t a) const
+        {
+            switch (atst)
+            {
+            case 0:
+                return false;
+            case 1:
+                return true;
+            case 2:
+                return a < aref;
+            case 3:
+                return a <= aref;
+            case 4:
+                return a == aref;
+            case 5:
+                return a >= aref;
+            case 6:
+                return a > aref;
+            default:
+                return a != aref;
+            }
+        }
+
+        inline uint32_t readZ(uint32_t pix) const
+        {
+            if (zfmt == kStore16)
+                return vramLoad16(vram, pix * 2u);
+            const uint32_t v = vramLoad32(vram, pix * 4u);
+            return zfmt == kStore24 ? (v & 0x00FFFFFFu) : v;
+        }
+
+        inline void writeZ(uint32_t pix, uint32_t z) const
+        {
+            if (zfmt == kStore32)
+                vramStore32(vram, pix * 4u, z);
+            else if (zfmt == kStore24)
+                vramStore32(vram, pix * 4u, (vramLoad32(vram, pix * 4u) & 0xFF000000u) | (z & 0x00FFFFFFu));
+            else
+                vramStore16(vram, pix * 2u, z);
+        }
+
+        __attribute__((always_inline)) inline void put(int x, int y, uint32_t z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog) const
+        {
+            if (fge)
+            {
+                const uint32_t inv = 255u - fog;
+                r = static_cast<uint8_t>(((fog * static_cast<uint32_t>(r)) >> 8) + ((inv * fogR) >> 8));
+                g = static_cast<uint8_t>(((fog * static_cast<uint32_t>(g)) >> 8) + ((inv * fogG) >> 8));
+                b = static_cast<uint8_t>(((fog * static_cast<uint32_t>(b)) >> 8) + ((inv * fogB) >> 8));
+            }
+
+            bool writeRgb = true, writeAlpha = true, writeDepth = true;
+            if (ate && !alphaPasses(a))
+            {
+                switch (afail)
+                {
+                case 0:
+                    return;
+                case 1:
+                    writeDepth = false;
+                    break;
+                case 2:
+                    writeRgb = writeAlpha = false;
+                    break;
+                default:
+                    writeDepth = false;
+                    writeAlpha = fmt != kStore32;
+                    break;
+                }
+            }
+
+            const bool preserveAlpha = writeRgb && !writeAlpha && fmt == kStore32;
+            const bool frmw = date || (writeRgb && (fbmsk != 0u || abe || preserveAlpha));
+
+            uint32_t fbPix = 0u, raw = 0u, fbrgba = 0u;
+            if (frmw || writeRgb)
+                fbPix = fb.pixel(static_cast<uint32_t>(x), static_cast<uint32_t>(y));
+            if (frmw)
+            {
+                if (fmt == kStore16)
+                {
+                    raw = vramLoad16(vram, fbPix * 2u);
+                    fbrgba = Rgba5551ToRgba8888(static_cast<uint16_t>(raw));
+                }
+                else
+                {
+                    raw = vramLoad32(vram, fbPix * 4u);
+                    fbrgba = fmt == kStore24 ? ((raw & 0x00FFFFFFu) | 0x80000000u) : raw;
+                }
+                if (date)
+                {
+                    const uint32_t bit = fmt == kStore16 ? (raw >> 15) & 1u : (raw >> 31) & 1u;
+                    if ((bit != 0u) != datm)
+                        return;
+                }
+            }
+
+            uint32_t zPix = 0u;
+            if (needZ)
+            {
+                zPix = zb.pixel(static_cast<uint32_t>(x), static_cast<uint32_t>(y));
+                if (ztst >= 2u)
+                {
+                    const uint32_t stored = readZ(zPix);
+                    if (ztst == 2u ? z < stored : z <= stored)
+                        return;
+                }
+            }
+            if (ztst == 0u)
+                return;
+
+            if (writeRgb)
+            {
+                if (abe && !(pabe && (a & 0x80u) == 0u))
+                {
+                    const int dr = static_cast<int>(fbrgba & 0xFFu);
+                    const int dg = static_cast<int>((fbrgba >> 8) & 0xFFu);
+                    const int db = static_cast<int>((fbrgba >> 16) & 0xFFu);
+                    const int da = static_cast<int>(fbrgba >> 24);
+                    const int c = csel == 0u ? a : (csel == 1u ? da : fix);
+                    const int rs[3] = {r, dr, 0}, gs[3] = {g, dg, 0}, bs[3] = {b, db, 0};
+                    const uint8_t ia = asel > 2u ? 2u : asel, ib = bsel > 2u ? 2u : bsel, id = dsel > 2u ? 2u : dsel;
+                    r = clampU8(((rs[ia] - rs[ib]) * c >> 7) + rs[id]);
+                    g = clampU8(((gs[ia] - gs[ib]) * c >> 7) + gs[id]);
+                    b = clampU8(((bs[ia] - bs[ib]) * c >> 7) + bs[id]);
+                }
+                if (writeAlpha && fba)
+                    a = static_cast<uint8_t>(a | 0x80u);
+
+                uint32_t pixel = pack32(r, g, b, a);
+                if (fbmsk != 0u)
+                    pixel = (pixel & ~fbmsk) | (fbrgba & fbmsk);
+                if (preserveAlpha)
+                    pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+
+                if (fmt == kStore32)
+                    vramStore32(vram, fbPix * 4u, pixel);
+                else if (fmt == kStore24)
+                    vramStore32(vram, fbPix * 4u, (vramLoad32(vram, fbPix * 4u) & 0xFF000000u) | (pixel & 0x00FFFFFFu));
+                else
+                    vramStore16(vram, fbPix * 2u, Rgba8888ToRgba5551(pixel));
+            }
+
+            if (writeDepth && zte && !zmask)
+                writeZ(zPix, z);
+        }
+    };
+
+    enum : uint8_t
+    {
+        kTexRaw32,
+        kTexC24,
+        kTexZ24,
+        kTexC16,
+        kTexZ16,
+        kTexT8,
+        kTexT8H,
+        kTexT4,
+        kTexT4HL,
+        kTexT4HH
+    };
+
+    // the four channels of a texel in the 16-bit lanes of a 64-bit word: r, b, g, a
+    inline uint64_t texelLanes(uint32_t c)
+    {
+        return (static_cast<uint64_t>(c) | (static_cast<uint64_t>(c) << 24)) & 0x00FF00FF00FF00FFull;
+    }
+
+    inline uint32_t lanesTexel(uint64_t lanes)
+    {
+        lanes &= 0x00FF00FF00FF00FFull;
+        return static_cast<uint32_t>(lanes | (lanes >> 24));
+    }
+
+    inline uint64_t lanesLerp(uint64_t a, uint64_t b, uint32_t f)
+    {
+        constexpr uint64_t kRound = 0x0080008000800080ull;
+        return ((a * (256u - f) + b * f + kRound) >> 8) & 0x00FF00FF00FF00FFull;
+    }
+
+    struct FastTexture
+    {
+        const uint8_t *vram = nullptr;
+        const uint32_t *palette = nullptr;
+        FastSwizzle sw;
+        GSTexaReg texa{};
+        uint8_t kind = 0u, wrapU = 0u, wrapV = 0u;
+        bool linear = false;
+        int w = 1, h = 1;
+        uint16_t minU = 0u, maxU = 0u, minV = 0u, maxV = 0u;
+
+        static int kindOf(uint8_t psm)
+        {
+            switch (psm)
+            {
+            case GS_PSM_CT32:
+            case GS_PSM_Z32:
+                return kTexRaw32;
+            case GS_PSM_CT24:
+                return kTexC24;
+            case GS_PSM_Z24:
+                return kTexZ24;
+            case GS_PSM_CT16:
+            case GS_PSM_CT16S:
+                return kTexC16;
+            case GS_PSM_Z16:
+            case GS_PSM_Z16S:
+                return kTexZ16;
+            case GS_PSM_T8:
+                return kTexT8;
+            case GS_PSM_T8H:
+                return kTexT8H;
+            case GS_PSM_T4:
+                return kTexT4;
+            case GS_PSM_T4HL:
+                return kTexT4HL;
+            case GS_PSM_T4HH:
+                return kTexT4HH;
+            default:
+                return -1;
+            }
+        }
+
+        bool init(const GSDrawState &state, const uint8_t *mem, const uint32_t *pal)
+        {
+            const auto &ctx = state.context;
+            const int k = kindOf(ctx.tex0.psm);
+            if (k < 0 || !sw.init(ctx.tex0.psm, ctx.tex0.tbp0, ctx.tex0.tbw))
+                return false;
+            kind = static_cast<uint8_t>(k);
+            vram = mem;
+            palette = pal;
+            texa = state.texa;
+            w = state.textureWidth;
+            h = state.textureHeight;
+            linear = state.linearFilter;
+            const uint64_t clamp = ctx.clamp;
+            wrapU = static_cast<uint8_t>(clamp & 3u);
+            wrapV = static_cast<uint8_t>((clamp >> 2) & 3u);
+            minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+            maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+            minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+            maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+            return true;
+        }
+
+        __attribute__((always_inline)) inline uint32_t texel(int u, int v) const
+        {
+            u = wrapTextureCoordinate(u, w, wrapU, minU, maxU);
+            v = wrapTextureCoordinate(v, h, wrapV, minV, maxV);
+            const uint32_t pix = sw.pixel(static_cast<uint32_t>(u), static_cast<uint32_t>(v));
+            switch (kind)
+            {
+            case kTexRaw32:
+                return vramLoad32(vram, pix * 4u);
+            case kTexC24:
+                return applyTexa(texa, GS_PSM_CT24, vramLoad32(vram, pix * 4u) & 0x00FFFFFFu);
+            case kTexZ24:
+                return vramLoad32(vram, pix * 4u) & 0x00FFFFFFu;
+            case kTexC16:
+                return applyTexa(texa, GS_PSM_CT16, Rgba5551ToRgba8888(static_cast<uint16_t>(vramLoad16(vram, pix * 2u))));
+            case kTexZ16:
+                return Rgba5551ToRgba8888(static_cast<uint16_t>(vramLoad16(vram, pix * 2u)));
+            case kTexT8:
+                return palette[vram[pix & kVramByteMask]];
+            case kTexT8H:
+                return palette[vram[(pix * 4u + 3u) & kVramByteMask]];
+            case kTexT4:
+                return palette[(vram[(pix >> 1) & kVramByteMask] >> ((pix & 1u) * 4u)) & 0x0Fu];
+            case kTexT4HL:
+                return palette[vram[(pix * 4u + 3u) & kVramByteMask] & 0x0Fu];
+            default:
+                return palette[vram[(pix * 4u + 3u) & kVramByteMask] >> 4];
+            }
+        }
+
+        __attribute__((always_inline)) inline uint32_t sample(float fu, float fv) const
+        {
+            if (!linear)
+                return texel(static_cast<int>(fu), static_cast<int>(fv));
+
+            const float su = fu - 0.5f, sv = fv - 0.5f;
+            int u0 = static_cast<int>(su), v0 = static_cast<int>(sv);
+            u0 -= static_cast<float>(u0) > su;
+            v0 -= static_cast<float>(v0) > sv;
+            const uint32_t fx = static_cast<uint32_t>((su - static_cast<float>(u0)) * 256.0f);
+            const uint32_t fy = static_cast<uint32_t>((sv - static_cast<float>(v0)) * 256.0f);
+
+            const uint32_t c00 = texel(u0, v0);
+            if (fx == 0u && fy == 0u)
+                return c00;
+            if (fy == 0u)
+                return lanesTexel(lanesLerp(texelLanes(c00), texelLanes(texel(u0 + 1, v0)), fx));
+            if (fx == 0u)
+                return lanesTexel(lanesLerp(texelLanes(c00), texelLanes(texel(u0, v0 + 1)), fy));
+            const uint64_t top = lanesLerp(texelLanes(c00), texelLanes(texel(u0 + 1, v0)), fx);
+            const uint64_t bottom = lanesLerp(texelLanes(texel(u0, v0 + 1)), texelLanes(texel(u0 + 1, v0 + 1)), fx);
+            return lanesTexel(lanesLerp(top, bottom, fy));
+        }
+    };
+
+    // Do the texels of the primitive and the pixels it draws share a page? (linear page ranges: it may say yes in excess)
+    bool texelsMayOverlapFrame(const GSDrawState &state, const FastTexture &tex, const GSVertex *vertices, int count,
+                               int minX, int maxX, int minY, int maxY)
+    {
+        const auto &ctx = state.context;
+        float u0 = 1e30f, u1 = -1e30f, v0 = 1e30f, v1 = -1e30f;
+        bool bounded = true;
+        for (int i = 0; i < count; ++i)
+        {
+            const GSVertex &p = vertices[i];
+            float u, v;
+            if (state.prim.fst)
+            {
+                u = static_cast<float>(p.u) / 16.0f;
+                v = static_cast<float>(p.v) / 16.0f;
+            }
+            else
+            {
+                if (!(p.q > 1.0e-8f))
+                {
+                    bounded = false;
+                    break;
+                }
+                u = p.s / p.q * static_cast<float>(tex.w);
+                v = p.t / p.q * static_cast<float>(tex.h);
+            }
+            u0 = std::min(u0, u);
+            u1 = std::max(u1, u);
+            v0 = std::min(v0, v);
+            v1 = std::max(v1, v);
+        }
+
+        int texU0 = 0, texU1 = tex.w - 1, texV0 = 0, texV1 = tex.h - 1;
+        // a region mode reads from the CLAMP register's window, which may be outside TW and TH
+        if (tex.wrapU >= 2u)
+            texU1 = 1023;
+        if (tex.wrapV >= 2u)
+            texV1 = 1023;
+        if (bounded && tex.wrapU < 2u && tex.wrapV < 2u && u0 >= 1.0f && v0 >= 1.0f &&
+            u1 + 2.0f < static_cast<float>(tex.w) && v1 + 2.0f < static_cast<float>(tex.h))
+        {
+            // without the texel the filter reaches past the last pixel centre: UN5's frame copy stretches the 448 rows
+            // of a buffer into the 512 of the next one, and only its last row touches the first row being drawn
+            texU0 = static_cast<int>(u0);
+            texU1 = static_cast<int>(u1) - 1;
+            texV0 = static_cast<int>(v0);
+            texV1 = static_cast<int>(v1) - 1;
+        }
+
+        const FastSwizzle &ts = tex.sw;
+        const uint32_t texFirst = ts.basePage + (static_cast<uint32_t>(texV0) >> ts.yShift) * ts.pagesPerRow +
+                                  (static_cast<uint32_t>(texU0) >> ts.xShift);
+        const uint32_t texLast = ts.basePage + ((ctx.tex0.tbp0 & 31u) != 0u ? 1u : 0u) +
+                                 (static_cast<uint32_t>(texV1) >> ts.yShift) * ts.pagesPerRow +
+                                 (static_cast<uint32_t>(texU1) >> ts.xShift);
+
+        FastSwizzle fs;
+        fs.init(ctx.frame.psm, GSInternal::framePageBaseToBlock(ctx.frame.fbp), std::max<uint32_t>(ctx.frame.fbw, 1u));
+        const uint32_t frameFirst = fs.basePage + (static_cast<uint32_t>(minY) >> fs.yShift) * fs.pagesPerRow +
+                                    (static_cast<uint32_t>(minX) >> fs.xShift);
+        const uint32_t frameLast = fs.basePage + (static_cast<uint32_t>(maxY) >> fs.yShift) * fs.pagesPerRow +
+                                   (static_cast<uint32_t>(maxX) >> fs.xShift);
+        return texFirst <= frameLast && frameFirst <= texLast;
+    }
+
+    __attribute__((always_inline)) inline TextureCombineResult fastCombine(const GSTex0Reg &tex, uint8_t vr, uint8_t vg,
+                                                                            uint8_t vb, uint8_t va, uint8_t tr,
+                                                                            uint8_t tg, uint8_t tb, uint8_t ta)
+    {
+        if (tex.tfx == 0u)
+        {
+            const uint32_t r = (static_cast<uint32_t>(tr) * vr) >> 7, g = (static_cast<uint32_t>(tg) * vg) >> 7;
+            const uint32_t b = (static_cast<uint32_t>(tb) * vb) >> 7;
+            uint32_t a = va;
+            if (tex.tcc != 0u)
+                a = (static_cast<uint32_t>(ta) * va) >> 7;
+            return {static_cast<uint8_t>(r > 255u ? 255u : r), static_cast<uint8_t>(g > 255u ? 255u : g),
+                    static_cast<uint8_t>(b > 255u ? 255u : b), static_cast<uint8_t>(a > 255u ? 255u : a)};
+        }
+        return combineTexture(tex, vr, vg, vb, va, tr, tg, tb, ta);
+    }
+
+    inline float wholeFloor(float f)
+    {
+        const float t = static_cast<float>(static_cast<int>(f));
+        return t > f ? t - 1.0f : t;
+    }
+}
+
+const uint32_t *GSCpuBackend::FastPalette(const GSDrawState &state)
+{
+    const GSTex0Reg &tex = state.context.tex0;
+    if (!isFourBitIndexedPsm(tex.psm) && !isEightBitIndexedPsm(tex.psm))
+        return nullptr;
+
+    const uint32_t entries = isFourBitIndexedPsm(tex.psm) ? 16u : 256u;
+    const uint64_t key = (static_cast<uint64_t>(m_clutVersion) << 32) | (static_cast<uint64_t>(entries == 16u) << 31) |
+                         (static_cast<uint64_t>(state.texa.aem) << 30) | (static_cast<uint64_t>(tex.cpsm) << 24) |
+                         (static_cast<uint64_t>(tex.csm) << 23) | (static_cast<uint64_t>(tex.csa & 0x1Fu) << 16) |
+                         (static_cast<uint64_t>(state.texa.ta0) << 8) | static_cast<uint64_t>(state.texa.ta1);
+    if (key != m_fastPaletteKey)
+    {
+        m_fastPaletteKey = key;
+        for (uint32_t i = 0u; i < entries; ++i)
+            m_fastPalette[i] = LookupCLUT(state, static_cast<uint8_t>(i), tex.cpsm, tex.csm, tex.csa, tex.psm);
+    }
+    return m_fastPalette.data();
+}
+
+bool GSCpuBackend::DrawTriangleFast(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const GSVertex &v2 = batch.vertices[2];
+    const auto &ctx = state.context;
+
+    FastPixel out;
+    if (!out.init(state, m_vram))
+        return false;
+
+    const float ofx = static_cast<float>(ctx.xyoffset.ofx >> 4);
+    const float ofy = static_cast<float>(ctx.xyoffset.ofy >> 4);
+    const float fx0 = v0.x - ofx, fy0 = v0.y - ofy;
+    const float fx1 = v1.x - ofx, fy1 = v1.y - ofy;
+    const float fx2 = v2.x - ofx, fy2 = v2.y - ofy;
+
+    int minX = static_cast<int>(std::floor(std::min({fx0, fx1, fx2})));
+    int maxX = static_cast<int>(std::ceil(std::max({fx0, fx1, fx2})));
+    int minY = static_cast<int>(std::floor(std::min({fy0, fy1, fy2})));
+    int maxY = static_cast<int>(std::ceil(std::max({fy0, fy1, fy2})));
+    minX = clampInt(minX, ctx.scissor.x0, ctx.scissor.x1);
+    maxX = clampInt(maxX, ctx.scissor.x0, ctx.scissor.x1);
+    minY = clampInt(minY, ctx.scissor.y0, ctx.scissor.y1);
+    maxY = clampInt(maxY, ctx.scissor.y0, ctx.scissor.y1);
+
+    const float denom = (fy1 - fy2) * (fx0 - fx2) + (fx2 - fx1) * (fy0 - fy2);
+    if (std::fabs(denom) < 0.001f)
+        return true;
+
+    const bool textured = state.prim.tme;
+    FastTexture tex;
+    if (textured)
+    {
+        if (!tex.init(state, m_vram, FastPalette(state)))
+            return false;
+        if (texelsMayOverlapFrame(state, tex, batch.vertices.data(), 3, minX, maxX, minY, maxY))
+            return false;
+    }
+    m_texturePageCache.Invalidate();
+
+    const float scale = (denom < 0.0f ? -1.0f : 1.0f) / std::fabs(denom);
+    // w0(x, y) = a0 (x + .5 - fx2) + b0 (y + .5 - fy2), and the same for w1; w2 = 1 - w0 - w1
+    const float a0 = (fy1 - fy2) * scale, b0 = (fx2 - fx1) * scale;
+    const float a1 = (fy2 - fy0) * scale, b1 = (fx0 - fx2) * scale;
+    const float a2 = -a0 - a1;
+    constexpr float kEdgeEpsilon = 1.0e-4f;
+
+    // an attribute along the row: value at w0, w1 of the row start, plus slope per pixel
+    struct Plane
+    {
+        float d0, d1, base, dx;
+        inline float at(float w0, float w1) const { return base + d0 * w0 + d1 * w1; }
+    };
+    auto plane = [&](float p0, float p1, float p2) -> Plane
+    {
+        const float d0 = p0 - p2, d1 = p1 - p2;
+        return {d0, d1, p2, d0 * a0 + d1 * a1};
+    };
+
+    const bool shaded = state.prim.iip && !(v0.r == v1.r && v1.r == v2.r && v0.g == v1.g && v1.g == v2.g &&
+                                            v0.b == v1.b && v1.b == v2.b && v0.a == v1.a && v1.a == v2.a);
+    const uint8_t flatR = state.prim.iip ? v0.r : v2.r, flatG = state.prim.iip ? v0.g : v2.g;
+    const uint8_t flatB = state.prim.iip ? v0.b : v2.b, flatA = state.prim.iip ? v0.a : v2.a;
+    const Plane pr = plane(v0.r, v1.r, v2.r), pg = plane(v0.g, v1.g, v2.g);
+    const Plane pb = plane(v0.b, v1.b, v2.b), pa = plane(v0.a, v1.a, v2.a);
+    const Plane pf = plane(v0.fog, v1.fog, v2.fog);
+
+    const bool fst = state.prim.fst;
+    const Plane pu = plane(v0.u, v1.u, v2.u), pv = plane(v0.v, v1.v, v2.v);
+    const Plane ps = plane(v0.s, v1.s, v2.s), pt = plane(v0.t, v1.t, v2.t), pq = plane(v0.q, v1.q, v2.q);
+    const bool constantQ = v0.q == v1.q && v1.q == v2.q;
+    const float constantInvQ = 1.0f / fabsQ(v2.q);
+    const float texW = static_cast<float>(state.textureWidth), texH = static_cast<float>(state.textureHeight);
+
+    // Z has more bits than a float
+    const double zd0 = v0.z - v2.z, zd1 = v1.z - v2.z;
+    const double zdx = zd0 * a0 + zd1 * a1;
+    const bool wantsZ = out.needZ;
+
+    const float inv0 = std::fabs(a0) > 1.0e-9f ? 1.0f / a0 : 0.0f;
+    const float inv1 = std::fabs(a1) > 1.0e-9f ? 1.0f / a1 : 0.0f;
+    const float inv2 = std::fabs(a2) > 1.0e-9f ? 1.0f / a2 : 0.0f;
+
+    for (int y = minY; y <= maxY; ++y)
+    {
+        const float py = static_cast<float>(y) + 0.5f;
+        // w at x = 0 of this row
+        const float c0 = a0 * (0.5f - fx2) + b0 * (py - fy2);
+        const float c1 = a1 * (0.5f - fx2) + b1 * (py - fy2);
+        const float c2 = 1.0f - c0 - c1;
+
+        // the span where the three weights are not negative, one pixel wider: the test below decides at the borders
+        float left = static_cast<float>(minX), right = static_cast<float>(maxX);
+        bool empty = false;
+        auto clip = [&](float a, float inv, float c)
+        {
+            if (inv == 0.0f)
+            {
+                empty = empty || c < -kEdgeEpsilon - 1.0e-3f;
+                return;
+            }
+            const float cross = (-kEdgeEpsilon - c) * inv;
+            if (a > 0.0f)
+                left = std::max(left, cross - 1.0f);
+            else
+                right = std::min(right, cross + 1.0f);
+        };
+        clip(a0, inv0, c0);
+        clip(a1, inv1, c1);
+        clip(a2, inv2, c2);
+        if (empty || left > right)
+            continue;
+        const int xStart = static_cast<int>(wholeFloor(left));
+        const int xEnd = static_cast<int>(right);
+        if (xStart > xEnd)
+            continue;
+
+        const float ws0 = a0 * static_cast<float>(xStart) + c0;
+        const float ws1 = a1 * static_cast<float>(xStart) + c1;
+        const float us = pu.at(ws0, ws1), vs = pv.at(ws0, ws1);
+        const float ss = ps.at(ws0, ws1), ts = pt.at(ws0, ws1), qs = pq.at(ws0, ws1);
+        const float rs = pr.at(ws0, ws1), gs = pg.at(ws0, ws1), bs = pb.at(ws0, ws1), as = pa.at(ws0, ws1);
+        const float fs = pf.at(ws0, ws1);
+        const double zs = v2.z + zd0 * ws0 + zd1 * ws1;
+
+        for (int x = xStart; x <= xEnd; ++x)
+        {
+            const float dx = static_cast<float>(x - xStart);
+            const float w0 = ws0 + a0 * dx, w1 = ws1 + a1 * dx;
+            if (w0 < -kEdgeEpsilon || w1 < -kEdgeEpsilon || 1.0f - w0 - w1 < -kEdgeEpsilon)
+                continue;
+
+            uint8_t r = flatR, g = flatG, b = flatB, a = flatA;
+            if (shaded)
+            {
+                r = clampU8(static_cast<int>(rs + pr.dx * dx));
+                g = clampU8(static_cast<int>(gs + pg.dx * dx));
+                b = clampU8(static_cast<int>(bs + pb.dx * dx));
+                a = clampU8(static_cast<int>(as + pa.dx * dx));
+            }
+
+            if (textured)
+            {
+                float fu, fv;
+                if (fst)
+                {
+                    fu = static_cast<float>(static_cast<uint16_t>(us + pu.dx * dx)) / 16.0f;
+                    fv = static_cast<float>(static_cast<uint16_t>(vs + pv.dx * dx)) / 16.0f;
+                }
+                else
+                {
+                    const float invQ = constantQ ? constantInvQ : 1.0f / fabsQ(qs + pq.dx * dx);
+                    fu = (ss + ps.dx * dx) * invQ * texW;
+                    fv = (ts + pt.dx * dx) * invQ * texH;
+                }
+                const uint32_t c = tex.sample(fu, fv);
+                const TextureCombineResult color = fastCombine(
+                    ctx.tex0, r, g, b, a, static_cast<uint8_t>(c), static_cast<uint8_t>(c >> 8),
+                    static_cast<uint8_t>(c >> 16), static_cast<uint8_t>(c >> 24));
+                r = color.r;
+                g = color.g;
+                b = color.b;
+                a = color.a;
+            }
+
+            const uint8_t fog = out.fge ? clampU8(static_cast<int>(fs + pf.dx * dx)) : static_cast<uint8_t>(0u);
+            const uint32_t z = wantsZ ? static_cast<uint32_t>(zs + zdx * dx + 0.5) : 0u;
+            out.put(x, y, z, r, g, b, a, fog);
+        }
+    }
+    return true;
+}
+
+bool GSCpuBackend::DrawSpriteFast(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const GSVertex &v0 = batch.vertices[0];
+    const GSVertex &v1 = batch.vertices[1];
+    const auto &ctx = state.context;
+
+    FastPixel out;
+    if (!out.init(state, m_vram))
+        return false;
+
+    const int ofx = ctx.xyoffset.ofx >> 4;
+    const int ofy = ctx.xyoffset.ofy >> 4;
+    int x0 = static_cast<int>(v0.x) - ofx, y0 = static_cast<int>(v0.y) - ofy;
+    int x1 = static_cast<int>(v1.x) - ofx, y1 = static_cast<int>(v1.y) - ofy;
+    if (x0 > x1)
+        std::swap(x0, x1);
+    if (y0 > y1)
+        std::swap(y0, y1);
+
+    const int spanX = std::max(1, x1 - x0);
+    const int spanY = std::max(1, y1 - y0);
+    const int lastX = x0 + spanX - 1, lastY = y0 + spanY - 1;
+    if (lastX < ctx.scissor.x0 || x0 > ctx.scissor.x1 || lastY < ctx.scissor.y0 || y0 > ctx.scissor.y1)
+        return true;
+
+    const int drawX0 = clampInt(x0, ctx.scissor.x0, ctx.scissor.x1);
+    const int drawY0 = clampInt(y0, ctx.scissor.y0, ctx.scissor.y1);
+    const int drawX1 = clampInt(lastX, ctx.scissor.x0, ctx.scissor.x1);
+    const int drawY1 = clampInt(lastY, ctx.scissor.y0, ctx.scissor.y1);
+    const uint32_t z = static_cast<uint32_t>(v1.z);
+    const uint8_t r = v1.r, g = v1.g, b = v1.b, a = v1.a, fog = v1.fog;
+
+    if (!state.prim.tme)
+    {
+        m_texturePageCache.Invalidate();
+        for (int y = drawY0; y <= drawY1; ++y)
+            for (int x = drawX0; x <= drawX1; ++x)
+                out.put(x, y, z, r, g, b, a, fog);
+        return true;
+    }
+
+    FastTexture tex;
+    if (!tex.init(state, m_vram, FastPalette(state)))
+        return false;
+    if (texelsMayOverlapFrame(state, tex, batch.vertices.data(), 2, drawX0, drawX1, drawY0, drawY1))
+        return false;
+    m_texturePageCache.Invalidate();
+
+    const bool fst = state.prim.fst;
+    float u0f, v0f, u1f, v1f;
+    if (fst)
+    {
+        u0f = static_cast<float>(v0.u >> 4);
+        v0f = static_cast<float>(v0.v >> 4);
+        u1f = static_cast<float>(v1.u >> 4);
+        v1f = static_cast<float>(v1.v >> 4);
+    }
+    else
+    {
+        const float q0 = fabsQ(v0.q), q1 = fabsQ(v1.q);
+        const float texW = static_cast<float>(state.textureWidth), texH = static_cast<float>(state.textureHeight);
+        u0f = (v0.s / q0) * texW;
+        v0f = (v0.t / q0) * texH;
+        u1f = (v1.s / q1) * texW;
+        v1f = (v1.t / q1) * texH;
+    }
+    const float stepU = (u1f - u0f) / static_cast<float>(spanX);
+    const float stepV = (v1f - v0f) / static_cast<float>(spanY);
+
+    for (int y = drawY0; y <= drawY1; ++y)
+    {
+        float fv = v0f + stepV * (static_cast<float>(y - y0) + 0.5f);
+        if (fst)
+            fv = static_cast<float>(clampInt(static_cast<int>(fv * 16.0f + 0.5f), 0, 0xFFFF)) / 16.0f;
+        for (int x = drawX0; x <= drawX1; ++x)
+        {
+            float fu = u0f + stepU * (static_cast<float>(x - x0) + 0.5f);
+            if (fst)
+                fu = static_cast<float>(clampInt(static_cast<int>(fu * 16.0f + 0.5f), 0, 0xFFFF)) / 16.0f;
+            const uint32_t c = tex.sample(fu, fv);
+            const TextureCombineResult color = fastCombine(
+                ctx.tex0, r, g, b, a, static_cast<uint8_t>(c), static_cast<uint8_t>(c >> 8),
+                static_cast<uint8_t>(c >> 16), static_cast<uint8_t>(c >> 24));
+            out.put(x, y, z, color.r, color.g, color.b, color.a, fog);
+        }
+    }
+    return true;
+}
+
+// HL_GS_VERIFY=N: one primitive in N is drawn by both paths; the old one stays in VRAM. A byte that differs by more
+// than the rounding of the fixed-point filter is reported.
+void GSCpuBackend::VerifyFastPath(const GSPrimitiveBatch &batch)
+{
+    static std::vector<uint8_t> before, fast;
+    static uint64_t checked = 0u, differing = 0u;
+    before.assign(m_vram, m_vram + GSMem::MEMORY_SIZE);
+
+    const bool isSprite = batch.state.prim.type == GS_PRIM_SPRITE;
+    const bool handled = isSprite ? DrawSpriteFast(batch) : DrawTriangleFast(batch);
+    if (!handled)
+    {
+        std::memcpy(m_vram, before.data(), GSMem::MEMORY_SIZE);
+        return;
+    }
+    fast.assign(m_vram, m_vram + GSMem::MEMORY_SIZE);
+    std::memcpy(m_vram, before.data(), GSMem::MEMORY_SIZE);
+
+    m_texturePageCache.Invalidate();
+    m_forceSlowPath = true;
+    if (isSprite)
+        DrawSprite(batch);
+    else
+        DrawTriangle(batch);
+    m_forceSlowPath = false;
+
+    uint32_t bad = 0u, firstBad = 0u;
+    for (uint32_t i = 0u; i < GSMem::MEMORY_SIZE; ++i)
+    {
+        const int d = static_cast<int>(fast[i]) - static_cast<int>(m_vram[i]);
+        if (d > 3 || d < -3)
+        {
+            if (bad++ == 0u)
+                firstBad = i;
+        }
+    }
+    ++checked;
+    if (bad != 0u)
+    {
+        ++differing;
+        const auto &ctx = batch.state.context;
+        std::fprintf(stderr,
+                     "[gs:verify] %u bytes differ, first %#x (fast %02x, old %02x): prim=%d tme=%d fst=%d abe=%d "
+                     "linear=%d fbp=%u fpsm=%#x tbp=%u tpsm=%#x clamp=%#llx test=%#llx alpha=%#llx; %llu of %llu\n",
+                     bad, firstBad, fast[firstBad], m_vram[firstBad], static_cast<int>(batch.state.prim.type),
+                     batch.state.prim.tme, batch.state.prim.fst, batch.state.prim.abe, batch.state.linearFilter,
+                     ctx.frame.fbp, ctx.frame.psm, ctx.tex0.tbp0, ctx.tex0.psm,
+                     static_cast<unsigned long long>(ctx.clamp), static_cast<unsigned long long>(ctx.test),
+                     static_cast<unsigned long long>(ctx.alpha), static_cast<unsigned long long>(differing),
+                     static_cast<unsigned long long>(checked));
+    }
+    else if ((checked % 2000u) == 0u)
+    {
+        std::fprintf(stderr, "[gs:verify] %llu primitives checked, %llu differ\n",
+                     static_cast<unsigned long long>(checked), static_cast<unsigned long long>(differing));
+    }
+}
