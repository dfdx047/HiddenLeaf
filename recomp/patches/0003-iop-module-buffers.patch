+    std::string IopModuleLoader::iopModuleName(std::span<const uint8_t> image)
+    {
+        // The IRX's own name, from its .iopmod section (type 0x70000080): the name starts at byte 0x1a.
+        if (image.size() < 0x34u)
+            return {};
+        auto u32 = [&](size_t at) -> uint32_t
+        { return at + 4u <= image.size() ? (uint32_t)image[at] | (uint32_t)image[at + 1] << 8 | (uint32_t)image[at + 2] << 16 | (uint32_t)image[at + 3] << 24 : 0u; };
+        auto u16 = [&](size_t at) -> uint32_t
+        { return at + 2u <= image.size() ? (uint32_t)image[at] | (uint32_t)image[at + 1] << 8 : 0u; };
+        const uint32_t shoff = u32(0x20u), shentsize = u16(0x2eu), shnum = u16(0x30u);
+        for (uint32_t i = 0; i < shnum && shentsize >= 40u; ++i)
+        {
+            const size_t sh = (size_t)shoff + (size_t)i * shentsize;
+            if (sh + 40u > image.size() || u32(sh + 4u) != 0x70000080u)
+                continue;
+            const size_t offset = u32(sh + 16u), size = u32(sh + 20u);
+            std::string name;
+            for (size_t at = offset + 0x1au; at < offset + size && at < image.size() && image[at] != 0u; ++at)
+                name.push_back((char)image[at]);
+            return name;
+        }
+        return {};
+    }
 }
