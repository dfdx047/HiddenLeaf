+
+    // MAX and MINI compare the raw words, like the VU (and PCSX2's fp_max/fp_min): denormals and integers kept in VF
+    // registers pass through unchanged. Microprograms copy integer vertex colors with MAX vfd, vfs, vfs.
+    float vuMax(float a, float b)
+    {
+        int32_t ia = 0, ib = 0;
+        std::memcpy(&ia, &a, sizeof(ia));
+        std::memcpy(&ib, &b, sizeof(ib));
+        const int32_t r = (ia < 0 && ib < 0) ? std::min(ia, ib) : std::max(ia, ib);
+        float result = 0.0f;
+        std::memcpy(&result, &r, sizeof(result));
+        return result;
+    }
+
+    float vuMin(float a, float b)
+    {
+        int32_t ia = 0, ib = 0;
+        std::memcpy(&ia, &a, sizeof(ia));
+        std::memcpy(&ib, &b, sizeof(ib));
+        const int32_t r = (ia < 0 && ib < 0) ? std::max(ia, ib) : std::min(ia, ib);
+        float result = 0.0f;
+        std::memcpy(&result, &r, sizeof(result));
+        return result;
+    }
 }
 
