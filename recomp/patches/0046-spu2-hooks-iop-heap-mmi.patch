+                           "   std::memcpy(&ctx->lo, &l[0], 8); std::memcpy(&ctx->lo1, &l[2], 8); std::memcpy(&ctx->hi, &h[0], 8); std::memcpy(&ctx->hi1, &h[2], 8); \n"
+                           "   SET_GPR_VEC(ctx, {}, _mm_set_epi32(h[2], l[2], h[0], l[0])); }}",
                            inst.rs, inst.rt, inst.rd);
     }
 
