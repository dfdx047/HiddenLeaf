 namespace ps2x::iop::detail
 {
+    // Hidden Leaf: a real SPU2 under the IOP, when the host has one (recomp/android/spu2/hl_spu2.cpp). Without it, the
+    // registers stay plain memory and a DMA just ends after a while, with no sound.
+    struct Spu2Hooks
+    {
+        static constexpr uint32_t kDma4Done = 1u, kDma7Done = 2u, kSpu2Irq = 4u;
+        void (*attach)(const uint64_t *cycles, uint8_t *ram);
+        void (*advance)();                                                     // its clock up to the IOP's
+        uint16_t (*read16)(uint32_t phys);
+        void (*write16)(uint32_t phys, uint16_t value);
+        void (*dma)(bool secondCore, uint32_t madr, uint32_t bcr, uint32_t chcr);
+        uint32_t (*takeIrqs)();                                                // what ended since the last call
+    };
+    inline const Spu2Hooks *g_spu2 = nullptr;
+
     class IopMemory
     {
     public:
