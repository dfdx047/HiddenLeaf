+    std::string discKey(const std::string &guestPath)
+    {
+        const size_t device = guestPath.find(':');
+        std::string key;
+        for (const char c : device == std::string::npos ? guestPath : guestPath.substr(device + 1u))
+        {
+            if (c == ';')
+                break;
+            const char d = c == '\\' ? '/' : static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+            if (d == '/' && (key.empty() || key.back() == '/'))
+                continue;
+            key.push_back(d);
+        }
+        return key;
+    }
+
+    void loadMods()
+    {
+        s_virtualSize = (s_size + kSector - 1u) / kSector * kSector;
+        const char *list = std::getenv("HL_MODS");
+        if (!list || !list[0])
+            return;
+        std::map<std::string, std::pair<std::string, uint64_t>> files; // later mods win
+        std::string text = list;
+        size_t at = 0;
+        while (at <= text.size())
+        {
+            const size_t nl = text.find('\n', at);
+            const std::string dir = text.substr(at, nl == std::string::npos ? std::string::npos : nl - at);
+            at = nl == std::string::npos ? text.size() + 1u : nl + 1u;
+            std::error_code ec;
+            if (dir.empty() || !std::filesystem::is_directory(dir, ec))
+                continue;
+            for (auto it = std::filesystem::recursive_directory_iterator(dir, ec); !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec))
+            {
+                if (!it->is_regular_file(ec))
+                    continue;
+                const std::string rel = std::filesystem::relative(it->path(), dir, ec).generic_string();
+                files[discKey(rel)] = {it->path().string(), static_cast<uint64_t>(it->file_size(ec))};
+            }
+        }
+        uint32_t next = static_cast<uint32_t>(s_virtualSize / kSector);
+        next = (next + 15u) & ~15u;
+        for (const auto &[key, file] : files)
+        {
+            const int fd = ::open(file.first.c_str(), O_RDONLY | O_CLOEXEC);
+            if (fd < 0)
+            {
+                std::fprintf(stderr, "[hl] mod file cannot be read: %s\n", file.first.c_str());
+                continue;
+            }
+            const uint32_t sectors = static_cast<uint32_t>((file.second + kSector - 1u) / kSector);
+            uint32_t lbn = 0u, size = 0u;
+            const bool inPlace = baseResolve(key, lbn, size) && sectors <= (size + kSector - 1u) / kSector;
+            if (!inPlace)
+            {
+                lbn = next;
+                next += (sectors + 15u) & ~15u;
+            }
+            s_modByPath[key] = s_mods.size();
+            s_mods.push_back({file.first, file.second, lbn, sectors, fd});
+            std::fprintf(stderr, "[hl] mod: %s %s (%llu bytes, lbn %u)\n", key.c_str(), inPlace ? "in place" : "after the disc",
+                         static_cast<unsigned long long>(file.second), lbn);
+        }
+        s_virtualSize = static_cast<uint64_t>(next) * kSector;
+    }
+}
+
 bool hlImageResolve(const std::string &guestPath, uint32_t &lbn, uint32_t &size)
+{
+    if (s_fd < 0)
