diff --git a/ps2xRuntime/src/lib/gs/hl_gs_live.cpp b/ps2xRuntime/src/lib/gs/hl_gs_live.cpp
new file mode 100644
index 0000000..d7902f7
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/hl_gs_live.cpp
@@ -0,0 +1,347 @@
+// Hidden Leaf: the live GS stream (see runtime/gs/hl_gs_live.h). The protocol is BT3-Recomp's ps2_gs_live.cpp (GPLv3), in turn
+// from PS2Recomp's gs_dump_writer.cpp, reduced to what one process needs: the ring is plain memory.
+#include "runtime/gs/hl_gs_live.h"
+#include "runtime/gs/gs_backend.h"
+#include "runtime/ps2_memory.h"
+#include "ps2_live_ring.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace
+{
+    constexpr uint8_t kTypeTransfer = 0u, kTypeVSync = 1u, kTypeReadFifo2 = 2u, kTypeRegisters = 3u;
+    constexpr uint8_t kPath2 = 1u, kPath3 = 2u, kPath1New = 3u; // PCSX2's GSDumpTypes
+    constexpr uint32_t kPrivRegsSize = 8192u;
+    constexpr uint32_t kGsStateVersion = 9u; // GSState::STATE_VERSION in PCSX2 2.x
+    constexpr uint64_t kCapacity = 64ull << 20;
+    const char kSerial[] = "SLES-55605";
+
+#pragma pack(push, 4)
+    struct DumpHeader
+    {
+        uint32_t state_version, state_size, serial_offset, serial_size, crc;
+        uint32_t screenshot_width, screenshot_height, screenshot_offset, screenshot_size;
+    };
+#pragma pack(pop)
+
+    std::mutex s_mutex;
+    std::atomic<ps2live::RingHeader *> s_ring{nullptr};
+    ps2live::RingEvents *s_events = nullptr;
+    uint8_t *s_data = nullptr;
+    bool s_headerWritten = false;
+    uint32_t s_frames = 0;
+    std::vector<uint8_t> s_regs(kPrivRegsSize, 0);
+
+    void put(uint32_t offset, uint64_t value) { std::memcpy(s_regs.data() + offset, &value, sizeof(value)); }
+
+    void snapshot(const GSRegisters &r)
+    {
+        put(0x0000u, r.pmode);
+        put(0x0010u, r.smode1 ? r.smode1 : 0x0000000740834504ull); // the PAL value, when the CRTC was never programmed
+        put(0x0020u, r.smode2);
+        put(0x0030u, r.srfsh);
+        put(0x0040u, r.synch1);
+        put(0x0050u, r.synch2);
+        put(0x0060u, r.syncv);
+        put(0x0070u, r.dispfb1);
+        put(0x0080u, r.display1);
+        put(0x0090u, r.dispfb2);
+        put(0x00A0u, r.display2);
+        put(0x00B0u, r.extbuf);
+        put(0x00C0u, r.extdata);
+        put(0x00D0u, r.extwrite);
+        put(0x00E0u, r.bgcolor);
+        put(0x1000u, r.csr.load(std::memory_order_relaxed));
+        put(0x1010u, r.imr);
+        put(0x1040u, r.busdir);
+        put(0x1080u, r.siglblid);
+    }
+
+    void writeBytes(const void *src, size_t size)
+    {
+        ps2live::RingHeader *h = s_ring.load(std::memory_order_relaxed);
+        const auto *in = static_cast<const uint8_t *>(src);
+        while (size != 0u)
+        {
+            const int64_t w = h->writePos;
+            const int64_t r = __atomic_load_n(&h->readPos, __ATOMIC_ACQUIRE);
+            const uint64_t freeBytes = kCapacity - static_cast<uint64_t>(w - r);
+            if (freeBytes == 0u)
+            {
+                if (h->consumerQuit)
+                    std::_Exit(0);
+                h->producerWaiting = 1u;
+                __atomic_thread_fence(__ATOMIC_SEQ_CST);
+                if (h->readPos == r)
+                    ps2live::eventWait(&s_events->space, 20);
+                h->producerWaiting = 0u;
+                continue;
+            }
+            const uint64_t offset = static_cast<uint64_t>(w) % kCapacity;
+            const size_t chunk = static_cast<size_t>(std::min<uint64_t>({size, freeBytes, kCapacity - offset}));
+            std::memcpy(s_data + offset, in, chunk);
+            __atomic_store_n(&h->writePos, w + static_cast<int64_t>(chunk), __ATOMIC_RELEASE);
+            in += chunk;
+            size -= chunk;
+        }
+    }
+    void writeByte(uint8_t v) { writeBytes(&v, 1u); }
+    void writeWord(uint32_t v) { writeBytes(&v, 4u); }
+
+    void endPacket()
+    {
+        ps2live::RingHeader *h = s_ring.load(std::memory_order_relaxed);
+        __atomic_thread_fence(__ATOMIC_SEQ_CST);
+        if (h->consumerWaiting)
+            ps2live::eventSet(&s_events->data);
+    }
+
+    // The ring and the dump's header, with the first packet. No saved GS state: the stream starts with the GS fresh.
+    void ensureStarted()
+    {
+        if (!s_ring.load(std::memory_order_relaxed))
+        {
+            void *block = std::aligned_alloc(64, static_cast<size_t>(ps2live::mappingSize(kCapacity)));
+            if (!block)
+            {
+                std::fprintf(stderr, "[gslive] no memory for the ring\n");
+                std::_Exit(1);
+            }
+            auto *h = static_cast<ps2live::RingHeader *>(block);
+            std::memset(h, 0, sizeof(*h));
+            h->capacity = kCapacity;
+            h->padAxes = 0x80808080u;
+            h->version = ps2live::kVersion;
+            h->producerAlive = 1u;
+            h->producerFlags = 1u;
+            s_data = ps2live::ringData(h);
+            s_events = ps2live::ringEvents(h);
+            std::memset(s_events, 0, sizeof(*s_events));
+            __atomic_thread_fence(__ATOMIC_SEQ_CST);
+            h->magic = ps2live::kMagic;
+            s_ring.store(h, std::memory_order_release);
+        }
+        if (s_headerWritten)
+            return;
+        s_headerWritten = true;
+        const uint32_t serialSize = static_cast<uint32_t>(sizeof(kSerial) - 1u);
+        writeWord(0xFFFFFFFFu);
+        writeWord(static_cast<uint32_t>(sizeof(DumpHeader)) + serialSize);
+        DumpHeader header{};
+        header.state_version = kGsStateVersion;
+        header.serial_offset = sizeof(DumpHeader);
+        header.serial_size = serialSize;
+        header.screenshot_offset = header.serial_offset + serialSize;
+        writeBytes(&header, sizeof(header));
+        writeBytes(kSerial, serialSize);
+        writeBytes(s_regs.data(), s_regs.size());
+    }
+
+    void writeTransfer(uint8_t path, const uint8_t *data, uint32_t size)
+    {
+        writeByte(kTypeTransfer);
+        writeByte(path);
+        writeWord(size);
+        writeBytes(data, size);
+        endPacket();
+    }
+
+    // PCSX2's GS keeps a tag open from one packet to the next, and the game's VU1 and DMA packets can end in the middle of one
+    // (the runtime's own parser, and the PC build with it, starts every packet on a tag and drops what is missing). So every
+    // packet leaves here self-contained: its last tag says only what the packet has.
+    std::vector<uint8_t> s_trimmed;
+
+    uint32_t tagQwords(uint64_t lo)
+    {
+        const uint32_t nloop = static_cast<uint32_t>(lo & 0x7FFFu);
+        const uint32_t flg = static_cast<uint32_t>((lo >> 58) & 3u);
+        uint32_t nreg = static_cast<uint32_t>((lo >> 60) & 15u);
+        if (nreg == 0u)
+            nreg = 16u;
+        return flg == 0u ? nloop * nreg : (flg == 1u ? (nloop * nreg + 1u) / 2u : nloop);
+    }
+
+    // 1 + the offset of a tag that runs past the end, or 0
+    uint32_t cutOfLastTag(const uint8_t *data, uint32_t size)
+    {
+        uint32_t offset = 0u;
+        while (offset + 16u <= size)
+        {
+            uint64_t lo;
+            std::memcpy(&lo, data + offset, 8u);
+            const uint64_t end = static_cast<uint64_t>(offset) + 16u + static_cast<uint64_t>(tagQwords(lo)) * 16u;
+            if (end > size)
+                return offset + 1u;
+            offset = static_cast<uint32_t>(end);
+        }
+        return 0u;
+    }
+
+    uint32_t trimLastTag(uint8_t *data, uint32_t size, uint32_t tagOffset, int path)
+    {
+        uint64_t lo;
+        std::memcpy(&lo, data + tagOffset, 8u);
+        const uint32_t flg = static_cast<uint32_t>((lo >> 58) & 3u);
+        uint32_t nreg = static_cast<uint32_t>((lo >> 60) & 15u);
+        if (nreg == 0u)
+            nreg = 16u;
+        const uint32_t have = (size - tagOffset - 16u) / 16u;
+        const uint32_t nloop = flg == 0u ? have / nreg : (flg == 1u ? have * 2u / nreg : have);
+        static uint32_t s_count = 0;
+        if (std::getenv("HL_GSLIVE_LOG") && (++s_count <= 8u || (s_count & 1023u) == 0u))
+            std::fprintf(stderr, "[gslive] path %d packet of %u bytes ends inside a tag at %u (flg %u nreg %u nloop %u, has %u): #%u\n", path, size,
+                         tagOffset, flg, nreg, static_cast<uint32_t>(lo & 0x7FFFu), nloop, s_count);
+        const uint32_t qwords = flg == 0u ? nloop * nreg : (flg == 1u ? (nloop * nreg + 1u) / 2u : nloop);
+        lo = (lo & ~0x7FFFull) | (1ull << 15) | nloop; // (with EOP: nothing more of it is coming)
+        std::memcpy(data + tagOffset, &lo, 8u);
+        return tagOffset + 16u + qwords * 16u;
+    }
+
+    // The runtime's GS parses the stream for its state; this one draws nothing and keeps no memory.
+    class NullBackend final : public GSRasterBackend
+    {
+    public:
+        void Initialize(uint8_t *, uint32_t) override {}
+        void Reset() override {}
+        void Submit(const GSPrimitiveBatch &) override {}
+        void LoadClut(const GSTex0Reg &, const GSTexClutReg &) override {}
+        void BeginTransfer(const GSTransferCommand &) override {}
+        void UploadImage(const uint8_t *, uint32_t) override {}
+        void Flush() override {}
+        void TextureFlush() override {}
+        void Sync(GSSyncReason) override {}
+        PresentationFrame Present(const GSPresentationRequest &) override { return {}; }
+        bool ClearFramebuffer(const GSContext &, uint32_t) override { return true; }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *, uint32_t) override { return 0u; }
+        uint32_t ReadVram(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) const override { return 0u; }
+        void WriteVram(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override {}
+        void SnapshotVram(std::vector<uint8_t> &) const override {}
+        GSTransferSnapshot GetTransferSnapshot() const override { return {}; }
+    };
+}
+
+namespace hl_gslive
+{
+    void transfer(int path, const uint8_t *data, uint32_t sizeBytes)
+    {
+        const uint8_t type = path == 1 ? kPath1New : (path == 2 ? kPath2 : kPath3);
+        std::lock_guard<std::mutex> lock(s_mutex);
+        ensureStarted();
+        sizeBytes &= ~15u;
+        if (const uint32_t cut = cutOfLastTag(data, sizeBytes); cut != 0u)
+        {
+            s_trimmed.assign(data, data + sizeBytes);
+            sizeBytes = trimLastTag(s_trimmed.data(), sizeBytes, cut - 1u, path);
+            data = s_trimmed.data();
+        }
+        // PCSX2's path buffers hold 9 MB with 1 MB of margin. (Nothing this large was seen: only images could be, and an image
+        // can be cut anywhere.)
+        constexpr uint32_t kSlice = 4u << 20;
+        while (sizeBytes > kSlice)
+        {
+            writeTransfer(type, data, kSlice);
+            data += kSlice;
+            sizeBytes -= kSlice;
+        }
+        if (sizeBytes != 0u)
+            writeTransfer(type, data, sizeBytes);
+    }
+
+    void writeRegister(uint8_t reg, uint64_t value)
+    {
+        uint64_t packet[4];
+        packet[0] = 1ull | (1ull << 15) | (1ull << 60); // NLOOP 1, EOP, PACKED, one register
+        packet[1] = 0xEull;                             // A+D
+        packet[2] = value;
+        packet[3] = reg;
+        std::lock_guard<std::mutex> lock(s_mutex);
+        ensureStarted();
+        writeTransfer(kPath2, reinterpret_cast<const uint8_t *>(packet), sizeof(packet));
+    }
+
+    bool readFifo(uint8_t *dst, uint32_t bytes)
+    {
+        const uint32_t qwc = (bytes + 15u) / 16u;
+        if (qwc == 0u)
+            return false;
+        uint32_t seq0 = 0;
+        {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            ensureStarted();
+            ps2live::RingHeader *h = s_ring.load(std::memory_order_relaxed);
+            const bool answers = (__atomic_load_n(&h->consumerFlags, __ATOMIC_ACQUIRE) & 2u) != 0u;
+            seq0 = __atomic_load_n(&s_events->readbackSeq, __ATOMIC_ACQUIRE);
+            writeByte(kTypeReadFifo2);
+            writeWord(qwc);
+            endPacket();
+            if (!answers)
+                return false;
+        }
+        for (int i = 0; i < 1000; ++i)
+        {   // (up to 10 s; PCSX2's GS has to finish what is queued before it)
+            if (__atomic_load_n(&s_events->readbackSeq, __ATOMIC_ACQUIRE) != seq0)
+            {
+                const uint32_t have = std::min<uint32_t>(s_events->readbackBytes, bytes);
+                std::memcpy(dst, ps2live::readbackData(s_ring.load(std::memory_order_relaxed)), have);
+                return true;
+            }
+            ps2live::eventWait(&s_events->readback, 10);
+        }
+        std::fprintf(stderr, "[gslive] no answer to a GS download of %u bytes\n", bytes);
+        return false;
+    }
+
+    void vsync(const GSRegisters &regs)
+    {
+        ps2live::RingHeader *h = nullptr;
+        int64_t target = -1;
+        {
+            std::lock_guard<std::mutex> lock(s_mutex);
+            snapshot(regs);
+            ensureStarted();
+            h = s_ring.load(std::memory_order_relaxed);
+            if (s_frames % 250u == 0u && std::getenv("HL_GSLIVE_LOG"))
+                std::fprintf(stderr, "[gslive] vsync %u: pmode %llx smode1 %llx smode2 %llx dispfb1 %llx display1 %llx dispfb2 %llx display2 %llx bg %llx, %lld MB so far\n", s_frames,
+                             (unsigned long long)regs.pmode, (unsigned long long)regs.smode1, (unsigned long long)regs.smode2, (unsigned long long)regs.dispfb1,
+                             (unsigned long long)regs.display1, (unsigned long long)regs.dispfb2, (unsigned long long)regs.display2, (unsigned long long)regs.bgcolor,
+                             (long long)(h->writePos >> 20));
+            writeByte(kTypeRegisters);
+            writeBytes(s_regs.data(), s_regs.size());
+            writeByte(kTypeVSync);
+            writeByte(static_cast<uint8_t>(s_frames & 1u));
+            endPacket();
+            static const uint32_t maxLag = []() -> uint32_t
+            {
+                const char *v = std::getenv("HL_GSLIVE_MAXLAG");
+                return v ? static_cast<uint32_t>(std::atoi(v)) : 3u;
+            }();
+            constexpr uint32_t kHist = 64u;
+            static int64_t s_vsyncPos[kHist] = {};
+            s_vsyncPos[s_frames % kHist] = h->writePos;
+            if (maxLag != 0u && s_frames >= maxLag)
+                target = s_vsyncPos[(s_frames - maxLag) % kHist];
+            ++s_frames;
+        }
+        // bounded lag: the game waits until the host has read up to the VSync maxLag frames back
+        while (target >= 0 && __atomic_load_n(&h->readPos, __ATOMIC_ACQUIRE) < target)
+        {
+            if (h->consumerQuit)
+                std::_Exit(0);
+            h->producerWaiting = 1u;
+            __atomic_thread_fence(__ATOMIC_SEQ_CST);
+            if (h->readPos < target)
+                ps2live::eventWait(&s_events->space, 5);
+            h->producerWaiting = 0u;
+        }
+    }
+
+    void *ring() { return s_ring.load(std::memory_order_acquire); }
+
+    std::unique_ptr<GSRasterBackend> nullBackend() { return std::make_unique<NullBackend>(); }
+}
