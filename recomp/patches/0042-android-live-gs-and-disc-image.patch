diff --git a/ps2xRuntime/include/runtime/gs/hl_gs_live.h b/ps2xRuntime/include/runtime/gs/hl_gs_live.h
new file mode 100644
index 0000000..975fdda
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/hl_gs_live.h
@@ -0,0 +1,24 @@
+#pragma once
+// Hidden Leaf: the game's GS stream, live, in the format of a PCSX2 GS dump, into a ring in memory (ps2_live_ring.h), read
+// by PCSX2's GS in the same process (libbt4gsx.so, recomp/android). Only in the headless build (PS2X_HEADLESS_HOST): there the
+// runtime's own GS keeps the state (CSR, transfers) and draws nothing.
+#include <cstdint>
+#include <memory>
+
+class GSRasterBackend;
+struct GSRegisters;
+
+namespace hl_gslive
+{
+    // Packets as the GS receives them, in stream order. path: 1, 2 or 3.
+    void transfer(int path, const uint8_t *data, uint32_t sizeBytes);
+    // A register the runtime's stubs write straight into its GS: sent as an A+D packet.
+    void writeRegister(uint8_t reg, uint64_t value);
+    // GS -> EE: asks the host, waits for its answer and copies it. False if it did not answer.
+    bool readFifo(uint8_t *dst, uint32_t bytes);
+    // A guest vsync: the privileged registers and the VSync packet. Waits while the host is more than a few frames behind.
+    void vsync(const GSRegisters &regs);
+    // The ring, once the first packet made it (the host polls this).
+    void *ring();
+    std::unique_ptr<GSRasterBackend> nullBackend();
+}
