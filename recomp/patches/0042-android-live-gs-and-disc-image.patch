diff --git a/ps2xRuntime/src/lib/gs/ps2_live_ring.h b/ps2xRuntime/src/lib/gs/ps2_live_ring.h
new file mode 100644
index 0000000..0045f01
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/ps2_live_ring.h
@@ -0,0 +1,138 @@
+#pragma once
+
+// Shared-memory ring between the PS2Recomp runtime (producer) and the PCSX2-based GS host
+// (consumer, "pcsx2-gsrunner -live"). The byte stream is exactly a PCSX2 GS dump (.gs): the
+// file header, then Transfer / Registers / VSync / ReadFIFO2 packets. The consumer also
+// publishes the host window's keyboard state back, since that window has the focus.
+// Keep this file identical in both source trees.
+
+#include <cstdint>
+#include <string>
+
+#if defined(__APPLE__)
+#include <os/os_sync_wait_on_address.h>
+#elif defined(__EMSCRIPTEN__)
+#include <emscripten/threading.h>
+#elif defined(__linux__)
+#include <climits>
+#include <ctime>
+#include <linux/futex.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+namespace ps2live
+{
+    constexpr uint32_t kMagic = 0x50324C52u; // "RL2P"
+    constexpr uint32_t kVersion = 2u; // 2: ReadFIFO2 replies (readback area after the events)
+    constexpr uint64_t kDefaultCapacity = 256ull << 20;
+
+    constexpr const wchar_t *kMappingName = L"Local\\PS2RecompGsLiveRing";
+    constexpr const wchar_t *kDataEventName = L"Local\\PS2RecompGsLiveData";
+    constexpr const wchar_t *kSpaceEventName = L"Local\\PS2RecompGsLiveSpace";
+
+    // Pad buttons, active high, in the libpad bit order (bit 0 = SELECT ... bit 15 = SQUARE).
+    struct alignas(64) RingHeader
+    {
+        uint32_t magic;
+        uint32_t version;
+        uint64_t capacity; // bytes of the data area after the header
+        volatile int64_t writePos; // monotonic byte counters
+        alignas(64) volatile int64_t readPos;
+        alignas(64) volatile uint32_t producerAlive;
+        volatile uint32_t consumerAlive;
+        volatile uint32_t consumerQuit; // window closed: the game should exit
+        volatile uint32_t padButtons;
+        volatile uint32_t padAxes; // lx | ly << 8 | rx << 16 | ry << 24 (0x80 = centre)
+        volatile uint32_t padSequence;
+        volatile uint32_t hostMenuOpen; // the host's options menu is open: the game gets no pad input
+        // Wake-ups only when needed: each side sets its *Flags to 1 at start (it understands the
+        // *Waiting fields) and raises *Waiting while blocked on its event. The other side then
+        // signals only if that side is waiting (or is an older build with no flags).
+        volatile uint32_t consumerFlags;
+        volatile uint32_t consumerWaiting; // host blocked on the data event
+        volatile uint32_t producerFlags;
+        volatile uint32_t producerWaiting; // game blocked on the space event (ring full)
+    };
+
+    // Object names for one game instance: base name + "_" + suffix (the game's process id, passed
+    // to the host as "-livering <suffix>"), so several instances never share a ring.
+    inline std::wstring objectName(const wchar_t *base, const std::wstring &suffix)
+    {
+        return suffix.empty() ? std::wstring(base) : std::wstring(base) + L"_" + suffix;
+    }
+
+    inline uint8_t *ringData(RingHeader *header)
+    {
+        return reinterpret_cast<uint8_t *>(header) + sizeof(RingHeader);
+    }
+
+#if !defined(_WIN32)
+    // POSIX: the ring is a shm_open object and the two Windows auto-reset events are words in
+    // the same mapping, after the data area (macOS: os_sync_wait_on_address, Linux: futex).
+    // macOS limits shm names to 31 characters, so the base name is short.
+    constexpr const char *kPosixMappingName = "/ps2lr";
+
+    struct alignas(64) RingEvents
+    {
+        alignas(64) uint32_t data;  // set by the producer: new bytes in the ring
+        alignas(64) uint32_t space; // set by the consumer: ring space freed
+        // GS -> EE downloads: for each ReadFIFO2 packet the consumer copies PCSX2's FIFO data into the readback
+        // area, stores its size, bumps readbackSeq and sets readback (the game waits for it).
+        alignas(64) uint32_t readback;
+        uint32_t readbackSeq;
+        uint32_t readbackBytes;
+    };
+    constexpr uint64_t kReadbackCapacity = 8ull << 20; // a 1024x1024 32-bit download plus slack
+
+    inline std::string objectName(const char *base, const std::string &suffix)
+    {
+        return suffix.empty() ? std::string(base) : std::string(base) + "_" + suffix;
+    }
+
+    inline uint64_t mappingSize(uint64_t capacity)
+    {
+        return sizeof(RingHeader) + capacity + sizeof(RingEvents) + kReadbackCapacity;
+    }
+
+    inline RingEvents *ringEvents(RingHeader *header)
+    {
+        return reinterpret_cast<RingEvents *>(ringData(header) + header->capacity);
+    }
+
+    inline uint8_t *readbackData(RingHeader *header)
+    {
+        return reinterpret_cast<uint8_t *>(ringEvents(header)) + sizeof(RingEvents);
+    }
+
+    // SetEvent on an auto-reset event.
+    inline void eventSet(uint32_t *word)
+    {
+        __atomic_store_n(word, 1u, __ATOMIC_SEQ_CST);
+#if defined(__APPLE__)
+        os_sync_wake_by_address_any(word, sizeof(*word), OS_SYNC_WAKE_BY_ADDRESS_SHARED);
+#elif defined(__EMSCRIPTEN__)
+        emscripten_futex_wake(word, 1);
+#elif defined(__linux__)
+        syscall(SYS_futex, word, FUTEX_WAKE, 1, nullptr, nullptr, 0);
+#endif
+    }
+
+    // WaitForSingleObject(event, timeoutMs) on an auto-reset event: true if it was signalled.
+    inline bool eventWait(uint32_t *word, uint32_t timeoutMs)
+    {
+        if (__atomic_exchange_n(word, 0u, __ATOMIC_ACQ_REL) != 0u)
+            return true;
+#if defined(__APPLE__)
+        os_sync_wait_on_address_with_timeout(word, 0u, sizeof(*word), OS_SYNC_WAIT_ON_ADDRESS_SHARED,
+                                             OS_CLOCK_MACH_ABSOLUTE_TIME, static_cast<uint64_t>(timeoutMs) * 1000000ull);
+#elif defined(__EMSCRIPTEN__)
+        emscripten_futex_wait(word, 0u, static_cast<double>(timeoutMs)); // never on the browser's main thread
+#elif defined(__linux__)
+        const timespec timeout{static_cast<time_t>(timeoutMs / 1000u), static_cast<long>(timeoutMs % 1000u) * 1000000l};
+        syscall(SYS_futex, word, FUTEX_WAIT, 0, &timeout, nullptr, 0);
+#endif
+        return __atomic_exchange_n(word, 0u, __ATOMIC_ACQ_REL) != 0u;
+    }
+#endif
+}
diff --git a/ps2xRuntime/src/lib/hl_image.cpp b/ps2xRuntime/src/lib/hl_image.cpp
new file mode 100644
index 0000000..b5ceb44
--- /dev/null
+++ b/ps2xRuntime/src/lib/hl_image.cpp
@@ -0,0 +1,219 @@
+// Hidden Leaf: the disc image, read in place. On Android the launcher hands it over open, as /proc/self/fd/<n>: opening that
+// path again repeats the storage permission check, which an app without storage permission fails, so it is read through the
+// descriptor, with pread (no shared offset). Sectors are the disc's real ones; file names come from its ISO 9660 directory.
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <cstdio>
+bool hlImageRead(uint64_t offset, void *dst, size_t bytes);
+bool hlImageResolve(const std::string &guestPath, uint32_t &lbn, uint32_t &size);
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+namespace
+{
+    int s_fd = -1;
+    std::string s_path;
+    uint64_t s_size = 0;
+
+    constexpr uint32_t kSector = 2048u;
+
+    uint32_t le32(const uint8_t *p)
+    {
+        return static_cast<uint32_t>(p[0]) | static_cast<uint32_t>(p[1]) << 8 | static_cast<uint32_t>(p[2]) << 16 |
+               static_cast<uint32_t>(p[3]) << 24;
+    }
+
+    // finds `name` (upper case, no version) in a directory extent
+    bool findEntry(uint32_t lbn, uint32_t size, const std::string &name, uint32_t &outLbn, uint32_t &outSize)
+    {
+        std::vector<uint8_t> dir(size);
+        if (!hlImageRead(static_cast<uint64_t>(lbn) * kSector, dir.data(), size))
+            return false;
+        uint32_t pos = 0;
+        while (pos + 33u < size)
+        {
+            const uint32_t len = dir[pos];
+            if (len == 0u)
+            {   // the rest of this sector is padding
+                pos = (pos / kSector + 1u) * kSector;
+                continue;
+            }
+            const uint32_t nameLen = dir[pos + 32u];
+            std::string entry(reinterpret_cast<const char *>(&dir[pos + 33u]), nameLen);
+            const size_t semi = entry.find(';');
+            if (semi != std::string::npos)
+                entry.resize(semi);
+            if (entry == name)
+            {
+                outLbn = le32(&dir[pos + 2u]);
+                outSize = le32(&dir[pos + 10u]);
+                return true;
+            }
+            pos += len;
+        }
+        return false;
+    }
+}
+
+bool hlImageOpen(const std::string &path)
+{
+    static const char kPrefix[] = "/proc/self/fd/";
+    int fd = -1;
+    if (path.compare(0, sizeof(kPrefix) - 1, kPrefix) == 0)
+        fd = std::atoi(path.c_str() + sizeof(kPrefix) - 1);
+    else
+        fd = ::open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    struct stat st{};
+    if (fd < 0 || ::fstat(fd, &st) != 0)
+        return false;
+    s_fd = fd;
+    s_path = path;
+    s_size = static_cast<uint64_t>(st.st_size);
+    return true;
+}
+
+bool hlImageActive() { return s_fd >= 0; }
+
+bool hlImageIs(const std::string &path) { return s_fd >= 0 && path == s_path; }
+
+uint64_t hlImageSize() { return s_size; }
+
+int hlImageDup() { return s_fd >= 0 ? ::dup(s_fd) : -1; }
+
+bool hlImageRead(uint64_t offset, void *dst, size_t bytes)
+{
+    auto *out = static_cast<uint8_t *>(dst);
+    while (bytes > 0u)
+    {
+        const ssize_t n = ::pread(s_fd, out, bytes, static_cast<off_t>(offset));
+        if (n <= 0)
+            return false;
+        out += n;
+        offset += static_cast<uint64_t>(n);
+        bytes -= static_cast<size_t>(n);
+    }
+    return true;
+}
+
+bool hlImageResolve(const std::string &guestPath, uint32_t &lbn, uint32_t &size)
+{
+    if (s_fd < 0)
+        return false;
+    uint8_t pvd[kSector];
+    if (!hlImageRead(16ull * kSector, pvd, kSector) || std::memcmp(pvd + 1, "CD001", 5) != 0)
+        return false;
+    uint32_t curLbn = le32(pvd + 156 + 2);
+    uint32_t curSize = le32(pvd + 156 + 10);
+    std::string part;
+    const auto step = [&]() -> bool
+    {
+        if (part.empty())
+            return true;
+        const size_t semi = part.find(';');
+        if (semi != std::string::npos)
+            part.resize(semi);
+        std::transform(part.begin(), part.end(), part.begin(), [](unsigned char c) { return static_cast<char>(std::toupper(c)); });
+        const bool found = findEntry(curLbn, curSize, part, curLbn, curSize);
+        part.clear();
+        return found;
+    };
+    const size_t device = guestPath.find(':');
+    for (const char c : device == std::string::npos ? guestPath : guestPath.substr(device + 1u))
+    {
+        if (c == '/' || c == '\\')
+        {
+            if (!step())
+                return false;
+        }
+        else
+            part.push_back(c);
+    }
+    if (!step())
+        return false;
+    lbn = curLbn;
+    size = curSize;
+    return true;
+}
+
+namespace
+{
+    // A file of the disc as a FILE: reads go straight to the image, each stream with its own position.
+    struct ExtentView
+    {
+        uint64_t base, size, pos;
+    };
+
+    int64_t viewReadBytes(ExtentView *v, char *dst, size_t bytes)
+    {
+        const uint64_t left = v->pos < v->size ? v->size - v->pos : 0u;
+        const size_t count = static_cast<size_t>(std::min<uint64_t>(left, bytes));
+        if (count != 0u && !hlImageRead(v->base + v->pos, dst, count))
+            return -1;
+        v->pos += count;
+        return static_cast<int64_t>(count);
+    }
+
+    int64_t viewSeekTo(ExtentView *v, int64_t offset, int whence)
+    {
+        const int64_t from = whence == SEEK_SET ? 0 : (whence == SEEK_CUR ? static_cast<int64_t>(v->pos) : static_cast<int64_t>(v->size));
+        const int64_t target = from + offset;
+        if (target < 0)
+            return -1;
+        v->pos = static_cast<uint64_t>(target);
+        return target;
+    }
+
+#if defined(__ANDROID__)
+    int viewRead(void *cookie, char *dst, int bytes) { return static_cast<int>(viewReadBytes(static_cast<ExtentView *>(cookie), dst, static_cast<size_t>(bytes))); }
+    fpos64_t viewSeek(void *cookie, fpos64_t offset, int whence) { return viewSeekTo(static_cast<ExtentView *>(cookie), offset, whence); }
+#else
+    ssize_t viewRead(void *cookie, char *dst, size_t bytes) { return viewReadBytes(static_cast<ExtentView *>(cookie), dst, bytes); }
+    int viewSeek(void *cookie, off64_t *offset, int whence)
+    {
+        const int64_t target = viewSeekTo(static_cast<ExtentView *>(cookie), *offset, whence);
+        if (target < 0)
+            return -1;
+        *offset = target;
+        return 0;
+    }
+#endif
+
+    int viewClose(void *cookie)
+    {
+        delete static_cast<ExtentView *>(cookie);
+        return 0;
+    }
+}
+
+std::FILE *hlImageOpenFile(const std::string &guestPath, uint64_t *sizeOut)
+{
+    uint32_t lbn = 0u, size = 0u;
+    if (!hlImageResolve(guestPath, lbn, size))
+        return nullptr;
+    auto *view = new ExtentView{static_cast<uint64_t>(lbn) * kSector, size, 0u};
+#if defined(__ANDROID__)
+    std::FILE *stream = funopen64(view, viewRead, nullptr, viewSeek, viewClose);
+#else
+    cookie_io_functions_t functions{};
+    functions.read = viewRead;
+    functions.seek = viewSeek;
+    functions.close = viewClose;
+    std::FILE *stream = fopencookie(view, "rb", functions);
+#endif
+    if (!stream)
+    {
+        delete view;
+        return nullptr;
+    }
+    if (sizeOut)
+        *sizeOut = size;
+    return stream;
+}
