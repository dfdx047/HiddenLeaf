diff --git a/ps2xIOP/include/ps2x/iop/hl_cd_drive.h b/ps2xIOP/include/ps2x/iop/hl_cd_drive.h
new file mode 100644
index 0000000..c0fc2b8
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/hl_cd_drive.h
@@ -0,0 +1,201 @@
+#pragma once
+
+// Hidden Leaf: how long the disc drive takes for each read.
+//
+// The runtime reads the extracted disc at once, on the EE (sceCdRead is HLE) and on the IOP (cdvdman's sceCdRead). A
+// game that keeps playing while the drive works (Ultimate Ninja 5 loads during the round's opening and polls
+// sceCdSync(1) each frame) then sees its data a few frames sooner than on the console, and the fight takes another
+// course. This is a model of the drive's time, following the one in PCSX2 (CDVD.cpp: cdvdStartSeek,
+// cdvdRotationTime, cdvdBlockReadTime), which is the reference the bench compares against (docs/registro.md,
+// 2026-11-08):
+//   - the head's position is shared by the EE's and the IOP's reads (the sound driver reads SNDDATA.BIN at 4x CAV,
+//     the game at 2x CLV, and every change from CAV to CLV costs the spindle's change of speed);
+//   - a seek of 16 sectors or more takes 30 ms, of 14764 or more (single-layer DVD) 100 ms; a drive that stopped
+//     takes 333 ms to spin up;
+//   - a read that does not seek waits half a turn of the disc, then the sectors pass at the speed of their track.
+// What it leaves out: the drive's read-ahead buffer (it cuts 1 to 3 ms from contiguous reads), and the IOP's reads
+// waiting for the EE's (each read moves the head when it is asked).
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+
+namespace hl_cd
+{
+    constexpr float kIopClock = 36864000.0f;
+    constexpr float kDvdSectors = 2298496.0f; // the length of a single-layer DVD, as PCSX2 counts it
+    constexpr uint32_t kContiguousSectors = 16u;
+    constexpr uint32_t kFastSeekSectors = 14764u;
+    constexpr uint8_t kCav = 0x80u;
+
+    struct Drive
+    {
+        uint32_t sector = 0u;
+        bool spinning = false;
+        uint8_t spindle = 0u;
+        uint32_t rotationCycles = 0u;
+    };
+
+    inline Drive g_drive;
+    inline std::mutex g_mutex;
+
+    // HL_CD_TIMING=0 turns the model off (reads finish at once, as before)
+    inline bool enabled()
+    {
+        static const bool on = []()
+        {
+            const char *v = std::getenv("HL_CD_TIMING");
+            return v == nullptr || v[0] != '0';
+        }();
+        return on;
+    }
+
+    // The drive's speed and spindle for a sceCdRMode's spindlctrl, as Sony's cdvdman sends them in the read command on
+    // a DVD. Seen in PCSX2 with Ultimate Ninja 5: SCECdSpinMax (the game, on the EE) reads at 2x CLV (1.6x in
+    // effect), SCECdSpinNom (the sound driver, on the IOP) at 4x CAV. The other values were not seen; they follow
+    // their names.
+    inline uint8_t spindleFor(uint8_t spindlctrl)
+    {
+        switch (spindlctrl)
+        {
+        case 1u: // SCECdSpinNom
+        case 4u: // SCECdSpinX4
+            return kCav | 3u;
+        case 2u: // SCECdSpinX1
+            return 1u;
+        default: // SCECdSpinMax, SCECdSpinX2 and the rest
+            return 2u;
+        }
+    }
+
+    inline float speedOf(uint8_t spindle)
+    {
+        switch (spindle & 7u)
+        {
+        case 1u:
+            return 1.0f;
+        case 3u:
+            return 4.0f;
+        default:
+            return 2.0f;
+        }
+    }
+
+    // IOP cycles for one turn of the disc with the head at this sector
+    inline uint32_t rotationCycles(uint8_t spindle, uint32_t sector)
+    {
+        float turnsPerSecond;
+        if (spindle & kCav)
+            turnsPerSecond = 1515.0f * speedOf(spindle) / 60.0f;
+        else
+        {
+            const float trackSpeed = (1.0f - (static_cast<float>(sector) / kDvdSectors) * 0.60f) + 0.40f;
+            turnsPerSecond = 1515.0f * std::min(speedOf(spindle), 1.6f) * trackSpeed / 60.0f;
+        }
+        return static_cast<uint32_t>((kIopClock / 1000.0f) * (1000.0f / turnsPerSecond));
+    }
+
+    // IOP cycles for one sector to pass under the head
+    inline uint32_t sectorCycles(uint8_t spindle, uint32_t sector)
+    {
+        if (spindle & kCav)
+        {
+            const float trackSpeed = (static_cast<float>(sector) / kDvdSectors) * 0.60f + 0.40f;
+            return static_cast<uint32_t>(kIopClock / (675.0f * speedOf(spindle) * trackSpeed));
+        }
+        return static_cast<uint32_t>(kIopClock / (675.0f * std::min(speedOf(spindle), 1.6f)));
+    }
+
+    // A read of `sectors` sectors from `lsn` with this spindle: moves the head and returns how long the drive takes,
+    // in IOP cycles, from the command to the last sector
+    inline uint64_t read(uint32_t lsn, uint32_t sectors, uint8_t spindle)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        Drive &d = g_drive;
+        const uint32_t delta = lsn > d.sector ? lsn - d.sector : d.sector - lsn;
+        const uint32_t oldRotation = d.rotationCycles;
+        const bool toClv = (d.spindle & kCav) && !(spindle & kCav);
+        d.spindle = spindle;
+        d.rotationCycles = rotationCycles(spindle, lsn);
+        uint64_t cycles = 0u;
+        bool seeking = false;
+        if (!d.spinning)
+        {
+            cycles = static_cast<uint64_t>(kIopClock) / 3u;
+            d.spinning = true;
+        }
+        else
+        {
+            if (delta >= kContiguousSectors)
+            {
+                cycles = static_cast<uint64_t>(kIopClock) * (delta >= kFastSeekSectors ? 100u : 30u) / 1000u;
+                seeking = true;
+            }
+            if (toClv && oldRotation != 0u)
+            {
+                const float oldRpm = (kIopClock / static_cast<float>(oldRotation)) * 60.0f;
+                const float newRpm = (kIopClock / static_cast<float>(d.rotationCycles)) * 60.0f;
+                cycles += static_cast<uint64_t>((kIopClock / 1000.0f) * (0.054950495049505f * std::fabs(newRpm - oldRpm)));
+            }
+        }
+        if (delta != 0u && !seeking)
+            cycles += d.rotationCycles / 2u;
+        cycles += static_cast<uint64_t>(sectors) * sectorCycles(spindle, lsn);
+        d.sector = lsn + sectors;
+        return cycles;
+    }
+
+    // The sector where a file of the disc starts (hl_lbn.txt next to the extracted files, from tools/un5.py lbn), by
+    // its host path; 0 when the file is not on the disc or the table is missing
+    inline uint32_t fileSector(const std::filesystem::path &root, const std::filesystem::path &file)
+    {
+        static std::mutex mutex;
+        static std::filesystem::path loadedRoot;
+        static std::unordered_map<std::string, uint32_t> table;
+        static bool loaded = false;
+        const auto lower = [](std::string v)
+        {
+            for (char &c : v)
+                c = static_cast<char>(c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c);
+            return v;
+        };
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!loaded || loadedRoot != root)
+        {
+            loaded = true;
+            loadedRoot = root;
+            table.clear();
+            std::ifstream in(root / "hl_lbn.txt");
+            std::string line;
+            while (std::getline(in, line))
+            {
+                const size_t a = line.find(' ');
+                const size_t b = a == std::string::npos ? a : line.find(' ', a + 1);
+                if (b == std::string::npos)
+                    continue;
+                std::string path = line.substr(b + 1);
+                while (!path.empty() && (path.back() == '\r' || path.back() == '\n'))
+                    path.pop_back();
+                table[lower(path)] = static_cast<uint32_t>(std::strtoul(line.substr(0, a).c_str(), nullptr, 16));
+            }
+        }
+        std::error_code ec;
+        const std::filesystem::path relative = std::filesystem::relative(file, root, ec);
+        if (ec)
+            return 0u;
+        const auto it = table.find(lower(relative.generic_string()));
+        return it == table.end() ? 0u : it->second;
+    }
+
+    // the same in milliseconds
+    inline double readMs(uint32_t lsn, uint32_t sectors, uint8_t spindle)
+    {
+        return static_cast<double>(read(lsn, sectors, spindle)) * 1000.0 / static_cast<double>(kIopClock);
+    }
+}
