--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/HlFloatLog.cpp
@@ -0,0 +1,70 @@
+// Hidden Leaf: HL_FLOAT_LOG=1 (see hl_float_note in ps2_runtime_macros.h). Only the EE executor reaches these.
+#include "ps2_runtime_macros.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <unordered_map>
+#include <vector>
+
+extern "C" char __executable_start;
+
+namespace
+{
+    const char *const kNames[] = {"exp255", "div0", "cmp255", "cvt-round", "cvt-range", "vu-div0", "vu-sqrt-neg"};
+
+    struct Site
+    {
+        uint64_t count = 0;
+        uint64_t sinceReport = 0;
+    };
+
+    bool enabled()
+    {
+        static const bool s_enabled = std::getenv("HL_FLOAT_LOG") != nullptr;
+        return s_enabled;
+    }
+
+    // key: host offset in the executable << 4 | kind
+    std::unordered_map<uint64_t, Site> &sites()
+    {
+        static std::unordered_map<uint64_t, Site> s_sites;
+        return s_sites;
+    }
+}
+
+PS2_FLOAT_NOINLINE void hl_float_note(HlFloatEvent kind, const void *where)
+{
+    if (!enabled())
+        return;
+    if (where == nullptr)
+        where = __builtin_return_address(0);
+    const uint64_t offset = reinterpret_cast<uintptr_t>(where) - reinterpret_cast<uintptr_t>(&__executable_start);
+    Site &site = sites()[(offset << 4) | static_cast<uint64_t>(kind)];
+    ++site.count;
+    ++site.sinceReport;
+}
+
+void hl_float_report(uint64_t vsyncTick)
+{
+    if (!enabled())
+        return;
+    uint64_t totals[static_cast<size_t>(HlFloatEvent::Count)]{};
+    std::vector<std::pair<uint64_t, uint64_t>> recent;
+    for (auto &[key, site] : sites())
+    {
+        totals[key & 0xFu] += site.count;
+        if (site.sinceReport != 0u)
+            recent.emplace_back(site.sinceReport, key);
+    }
+    std::sort(recent.rbegin(), recent.rend());
+    std::fprintf(stderr, "[float] vsync %llu totals:", static_cast<unsigned long long>(vsyncTick));
+    for (size_t i = 0; i < static_cast<size_t>(HlFloatEvent::Count); ++i)
+        std::fprintf(stderr, " %s=%llu", kNames[i], static_cast<unsigned long long>(totals[i]));
+    std::fprintf(stderr, "; %zu sites since the last report\n", recent.size());
+    for (size_t i = 0; i < recent.size() && i < 24u; ++i)
+        std::fprintf(stderr, "[float]   %s at +0x%llx: %llu\n", kNames[recent[i].second & 0xFu],
+                     static_cast<unsigned long long>(recent[i].second >> 4), static_cast<unsigned long long>(recent[i].first));
+    for (auto &[key, site] : sites())
+        site.sinceReport = 0u;
+}
