+// Hidden Leaf: with HL_FLOAT_LOG=1, the float operations whose PS2 result needs care are counted by the host address
+// in the recompiled function (an operand or result with exponent 255, a zero divisor, a compare with an exponent-255
+// operand, which the host sees as Inf or NaN, and a cvt.w.s the host rounds where the EE truncates); the counts go to
+// the log every 300 vsyncs (hl_float_report). where == nullptr takes the caller of hl_float_note
+enum class HlFloatEvent : uint8_t
+{
+    Exp255,
+    DivZero,
+    Compare255,
+    CvtRound,
+    CvtRange,
+    VuDivZero,
+    VuSqrtNeg,
+    Count
+};
+void hl_float_note(HlFloatEvent kind, const void *where = nullptr);
+void hl_float_report(uint64_t vsyncTick);
+
 constexpr uint32_t PS2_FLOAT_MAX_BITS = 0x7FFFFFFFu;
 constexpr uint32_t PS2_FLOAT_EXP_MASK = 0x7F800000u;
 constexpr uint32_t PS2_FLOAT_SIGN_MASK = 0x80000000u;
