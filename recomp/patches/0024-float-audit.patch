     return t != 0u && (t - 0x00800000u) >= 0x7F000000u;
 }
 
+inline bool ps2_fexp255(float x)
+{
+    return (std::bit_cast<uint32_t>(x) & 0x7F800000u) == 0x7F800000u;
+}
+
+// HL_FLOAT_LOG: a compare with an exponent-255 operand (Inf or NaN to the host, a big number to the PS2)
+inline void ps2_fcmp_audit(float a, float b)
+{
+    if (ps2_fexp255(a) | ps2_fexp255(b))
+        hl_float_note(HlFloatEvent::Compare255);
+}
+
+// HL_FLOAT_LOG: cvt.w.s as the runtime does it (nearest), noted where the EE's truncation gives another value
+inline int32_t ps2_cvt_w_s_audit(float a)
+{
+    const int32_t r = static_cast<int32_t>(nearbyintf(a));
+    if ((std::bit_cast<uint32_t>(a) & 0x7F800000u) >= 0x4F000000u)
+        hl_float_note(HlFloatEvent::CvtRange);
+    else if (static_cast<float>(r) != truncf(a))
+        hl_float_note(HlFloatEvent::CvtRound);
+    return r;
+}
